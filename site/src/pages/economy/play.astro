---
// The Play rack (/economy/play): one portrait card per game. Games render at
// /economy/play/<game>/ (canonical = current puzzle; numbered puzzle pages are
// the share targets). Old /economy/beats* URLs 301 to the front page, not
// here and not to the deck (public/_redirects). Decks are retired from the
// rack — their URLs stay alive at /economy/play/[deck] so nothing shared ever
// breaks, but they are unlisted (same treatment as short reads), reached now
// only by a direct link. Games are equal-weight siblings;
// the game from the latest dispatch says so with the self-expiring "New" chip.
import StoryPage from '../../layouts/StoryPage.astro';
import SectionHeader from '../../components/editorial/SectionHeader.astro';
import ViewToggle from '../../components/editorial/ViewToggle.astro';
import GameCard from '../../components/play/GameCard.astro';
import PeaksAuto from '../../components/play/PeaksAuto.astro';
import { DISPATCH_LIST } from '../../lib/dispatches';
import obhm from '../../data/play/off-by-how-much.json';
import {
  INFLATION_PEAKS_HREF,
  INFLATION_PEAKS_KICKER,
  INFLATION_PEAKS_TITLE,
} from '../../lib/play/inflation-peaks';
import { readFileSync } from 'node:fs';
import { lineMotif } from '../../lib/lineMotif';
import { coverAuto } from '../../lib/play/peaks-cover';

const currentPuzzle = obhm.puzzles.find((p) => p.n === obhm.current)!;
const round1 = currentPuzzle.rounds[0] as {
  q: string;
  min?: number;
  max?: number;
  countScale?: number;
};

// Round 1's slider range, for the labels under the card's gauge. Not a
// spoiler — it's the scale the player is handed the moment they start, and
// showing it is the point: "somewhere between 100 crore and 10,000 crore" is
// a span most readers can't intuit, which is the game's whole pitch.
//
// Absolute counts, not display strings: the card emits them as
// `.num[data-count]` spans so BaseLayout's applyProseUnits rewrites them
// live with the cr/bn toggle, exactly as prose figures do in the reads.
// Only count-scaled rounds qualify — a future puzzle opening on a percentage
// or a ratio has no unit to convert, so it simply gets no labels.
const scale =
  round1.countScale && round1.min != null && round1.max != null
    ? { minCount: round1.min * round1.countScale, maxCount: round1.max * round1.countScale }
    : undefined;

// Inflation Peaks' motif is its own terrain, drawn once as a thin saffron
// profile. Same weight as the gauge on the sibling card: one line, no fill,
// no icon. Read off the generated spine at build time, so the silhouette on
// the rack is the series the game actually runs on.
//
// Downsampled to a fixed number of samples rather than every nth month: the
// spine grows by a month whenever MOSPI publishes, and a fixed stride would
// quietly thicken the line over the years. Normalised into the viewBox so
// the shape holds whatever the numbers are.
// Cropped to the stretch the machine arrives loaded with (2020 onward), with
// the game's own auto standing on it: the full 57-year spine at 58px is
// a texture, and nothing about a texture says game. Same crop and overlay as
// the front page's card (src/pages/index.astro) so the two read as the same
// object, and the placement itself is shared (lib/play/peaks-cover) so they
// cannot drift again. Normalised from the stretch's own floor, not zero.
const peaks = (() => {
  const all = JSON.parse(
    readFileSync('public/data/economy/play/inflation-peaks.json', 'utf8'),
  ).points as { ym: string; yoy: number }[];
  const stretch = all.filter((p) => p.ym >= '2020-01');
  const line = lineMotif(stretch.map((p) => p.yoy), { samples: 96 });
  return { points: line.points, auto: coverAuto(line) };
})();

// The walk's cover is a picture now rather than a line: the front page
// supplement's own baked still (same sky, same ridge bands, same rim light)
// with the walker left out — /independence/rack.jpg, baked beside
// supplement.jpg by the same script. The authored-ridge motif that stood
// here first (the one line on the site drawn from invented numbers, with a
// long apology for being one) retires with it. The mystery rule holds
// either way: the still's land edge is the smoothed, x-warped bake, not the
// series a reader could measure anything off.

const sectionDate = new Date()
  .toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })
  .toUpperCase();

// The game that shipped with the latest dispatch gets a truthful "New" — it
// expires by itself the moment a newer dispatch ships.
const isNew = (href: string) =>
  DISPATCH_LIST[0]?.items.some((it) => it.href === href) ?? false;
---

<StoryPage
  title="Play — Time Series of India"
  description="Games on India's official economic data. Off by How Much? — guess the number, see how far off you are."
>
  <SectionHeader label="Economy · Play" date={sectionDate}>
    <ViewToggle active="play" slot="actions" />
  </SectionHeader>
  <p class="intro">
    Games on India&rsquo;s numbers &mdash; you guess, the data answers.
  </p>

  <!-- The card's `body` is kept short enough to survive its 2-line clamp at
       phone width. It used to end "…see how far off you are", which the clamp
       cut at exactly the payoff phrase; no loss, the title already says it. -->
  <!-- Newest first: the Independence Day flagship, then dispatch No. 2’s game
       ahead of dispatch No. 1’s. -->
  <div class="rack">
    <!-- The Independence Day flagship. Same component, same classes as its
         two siblings; the chip is release day's call — `isNew` elsewhere on
         this page is derived from the latest dispatch and the flagship is not
         in one, so it is passed literally here and must be REMOVED BY HAND
         when the next dispatch ships. Nothing in the copy or the cover names
         what the reader is walking — the withholding is the piece, and it
         starts here. -->
    <!-- R2m: the piece is named, and the kicker states the FORMAT beside the
         occasion. This card sits in a rack of games and is not one — it is a
         film the reader drives — and "Independence Day 2026" alone said when it
         is for and nothing about what it is. The rack has no format-label slot
         of its own (see GameCard's props: kicker, title, body, peek, cta), and
         the kicker is where its two siblings carry their identity line, so the
         format goes there in the site's own middot register. -->
    <GameCard
      href="/independence/"
      kicker="Independence Day 2026 · Interactive film"
      isNew={true}
      title="The Walk through Midnight"
      body="Four and a quarter centuries of India, on foot."
      peek="Hold the wide side of the picture to walk forward."
      peekLabel="Controls"
      cta="Take the walk"
    >
      <span slot="cover" class="walk-cover">
        <img class="walk-still" src="/independence/rack.jpg" alt="" loading="lazy" />
      </span>
    </GameCard>

    <GameCard
      href={INFLATION_PEAKS_HREF}
      kicker={INFLATION_PEAKS_KICKER}
      title={INFLATION_PEAKS_TITLE}
      body="A driving game where the terrain is the inflation series. One button, and a long way down."
      peek="Hold to accelerate, release to coast."
      peekLabel="Controls"
    >
      <span slot="cover" class="peaks-cover">
        <svg
          class="peaks-motif"
          viewBox="0 0 100 30"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <polyline points={peaks.points} />
        </svg>
        <PeaksAuto {...peaks.auto} />
      </span>
    </GameCard>

    <GameCard
      href="/economy/play/off-by-how-much/"
      kicker={`${obhm.seriesKicker} · Puzzle № ${obhm.current}`}
      isNew={isNew('/economy/play/off-by-how-much/')}
      title={obhm.title}
      body="Four real numbers from India’s payment systems. Guess each one."
      peek={round1.q}
      scale={scale}
    />

  </div>
</StoryPage>

<style>
  .intro {
    max-width: 70ch;
    margin: calc(var(--tsoi-spacing-unit) * 2) 0 0;
    font: var(--tsoi-text-deck);
    letter-spacing: var(--tsoi-text-deck-tracking);
    color: var(--tsoi-color-on-surface-variant);
  }

  /* The peaks card's motif: the game's terrain as a single saffron rule,
     sitting in the same cover box and at the same visual weight as the
     sibling card's gauge. `vector-effect` keeps the stroke at 1.5px through
     the non-uniform viewBox scaling, which would otherwise squash it. */
  /* Headroom for the auto, which stands ON the line and therefore reaches
     about 19px ABOVE it — a sprite anchored at its rear tyre with 18px of
     bodywork over that point. The 58px band measures the terrain only, so
     without this the vehicle escapes the cover box and, on any layout where
     the card has no slack to give (the front page's side column at tablet
     width), lands in the last line of the pitch above it.

     Reserved here rather than solved in the placement search, because the
     alternative is telling coverAuto to keep off high ground, and on this
     crop every window low enough to qualify tilts 8-20°. Standing the auto
     level is the point of that search (see lib/play/peaks-cover) and worth
     20px more than an unpadded box is.

     Margin, not padding: the auto is absolutely positioned against this box,
     so padding would shift the motif down and leave the sprite behind. */
  .peaks-cover { position: relative; display: block; margin-top: 20px; }
  .peaks-motif {
    display: block;
    width: 100%;
    height: 58px;
    overflow: visible;
  }
  .peaks-motif polyline {
    fill: none;
    stroke: var(--tsoi-color-primary);
    stroke-width: 1.5;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  /* the auto itself carries its own styles (components/play/PeaksAuto.astro) */

  /* The walk's still: the supplement bake without its walker, cropped to a
     cinematic band a step taller than the siblings' 58px line band — it is a
     picture of a place, and at 58px it would be a stripe. `cover` centred
     keeps the rim line's climb in frame at every card width. */
  .walk-cover { display: block; margin-top: 20px; }
  .walk-still {
    display: block;
    width: 100%;
    height: 132px;
    object-fit: cover;
    object-position: 50% 55%;
    /* the card sits on paper and the still is night — the same hairline the
       supplement's frame draws, so the picture has an edge instead of a halo */
    border: 1px solid var(--tsoi-color-outline);
    background: #12151f;
  }

  /* Track capped at 480px: the game card holds the intro screen's proportion
     (see GameCard.astro), and the intro card itself is 560 wide — the rack's
     card is deliberately a size down from the thing it opens, close enough to
     recognise, not so close it pretends to already BE the game. */
  .rack {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 480px));
    gap: calc(var(--tsoi-spacing-unit) * 3.5);
    margin-top: calc(var(--tsoi-spacing-unit) * 4);
    justify-content: start;
  }

  @media (max-width: 600px) {
    /* one card per row, full width of the column — a landscape card at phone
       width is already short enough to sit whole on screen */
    .rack {
      grid-template-columns: minmax(0, 1fr);
      gap: calc(var(--tsoi-spacing-unit) * 3);
    }
  }
</style>
