  /* (The e-idx / e-rate / e-mark hues left with the parked base-effect section —
     see the parked doc. If it returns, they come back with it.) */
  /* the repo rate is the only non-CPI quantity in the read. Ink, deliberately:
     a chart hue would imply it is another slice of the same thing. */
  :global(.e-repo) { --ent: var(--tsoi-color-on-surface); --ent-text: var(--tsoi-color-on-surface); }
  /* One hue per floor of the tree, so a level noun in the prose and its row in
     the funnel are the same colour. Saffron stays reserved for the headline at
     the top, where the descent begins.
     The order is not arbitrary: all 120 arrangements of TSOI's five non-saffron
     chart hues were run through the palette validator, and this one wins on
     adjacent-pair separation in both themes — worst adjacent pair ΔE 10.1
     (deutan) / 21.4 (normal vision) in light, 11.0 / 22.4 in dark. Two known
     flags, both properties of the brand tokens rather than this ordering:
     chart-2 is low-chroma in light mode, and chart-3 and chart-6 sit under 3:1
     against the surface. The validator's required relief is visible labels,
     which every funnel cell and every prose span carries. */
  .prose {
    --lvl-item: var(--tsoi-color-chart-3);      --lvl-item-text: var(--tsoi-color-chart-3-text, var(--tsoi-color-chart-3));
    --lvl-sub: var(--tsoi-color-chart-4);       --lvl-sub-text: color-mix(in srgb, var(--tsoi-color-chart-4) 84%, #000);
    --lvl-class: var(--tsoi-color-chart-6);     --lvl-class-text: var(--tsoi-color-chart-6-text, var(--tsoi-color-chart-6));
    --lvl-group: var(--tsoi-color-chart-5);     --lvl-group-text: color-mix(in srgb, var(--tsoi-color-chart-5) 86%, #000);
    --lvl-div: var(--tsoi-color-chart-2);       --lvl-div-text: var(--tsoi-color-chart-2-text, var(--tsoi-color-chart-2));
  }
  /* The two-baskets pair: rural wears chart-3, urban chart-4 — saffron and
     teal stay reserved for the headline and the reader's own numbers. The
     same hues serve as funnel floors in Part II, which is tolerable where
     sharing the headline's saffron would not be: both figures label every
     use, and the two sections never share a screen. */
  .prose {
    --ru-rural: var(--tsoi-color-chart-3);
    --ru-rural-text: var(--tsoi-color-chart-3-text, var(--tsoi-color-chart-3));
    --ru-urban: var(--tsoi-color-chart-4);
    --ru-urban-text: color-mix(in srgb, var(--tsoi-color-chart-4) 84%, #000);
    /* the rebuild's seam and its multiplier wear the red chart hue (the one
       hue with no other meaning in this read); core inflation wears the
       gold, since ink now means index */
    --splice: var(--tsoi-color-chart-5);
    --splice-text: color-mix(in srgb, var(--tsoi-color-chart-5) 86%, #000);
    --core-c: var(--tsoi-color-chart-6);
    --core-text: var(--tsoi-color-chart-6-text, var(--tsoi-color-chart-6));
  }
  :global(.e-rural) { --ent: var(--ru-rural); --ent-text: var(--ru-rural-text); }
  :global(.e-urban) { --ent: var(--ru-urban); --ent-text: var(--ru-urban-text); }
  :global(.e-splice) { --ent: var(--splice); --ent-text: var(--splice-text); }
  :global(.e-core) { --ent: var(--core-c); --ent-text: var(--core-text); }
  /* dark mode lifts the chart hues instead of deepening them, so the
     darkened text mixes above have to be undone rather than re-tuned */
  :global([data-theme='dark']) .prose {
    --lvl-sub-text: var(--tsoi-color-chart-4);
    --lvl-group-text: var(--tsoi-color-chart-5);
    --ru-urban-text: var(--tsoi-color-chart-4);
    --splice-text: var(--tsoi-color-chart-5);
  }
  /* .nl is the number-only variant of .e: a figure takes its floor's colour but
     not the underline — a paragraph that walks the tomato up five floors would
     otherwise carry a dozen ruled spans and read as a hyperlink farm */
  .prose :global(.nl) { color: var(--ent-text); font-weight: 600; font-variant-numeric: tabular-nums; }
  :global(.e-lvl-item) { --ent: var(--lvl-item); --ent-text: var(--lvl-item-text); }
  :global(.e-lvl-sub) { --ent: var(--lvl-sub); --ent-text: var(--lvl-sub-text); }
  :global(.e-lvl-class) { --ent: var(--lvl-class); --ent-text: var(--lvl-class-text); }
  :global(.e-lvl-group) { --ent: var(--lvl-group); --ent-text: var(--lvl-group-text); }
  :global(.e-lvl-div) { --ent: var(--lvl-div); --ent-text: var(--lvl-div-text); }
  .prose :global(.e) { color: var(--ent-text); font-weight: 600; border-bottom: 2px solid color-mix(in srgb, var(--ent) 35%, transparent); }

  figure { margin: calc(var(--tsoi-spacing-unit) * 4) 0; }
  figcaption { font: var(--tsoi-text-byline); font-size: 13.5px; color: var(--tsoi-color-on-surface-variant); margin-top: var(--tsoi-spacing-unit); line-height: 1.6; }

  .widgetfig { padding: calc(var(--tsoi-spacing-unit) * 2.5); border: 1px solid var(--tsoi-color-outline-variant); border-radius: var(--tsoi-radius-lg); background: var(--tsoi-color-surface-container-low); }
  /* pan-y: a vertical swipe over a slider scrolls the page instead of being
     captured as a drag — phone readers were reweighting the basket by accident */
  .widgetfig :global(input[type='range']) { width: 100%; accent-color: var(--tsoi-color-primary); cursor: pointer; height: 22px; touch-action: pan-y; }
  /* widget buttons sit filled, not ghosted: transparent buttons on the
     figure's own surface read as annotations and get missed (review note,
     Aug 2026). The page background is the fill — lighter than the card, so
     the button lifts without the muddy cast surface-container-high had. */
  .widgetfig :global(button) { font: var(--tsoi-text-byline); font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase; cursor: pointer;
    color: var(--tsoi-color-on-surface); background: var(--tsoi-color-background); border: 1px solid var(--tsoi-color-outline); border-radius: 2px; padding: 6px 13px; }
  .widgetfig :global(button:hover) { border-color: var(--tsoi-color-primary); }

  /* ---- one line (opening bookend) ---- */
  /* A drawing, not a chart: no panel card, no border — it sits directly on
     the page surface, like Anatomy's opening strip. The closing bookend
     (Part III) reuses the same grammar to fan this line back out. */
  .hlfig { margin-top: 0; }
  /* the SVG is built by JS; reserving its exact shape (viewBox 720×230) keeps
     the opening from rendering collapsed and jumping once the script runs */
  .hlfig .hl-area { aspect-ratio: 720 / 230; }
  .hlfig :global(.hl-svg) { width: 100%; display: block; }
  .hlfig :global(.hl-line) { fill: none; stroke: var(--tsoi-color-chart-1); stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .hlfig :global(.hl-dot) { fill: var(--tsoi-color-chart-1); opacity: 0; transition: opacity 0.9s ease; }
  .hlfig :global(.st-num) { font-family: var(--tsoi-font-mono); font-size: 17px; font-weight: 700; fill: var(--tsoi-color-chart-1-text, var(--tsoi-color-chart-1)); font-variant-numeric: tabular-nums;
    opacity: 0; transition: opacity 0.9s ease; }
  .hlfig :global(.st-sub) { font-family: var(--tsoi-font-mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; fill: var(--tsoi-color-on-surface-variant);
    opacity: 0; transition: opacity 0.9s ease 0.15s; }
  .hlfig :global(.hl-svg.done .st-num), .hlfig :global(.hl-svg.done .st-sub), .hlfig :global(.hl-svg.done .hl-dot) { opacity: 1; }
  .hlfig figcaption { text-align: center; max-width: 52ch; margin-inline: auto; }

  /* ---- the gap ---- */
  /* echarts loads lazily and sets the chart's 300px height itself; holding the
     space keeps the figure from collapsing while the library is in flight */
  .gapfig .gap-area { min-height: 300px; }
  .gapfig :global(.gap-chart) { width: 100%; }

  /* ---- your basket (shared widget, styles as on the lab page) ---- */
  /* The whole widget has to be usable without scrolling: a slider you cannot
     see the answer to is a slider you cannot read. Above 640px the twelve
     dials sit beside what they drive; below it the stack tightens instead. */
  /* The dials are saffron while the basket is the official one and turn teal the
     moment it stops being official — a slider moved, or the whole hundred
     cleared. The signal is the "official basket" chip losing its lit state,
     which is exactly the condition the widget already tracks. */
  .ybfig { --yb-dial: var(--tsoi-color-primary); --yb-dial-text: var(--tsoi-color-primary-text); }
  .ybfig :global(.yb-area:has(.yb-reset:not(.yb-zero):not(.on))) {
    --yb-dial: var(--tsoi-color-chart-2);
    --yb-dial-text: var(--tsoi-color-chart-2-text, var(--tsoi-color-chart-2));
  }
  /* twelve dials and a chart need more room than the reading column gives; the
     widget alone steps outside it, and stops well short of the viewport edge */
  @media (min-width: 920px) { .ybfig { margin-inline: -60px; } }
  @media (min-width: 1120px) { .ybfig { margin-inline: -110px; } }
  .ybfig :global(.yb-area) { display: grid; gap: 10px; }
  /* twelve rows have to fit whatever is left of the screen: names on one line,
     the rate tucked directly under it */
  .ybfig :global(.yb-name) { line-height: 1.15; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ybfig :global(.yb-rate) { line-height: 1.15; }
  .ybfig :global(.yb-read) { display: flex; justify-content: center; gap: calc(var(--tsoi-spacing-unit) * 6); margin-bottom: 4px; }
  .ybfig :global(.yb-num) { display: flex; flex-direction: column; align-items: center; gap: 2px; }
  .ybfig :global(.yb-lbl) { font: var(--tsoi-text-byline); font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--tsoi-color-on-surface-variant); }
  .ybfig :global(.yb-big) { font: var(--tsoi-text-headline-lg); font-size: 34px; color: var(--tsoi-color-on-surface); font-variant-numeric: tabular-nums; }
  /* the two readings wear the read's two hues: your basket teal, the headline saffron */
  .ybfig :global(.yb-num:first-child .yb-big) { color: var(--tsoi-color-chart-2-text, var(--tsoi-color-chart-2)); }
  .ybfig :global(.yb-num:last-child .yb-big) { color: var(--tsoi-color-chart-1-text, var(--tsoi-color-chart-1)); }
  .ybfig :global(.yb-phrase) { margin: 0 0 12px !important; font-size: calc(14.5px * var(--tsoi-reading-scale, 1)) !important; line-height: 1.55 !important; color: var(--tsoi-color-on-surface-variant); text-align: center; min-height: 1.6em; }
  /* native range chrome differs wildly per engine (Safari draws a fat track
     and an oversized thumb); draw the control ourselves so every browser
     shows the same thin track and dot, the fill painted by --p */
  .ybfig :global(.yb-slider) { -webkit-appearance: none; appearance: none; background: transparent; }
  .ybfig :global(.yb-slider::-webkit-slider-runnable-track) { height: 5px; border-radius: 2.5px;
    background: linear-gradient(to right, var(--yb-dial) var(--p, 0%), var(--tsoi-color-outline-variant) var(--p, 0%)); }
  .ybfig :global(.yb-slider::-webkit-slider-thumb) { -webkit-appearance: none; appearance: none; width: 15px; height: 15px; margin-top: -5px;
    border-radius: 50%; background: var(--yb-dial); border: 2px solid var(--tsoi-color-surface); box-sizing: border-box; }
  .ybfig :global(.yb-slider::-moz-range-track) { height: 5px; border-radius: 2.5px; background: var(--tsoi-color-outline-variant); }
  .ybfig :global(.yb-slider::-moz-range-progress) { height: 5px; border-radius: 2.5px; background: var(--yb-dial); }
  .ybfig :global(.yb-slider::-moz-range-thumb) { width: 15px; height: 15px; border-radius: 50%; background: var(--yb-dial);
    border: 2px solid var(--tsoi-color-surface); box-sizing: border-box; }
  /* the time-series panel: the headline as published, your line re-drawing.
     Entity hues (local override — the shared widget ships its own colors, food
     read untouched): saffron = the headline, teal = your basket */
  .ybfig :global(.yb-ts) { margin: 2px 0 10px; }
  .ybfig :global(.yb-ts-svg) { width: 100%; display: block; }
  .ybfig :global(.yb-ts-head) { fill: none; stroke: var(--tsoi-color-chart-1); stroke-width: 1.8; }
  /* drawn under the headline (see drawTs): where the two coincide the saffron
     line covers it, and it peels out from behind as the sliders move */
  .ybfig :global(.yb-ts-you) { fill: none; stroke: var(--tsoi-color-chart-2); stroke-width: 2.2; stroke-linecap: round; }
  .ybfig :global(.yb-ts-lab) { font-family: var(--tsoi-font-mono); font-size: 11.5px; font-variant-numeric: tabular-nums; }
  .ybfig :global(.yb-ts-svg.narrow .yb-ts-lab) { font-size: 10px; }
  .ybfig :global(.yb-ts-lab-head) { fill: var(--tsoi-color-chart-1-text, var(--tsoi-color-chart-1)); }
  .ybfig :global(.yb-ts-lab-you) { fill: var(--tsoi-color-chart-2-text, var(--tsoi-color-chart-2)); font-weight: 700; }
  .ybfig :global(.yb-ts-tick) { font-family: var(--tsoi-font-mono); font-size: 11px; fill: var(--tsoi-color-on-surface-variant); }
  .ybfig :global(.yb-ts-zero) { stroke: var(--tsoi-color-outline-variant); stroke-width: 1; stroke-dasharray: 3 4; }
  /* the reserved strip above the bar is where the hot-segment label lives */
  .ybfig :global(.yb-barwrap) { position: relative; padding-top: 20px; }
  .ybfig :global(.yb-hotlab) { position: absolute; top: 0; transform: translateX(-50%); white-space: nowrap; pointer-events: none;
    font-family: var(--tsoi-font-mono); font-size: 11.5px; letter-spacing: 0.04em; color: var(--yb-dial-text);
    opacity: 0; transition: opacity 0.25s ease; }
  .ybfig :global(.yb-hotlab.show) { opacity: 1; }
  .ybfig :global(.yb-bar) { display: flex; height: 16px; border-radius: 4px; overflow: hidden; margin: 0 0 14px; }
  .ybfig :global(.yb-unspent) { background: repeating-linear-gradient(45deg, transparent 0 4px, var(--tsoi-color-outline-variant) 4px 5px); }
  .ybfig :global(.yb-seg) { flex: 0 0 auto; transition: flex-basis 0.18s ease; }
  .ybfig :global(.yb-seg + .yb-seg) { border-left: 1px solid var(--tsoi-color-surface-container-low); }
  .ybfig :global(.yb-seg-a) { background: var(--tsoi-color-outline-variant); }
  .ybfig :global(.yb-seg-b) { background: var(--tsoi-color-surface-dim); }
  .ybfig :global(.yb-seg.hot) { background: var(--yb-dial); opacity: 0.9; transition: flex-basis 0.18s ease, background 0.25s ease; }
  .ybfig :global(.yb-seg) { transition: flex-basis 0.18s ease, background 0.45s ease; }
  .ybfig :global(.yb-rows) { display: flex; flex-direction: column; gap: 6px; }
  .ybfig :global(.yb-row) { display: grid; grid-template-columns: 168px 1fr 64px; align-items: center; gap: 12px; }
  .ybfig :global(.yb-name) { display: flex; flex-direction: column; gap: 1px; font-family: var(--tsoi-font-mono); font-size: 12.5px; color: var(--tsoi-color-on-surface); }
  .ybfig :global(.yb-rate) { font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--tsoi-color-on-surface-variant); }
  .ybfig :global(.yb-val) { font-family: var(--tsoi-font-mono); font-size: 13.5px; font-weight: 700; color: var(--tsoi-color-on-surface); text-align: right; font-variant-numeric: tabular-nums; }
  .ybfig :global(.yb-btns) { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; margin: 0 0 12px; }
  .ybfig :global(.yb-reset:disabled) { opacity: 0.4; cursor: default; }
  /* the lit chip marks the starting point the basket currently sits on, and it
     lights in whichever hue the dials are wearing: saffron for the official
     basket, teal once the hundred is the reader's own */
  .ybfig :global(.yb-reset.on) { border-color: var(--yb-dial); color: var(--yb-dial-text); }
  @media (min-width: 640px) {
    /* minmax(0, …): without it the fr tracks float up to the sliders' own
       min-content width and starve the range inputs */
    .ybfig :global(.yb-area) { grid-template-columns: minmax(0, 1.02fr) minmax(0, 1fr); gap: 20px; align-items: center; }
    .ybfig :global(.yb-out) { order: 2; }
    .ybfig :global(.yb-rows) { order: 1; gap: 5px; }
    .ybfig :global(.yb-row) { grid-template-columns: 138px 1fr 52px; gap: 8px; }
    .ybfig :global(.yb-name) { font-size: 11.5px; }
    .ybfig :global(.yb-rate) { font-size: 10px; }
    .ybfig :global(.yb-rate-yr) { display: none; }
  }
  /* once the figure breaks out of the reading column there is room for the
     names and rates to come back up to a comfortable size */
  @media (min-width: 920px) {
    .ybfig :global(.yb-row) { grid-template-columns: 168px 1fr 62px; gap: 12px; }
    .ybfig :global(.yb-name) { font-size: 12.5px; }
    .ybfig :global(.yb-rate) { font-size: 11px; }
    .ybfig :global(.yb-rows) { gap: 7px; }
  }
  @media (max-width: 639px) {
    /* one screen on a phone: every band of the widget gives up a few pixels
       rather than one of them disappearing */
    /* the row flips on a phone: slider left, then the value, then the name on
       the RIGHT edge — where a (mostly right-handed) thumb naturally scrolls.
       The right rail is now ~170px of text, so a scroll that starts there
       cannot move a slider; pan-y still guards the slider itself. */
    .ybfig :global(.yb-row) { grid-template-columns: 1fr 48px 122px; gap: 8px; }
    .ybfig :global(.yb-row .yb-slider) { grid-column: 1; grid-row: 1; }
    .ybfig :global(.yb-row .yb-val) { grid-column: 2; grid-row: 1; }
    .ybfig :global(.yb-row .yb-name) { grid-column: 3; grid-row: 1; }
    .ybfig :global(.yb-name) { font-size: 10px; }
    .ybfig :global(.yb-rate) { font-size: 9px; }
    .ybfig :global(.yb-rows) { gap: 4px; }
    .ybfig :global(.yb-big) { font-size: 24px; }
    .ybfig :global(.yb-lbl) { font-size: 10px; }
    .ybfig :global(.yb-ts) { margin: 0 0 4px; }
    /* the two chips have to share one line at 360px */
    .ybfig :global(.yb-btns button) { font-size: 11px; padding: 4px 9px; letter-spacing: 0.02em; }
    .ybfig :global(.yb-phrase) { margin: 0 0 8px !important; font-size: calc(13.5px * var(--tsoi-reading-scale, 1)) !important; }
    .ybfig :global(.yb-btns) { margin: 0 0 8px; }
    .ybfig :global(.yb-barwrap) { padding-top: 17px; }
    .ybfig :global(.yb-bar) { margin-bottom: 10px; }
    /* the rate stays (it is why dragging moves your number) but sheds the
       words — the caption carries "on the year" for the narrow layout */
    .ybfig :global(.yb-rate-yr) { display: none; }
  }

  /* ---- the basket slopegraph (shared widget, styles as on the lab page) ---- */
  /* ---- rural against urban (the two-hundreds dumbbells) ---- */
  .rufig :global(.ru-svg) { width: 100%; display: block; }
  .rufig :global(.ru-grid) { stroke: var(--tsoi-color-outline-variant); stroke-width: 1; }
  .rufig :global(.ru-tick) { font-family: var(--tsoi-font-mono); fill: var(--tsoi-color-on-surface-variant); font-variant-numeric: tabular-nums; }
  .rufig :global(.ru-name) { font-family: var(--tsoi-font-mono); fill: var(--tsoi-color-on-surface-variant); cursor: pointer; }
  .rufig :global(.ru-name.on) { fill: var(--tsoi-color-on-surface); font-weight: 700; }
  .rufig :global(.ru-gap) { stroke: var(--tsoi-color-outline); stroke-linecap: round; }
  .rufig :global(.ru-dot) { stroke: var(--tsoi-color-surface-container-low); stroke-width: 1; }
  .rufig :global(circle.ru-rural) { fill: var(--ru-rural); }
  .rufig :global(circle.ru-urban) { fill: var(--ru-urban); }
  .rufig :global(text.ru-leg) { font-family: var(--tsoi-font-mono); letter-spacing: 0.04em; font-weight: 600; font-variant-numeric: tabular-nums; }
  .rufig :global(text.ru-rural), .rufig :global(tspan.ru-rural) { fill: var(--ru-rural-text); }
  .rufig :global(text.ru-urban), .rufig :global(tspan.ru-urban) { fill: var(--ru-urban-text); }
  .rufig :global(tspan.ru-sep) { fill: var(--tsoi-color-on-surface-variant); }
  .rufig :global(.ru-hit) { fill: transparent; cursor: pointer; }
  .rufig :global(.ru-cap) { margin: 10px 0 0 !important; font-size: calc(14.5px * var(--tsoi-reading-scale, 1)) !important; line-height: 1.55 !important; color: var(--tsoi-color-on-surface-variant); min-height: 3.2em; text-align: center; }
  /* the caption's figures wear the sector hues (the phone fallback for the
     on-dot labels) */
  .rufig :global(.ru-cap-r) { color: var(--ru-rural-text); font-weight: 600; font-variant-numeric: tabular-nums; }
  .rufig :global(.ru-cap-u) { color: var(--ru-urban-text); font-weight: 600; font-variant-numeric: tabular-nums; }

  .bkfig :global(.bk-svg) { width: 100%; display: block; }
  .bkfig :global(.bk-pole) { stroke: var(--tsoi-color-outline-variant); stroke-width: 1; }
  .bkfig :global(.bk-head) { font-family: var(--tsoi-font-mono); font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; fill: var(--tsoi-color-on-surface-variant); }
  .bkfig :global(.bk-line) { fill: none; stroke-linecap: round; transition: stroke-width 0.2s; }
  .bkfig :global(.bk-hit) { stroke: transparent; stroke-width: 15; cursor: pointer; }
  .bkfig :global(.bk-dot) { stroke: var(--tsoi-color-surface-container-low); stroke-width: 1; }
  .bkfig :global(.bk-lead) { stroke: var(--tsoi-color-outline-variant); stroke-width: 1; }
  .bkfig :global(.bk-ll), .bkfig :global(.bk-rl) { font-family: var(--tsoi-font-mono); cursor: pointer; fill: var(--tsoi-color-on-surface-variant); font-variant-numeric: tabular-nums; }
  .bkfig :global(.bk-ll.on), .bkfig :global(.bk-rl.on) { fill: var(--tsoi-color-on-surface); font-weight: 700; }
  .bkfig :global(.bk-cap) { margin: 10px 0 0 !important; font-size: calc(14.5px * var(--tsoi-reading-scale, 1)) !important; line-height: 1.55 !important; color: var(--tsoi-color-on-surface-variant); min-height: 3.2em; text-align: center; }

  /* ---- part divider ---- */
  .prose :global(.partmark) { margin: calc(var(--tsoi-spacing-unit) * 6) 0 calc(var(--tsoi-spacing-unit) * 1) !important;
    font: var(--tsoi-text-byline) !important; font-size: 12px !important; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--tsoi-color-primary-text); text-align: center; }
  /* the Part I mark opens the piece, so it takes the header's spacing, not the
     long gap the later part breaks need */
  .prose :global(.partmark-first) { margin: 0 0 calc(var(--tsoi-spacing-unit) * 2.5) !important; }

  /* ---- the two-averages tables ---- */
  .swfig { margin: calc(var(--tsoi-spacing-unit) * 2.5) 0; }
  .sw-table { width: 100%; border-collapse: collapse; }
  .sw-table th, .sw-table td { font-family: var(--tsoi-font-mono); font-size: 13px; padding: 7px 10px; text-align: right; border-bottom: 1px solid var(--tsoi-color-outline-variant); font-variant-numeric: tabular-nums; color: var(--tsoi-color-on-surface); }
  .sw-table th { font-weight: 400; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--tsoi-color-on-surface-variant); }
  .sw-table th:first-child, .sw-table td:first-child { text-align: left; }
  .sw-table td:first-child { color: var(--tsoi-color-on-surface-variant); }
  /* the multiplied average wears saffron — it graduates into the official index two
     sections later; the added average's failures are bold ink, not saffron, so the
     brand hue never marks the wrong answer. Both averages are bold: saffron alone
     lost the column to the ink the failures were set in. */
  .sw-table td.sw-mult { color: var(--tsoi-color-primary-text); font-weight: 700; }
  .sw-table td.sw-hot { color: var(--tsoi-color-on-surface); font-weight: 700; }
  @media (max-width: 520px) {
    .sw-table th, .sw-table td { font-size: 10.5px; padding: 6px 5px; }
  }

  /* The semicircle proof (.proofbox .pf-*) and Delhi/Kerala drift (.dffig .mx-*) styles left
     with the climb restructure — recover from git history when the Part II averaging
     collapsible is built. */

  /* ---- the funnel ---- */
  /* One hue per floor, the same five the prose spans wear, with saffron kept
     for the headline row at the top. Cell widths are shares of the ₹100, so a
     row is a real division of the hundred and not a row of equal boxes. */
  .pyfig :global(.fn-wrap) { position: relative; }
  /* the click target is the svg root (668 cells is 668 listeners otherwise), so
     a tap lights the WHOLE figure blue on mobile — the browser is highlighting
     the clickable element, and the clickable element is the entire funnel.
     Killing the highlight and the selection flash leaves the cell's own
     selected outline to say what was picked. */
  .pyfig :global(.fn-svg) { width: 100%; display: block; cursor: pointer; touch-action: pan-y;
    -webkit-tap-highlight-color: transparent; -webkit-user-select: none; user-select: none; }
  .pyfig :global(.fn-cell) { transition: opacity 0.45s ease; }
  .pyfig :global(.fn-row-general .fn-cell) { fill: var(--tsoi-color-chart-1); }
  .pyfig :global(.fn-row-division .fn-cell) { fill: var(--lvl-div); }
  .pyfig :global(.fn-row-group .fn-cell) { fill: var(--lvl-group); }
  .pyfig :global(.fn-row-class .fn-cell) { fill: var(--lvl-class); }
  .pyfig :global(.fn-row-subclass .fn-cell) { fill: var(--lvl-sub); }
  .pyfig :global(.fn-row-item .fn-cell) { fill: var(--lvl-item); }
  /* the selected lineage keeps a surface-coloured hairline so it reads as
     picked out even where its neighbours are painted the same strength */
  .pyfig :global(.fn-cell.on) { stroke: var(--tsoi-color-on-surface); stroke-width: 1.4; paint-order: stroke; }
  .pyfig :global(.fn-thread) { fill: none; stroke-width: 2; opacity: 0.9; }
  .pyfig :global(.fn-thread-division) { stroke: var(--lvl-div); }
  .pyfig :global(.fn-thread-group) { stroke: var(--lvl-group); }
  .pyfig :global(.fn-thread-class) { stroke: var(--lvl-class); }
  .pyfig :global(.fn-thread-subclass) { stroke: var(--lvl-sub); }
  .pyfig :global(.fn-thread-item) { stroke: var(--lvl-item); }
  .pyfig :global(.fn-count) { font-family: var(--tsoi-font-mono); font-size: 10px; letter-spacing: 0.05em; text-transform: uppercase; fill: var(--tsoi-color-on-surface-variant); }
  .pyfig :global(.fn-num) { font-family: var(--tsoi-font-mono); font-size: 11.5px; font-weight: 700; font-variant-numeric: tabular-nums; fill: var(--tsoi-color-on-surface); }
  .pyfig :global(.fn-name) { font-family: var(--tsoi-font-mono); font-size: 10.5px; fill: var(--tsoi-color-on-surface-variant); }
  /* A halo in the page colour: the thread joining two floors runs through
     the gap these labels are printed in, and under a caption it is a rule
     drawn across the reading. paint-order puts the stroke behind the fill
     so the letters keep their own shape. */
  .pyfig :global(.fn-num), .pyfig :global(.fn-name) { paint-order: stroke; stroke: var(--tsoi-color-surface); stroke-width: 3px; stroke-linejoin: round; }
  /* each floor's own label takes that floor's hue, so the name under a strip
     and the level noun in the prose match without a legend */
  .pyfig :global(.fn-row-general .fn-num) { fill: var(--tsoi-color-chart-1-text, var(--tsoi-color-chart-1)); }
  .pyfig :global(.fn-row-division .fn-num) { fill: var(--lvl-div-text); }
  .pyfig :global(.fn-row-group .fn-num) { fill: var(--lvl-group-text); }
  .pyfig :global(.fn-row-class .fn-num) { fill: var(--lvl-class-text); }
  .pyfig :global(.fn-row-subclass .fn-num) { fill: var(--lvl-sub-text); }
  .pyfig :global(.fn-row-item .fn-num) { fill: var(--lvl-item-text); }
  /* one line on a wide screen, two at worst on a phone — the narration is short
     enough now that the old three-line reservation was just a hole */
  .pyfig :global(.fn-cap) { margin: 10px 0 10px !important; font-size: calc(14.5px * var(--tsoi-reading-scale, 1)) !important; line-height: 1.55 !important;
    color: var(--tsoi-color-on-surface-variant); text-align: center; min-height: 1.6em; }
  .pyfig :global(.fn-cap strong) { color: var(--tsoi-color-on-surface); font-weight: 700; }
  @media (max-width: 520px) { .pyfig :global(.fn-cap) { min-height: 3.2em; } }
  .pyfig :global(.fn-btns) { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }
  .pyfig :global(.fn-btn:disabled) { opacity: 0.4; cursor: default; }
  /* the tooltip does the identifying work the thin rows cannot */
  .pyfig :global(.fn-tip) { position: absolute; z-index: 2; pointer-events: none; opacity: 0; transition: opacity 0.15s ease;
    display: flex; flex-direction: column; gap: 1px; padding: 7px 10px; max-width: 260px;
    background: var(--tsoi-color-surface-container-high); border: 1px solid var(--tsoi-color-outline-variant); border-radius: var(--tsoi-radius-sm, 3px);
    font-family: var(--tsoi-font-mono); font-size: 11px; line-height: 1.45; color: var(--tsoi-color-on-surface-variant); }
  .pyfig :global(.fn-tip.show) { opacity: 1; }
  .pyfig :global(.fn-tip-name) { color: var(--tsoi-color-on-surface); font-weight: 700; }
  .pyfig :global(.fn-tip-lvl) { font-size: 9.5px; letter-spacing: 0.07em; text-transform: uppercase; }
  .pyfig :global(.fn-tip-row) { font-variant-numeric: tabular-nums; }
  .pyfig :global(.fn-svg.narrow .fn-num) { font-size: 10.5px; }
  .pyfig :global(.fn-svg.narrow .fn-name) { font-size: 9px; }
  .pyfig :global(.fn-svg.narrow .fn-count) { font-size: 8.5px; }

  /* ---- the index/rate strips (rlfig + lrfig), sectors (sxfig), core (cofig) ---- */
  /* Colour code, held across all four figures and the prose: the HEADLINE
     RATE is saffron, the INDEX it is read from is ink. Rural and urban keep
     their green and purple; core wears the gold chart hue, because ink now
     means index. */
  .ixfig :global(.ix-svg), .sxfig :global(.sx-svg), .cofig :global(.co-svg) { width: 100%; display: block; touch-action: pan-y; cursor: ew-resize; }
  .ixfig :global(.ix-title), .sxfig :global(.ix-title) { font-family: var(--tsoi-font-mono); font-size: 10.5px; letter-spacing: 0.06em; text-transform: uppercase; fill: var(--tsoi-color-on-surface-variant); }
  .ixfig :global(.ix-tick), .sxfig :global(.ix-tick), .cofig :global(.ix-tick) { stroke: var(--tsoi-color-outline-variant); stroke-width: 1; }
  .ixfig :global(.ix-ticklab), .sxfig :global(.ix-ticklab), .cofig :global(.ix-ticklab) { font-family: var(--tsoi-font-mono); font-size: 10px; fill: var(--tsoi-color-on-surface-variant); }
  .ixfig :global(.ix-base), .sxfig :global(.ix-base) { stroke: var(--tsoi-color-outline); stroke-width: 1; stroke-dasharray: 3 3; }
  .ixfig :global(.ix-baselab), .sxfig :global(.ix-baselab) { font-family: var(--tsoi-font-mono); font-size: 10px; fill: var(--tsoi-color-on-surface-variant); }
  .ixfig :global(.ix-zero), .cofig :global(.co-zero) { stroke: var(--tsoi-color-outline-variant); stroke-width: 1; }
  .cofig :global(.co-grid) { stroke: var(--tsoi-color-outline-variant); stroke-width: 0.5; opacity: 0.55; }
  .ixfig :global(.ix-guide), .sxfig :global(.ix-guide), .cofig :global(.ix-guide) { stroke: var(--tsoi-color-outline); stroke-width: 1; stroke-dasharray: 2 3; }
  .ixfig :global(.ix-line) { fill: none; stroke: var(--tsoi-color-on-surface); stroke-width: 2; stroke-linejoin: round; }
  .ixfig :global(.ix-rline) { fill: none; stroke: var(--tsoi-color-primary); stroke-width: 2; stroke-linejoin: round; }
  .ixfig :global(.ix-dot) { fill: var(--tsoi-color-on-surface); }
  .ixfig :global(.ix-dot-rate) { fill: var(--tsoi-color-primary); }
  .ixfig :global(.ix-markdot) { fill: var(--tsoi-color-surface-container-low); stroke: var(--tsoi-color-on-surface); stroke-width: 1.5; }
  .ixfig :global(.ix-val) { font-family: var(--tsoi-font-mono); font-size: 11.5px; font-weight: 700; fill: var(--tsoi-color-on-surface); }
  .ixfig :global(.ix-val-rate) { fill: var(--tsoi-color-primary-text); }
  .ixfig :global(.ix-marklab), .ixfig :global(.ix-sum) { font-family: var(--tsoi-font-mono); font-size: 10px; fill: var(--tsoi-color-on-surface-variant); }
  .ixfig :global(.ix-arc) { fill: none; stroke: var(--tsoi-color-outline); stroke-width: 1; stroke-dasharray: 3 3; }
  /* the long-run figure's seam wears the splice red, as do the multiplier
     annotations; the hollow ink dot is the old series' last print */
  .lrfig :global(.lr-seam) { stroke: var(--splice); stroke-width: 1; stroke-dasharray: 4 3; }
  .lrfig :global(.lr-seamlab) { font-family: var(--tsoi-font-mono); font-size: 10px; fill: var(--splice-text); }
  .lrfig :global(.lr-math) { font-family: var(--tsoi-font-mono); font-size: 10px; font-weight: 600; fill: var(--splice-text); }
  .lrfig :global(.lr-lf) { color: var(--splice-text); font-weight: 700; }
  .ixfig :global(.ix-cap), .sxfig :global(.ix-cap), .cofig :global(.ix-cap) { margin: 10px 0 6px !important; font-size: calc(14.5px * var(--tsoi-reading-scale, 1)) !important; line-height: 1.55 !important;
    color: var(--tsoi-color-on-surface-variant); text-align: center; min-height: 3.2em; }
  .ixfig :global(.ix-cap strong), .sxfig :global(.ix-cap strong), .cofig :global(.ix-cap strong) { color: var(--tsoi-color-on-surface); font-weight: 700; }
  .ixfig :global(.ix-h), .sxfig :global(.ix-h), .cofig :global(.ix-h) { color: var(--tsoi-color-primary-text); font-weight: 700; }
  .sxfig :global(.ix-r) { color: var(--ru-rural-text); font-weight: 700; }
  .sxfig :global(.ix-u) { color: var(--ru-urban-text); font-weight: 700; }
  /* sectors: the prose's own green and purple, the blend as dashed ink */
  .sxfig :global(.sx-rural) { fill: none; stroke: var(--ru-rural); stroke-width: 2; stroke-linejoin: round; }
  .sxfig :global(.sx-urban) { fill: none; stroke: var(--ru-urban); stroke-width: 2; stroke-linejoin: round; }
  .sxfig :global(.sx-blend) { fill: none; stroke: var(--tsoi-color-on-surface); stroke-width: 1.5; stroke-linejoin: round; stroke-dasharray: 4 3; }
  .sxfig :global(.sx-dot-rural) { fill: var(--ru-rural); }
  .sxfig :global(.sx-dot-urban) { fill: var(--ru-urban); }
  .sxfig :global(.sx-dot-blend) { fill: var(--tsoi-color-on-surface); }
  .sxfig :global(.sx-endlab) { font-family: var(--tsoi-font-mono); font-size: 10.5px; }
  .sxfig :global(.sx-endlab-rural) { fill: var(--ru-rural-text); }
  .sxfig :global(.sx-endlab-urban) { fill: var(--ru-urban-text); }
  .sxfig :global(.sx-endlab-blend) { fill: var(--tsoi-color-on-surface); }
  /* the aisles: one division at a time, in the division teal the prose wears */
  .aifig :global(.ai-svg) { width: 100%; display: block; touch-action: pan-y; cursor: ew-resize; }
  .aifig :global(.ix-title), .aifig :global(.ix-ticklab), .aifig :global(.ix-baselab) { font-family: var(--tsoi-font-mono); fill: var(--tsoi-color-on-surface-variant); }
  .aifig :global(.ix-title) { font-size: 10.5px; letter-spacing: 0.06em; text-transform: uppercase; }
  .aifig :global(.ix-ticklab), .aifig :global(.ix-baselab) { font-size: 10px; }
  .aifig :global(.ix-tick) { stroke: var(--tsoi-color-outline-variant); stroke-width: 1; }
  .aifig :global(.ix-base) { stroke: var(--tsoi-color-outline); stroke-width: 1; stroke-dasharray: 3 3; }
  .aifig :global(.ix-guide) { stroke: var(--tsoi-color-outline); stroke-width: 1; stroke-dasharray: 2 3; }
  .aifig :global(.ai-line) { fill: none; stroke: var(--lvl-div); stroke-width: 2; stroke-linejoin: round; }
  .aifig :global(.ai-dot) { fill: var(--lvl-div); }
  .aifig :global(.ix-markdot) { fill: var(--tsoi-color-surface-container-low); stroke: var(--tsoi-color-on-surface); stroke-width: 1.5; }
  .aifig :global(.ix-val) { font-family: var(--tsoi-font-mono); font-size: 11.5px; font-weight: 700; fill: var(--tsoi-color-on-surface); }
  .aifig :global(.ix-cap) { margin: 10px 0 6px !important; font-size: calc(14.5px * var(--tsoi-reading-scale, 1)) !important; line-height: 1.55 !important;
    color: var(--tsoi-color-on-surface-variant); text-align: center; min-height: 3.2em; }
  .aifig :global(.ix-cap strong) { color: var(--tsoi-color-on-surface); font-weight: 700; }
  .aifig :global(.ai-r) { color: var(--lvl-div-text); font-weight: 700; }
  .aifig :global(.ai-tabs) { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; margin-top: 4px; }
  /* the active tab wears the aisles' own teal, not saffron: saffron means
     the headline, and a division tab is not the headline */
  .aifig :global(.ai-tab.on) { border-color: var(--lvl-div); color: var(--lvl-div-text); }
  .cofig :global(.co-g) { color: var(--core-text); font-weight: 700; }
  .cofig :global(.co-head) { fill: none; stroke: var(--tsoi-color-primary); stroke-width: 1.8; stroke-linejoin: round; }
  /* core wears the gold chart hue: ink is reserved for the index */
  .cofig :global(.co-core) { fill: none; stroke: var(--tsoi-color-chart-6); stroke-width: 1.8; stroke-linejoin: round; }
  .cofig :global(.co-dot-head) { fill: var(--tsoi-color-primary); }
  .cofig :global(.co-dot-core) { fill: var(--tsoi-color-chart-6); }
  .cofig :global(.co-endlab) { font-family: var(--tsoi-font-mono); font-size: 10.5px; }
  .cofig :global(.co-endlab-head) { fill: var(--tsoi-color-primary-text); }
  .cofig :global(.co-endlab-core) { fill: var(--tsoi-color-chart-6-text, var(--tsoi-color-chart-6)); }
  /* no engaged state on these buttons: the label itself flips (Add food /
     Subtract food), so the wording carries the state */
  .cofig :global(.co-btns) { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; margin-top: 4px; }

  /* ---- the balance beam ---- */
  .bmfig :global(.bm-svg) { width: 100%; display: block; }
  .bmfig :global(.mx-tick) { stroke: var(--tsoi-color-outline-variant); stroke-width: 1; }
  .bmfig :global(.mx-ticklab) { font-family: var(--tsoi-font-mono); font-size: 10px; fill: var(--tsoi-color-on-surface-variant); }
  .bmfig :global(.bm-beam) { stroke: var(--tsoi-color-on-surface); stroke-width: 2; }
  .bmfig :global(.bm-disc-g) { cursor: pointer; transition: transform 0.45s cubic-bezier(0.35, 0, 0.2, 1); }
  .bmfig :global(.bm-namelab) { font-family: var(--tsoi-font-mono); font-size: 10.5px; letter-spacing: 0.05em; text-transform: uppercase; fill: var(--tsoi-color-on-surface); pointer-events: none; }
  .bmfig :global(.bm-disc) { fill: var(--tsoi-color-surface-dim); stroke: var(--tsoi-color-outline); stroke-width: 1.2; transition: fill 0.3s, stroke 0.3s; }
  /* the discs are the twelve divisions, so a selected one lights in the division
     hue; the fulcrum and its number stay saffron, because that is the headline */
  .bmfig :global(.bm-disc-g.on .bm-disc) { fill: var(--lvl-div); stroke: var(--lvl-div); opacity: 0.92; }
  .bmfig :global(.bm-disclab) { font-family: var(--tsoi-font-mono); font-size: 9px; letter-spacing: 0.05em; text-transform: uppercase; fill: var(--tsoi-color-on-surface-variant); pointer-events: none; }
  .bmfig :global(.bm-disc-g.on .bm-disclab) { fill: var(--tsoi-color-surface-container-low); }
  .bmfig :global(.bm-ful-g) { transition: transform 0.8s cubic-bezier(0.35, 0, 0.2, 1); }
  .bmfig :global(.bm-ful) { fill: var(--tsoi-color-chart-1); }
  .bmfig :global(.bm-fullab) { font-family: var(--tsoi-font-mono); font-size: 11.5px; font-weight: 700; font-variant-numeric: tabular-nums; fill: var(--tsoi-color-chart-1-text, var(--tsoi-color-chart-1)); }
  .bmfig :global(.bm-fuldelta) { font-family: var(--tsoi-font-mono); font-size: 10px; fill: var(--tsoi-color-on-surface-variant); }
  .bmfig :global(.bm-btns) { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; }
  .bmfig :global(.bm-btn:disabled) { opacity: 0.4; cursor: default; }
  /* the drag is delegated to the svg root, and touch-action has to live there:
     WebKit ignores it on SVG children. pan-y keeps vertical scrolling through
     the figure while the horizontal gesture belongs to the beam. */
  .bmfig :global(.bm-svg) { touch-action: pan-y; }
  .bmfig :global(.bm-cap) { margin: 8px 0 10px !important; font-size: calc(14.5px * var(--tsoi-reading-scale, 1)) !important; line-height: 1.55 !important;
    color: var(--tsoi-color-on-surface-variant); text-align: center; min-height: 1.6em; }

  /* ---- shared axis chrome (was shared with the parked base-effect scrubber;
          its .bsfig rules left with the section — see the parked doc) ---- */
  .rofig :global(.mx-tick), .sdfig :global(.mx-tick) { stroke: var(--tsoi-color-outline-variant); stroke-width: 1; }
  .rofig :global(.mx-ticklab), .sdfig :global(.mx-ticklab) { font-family: var(--tsoi-font-mono); font-size: 10px; fill: var(--tsoi-color-on-surface-variant); }
  .rofig :global(.bs-zero), .sdfig :global(.bs-zero) { stroke: var(--tsoi-color-outline-variant); stroke-width: 1; }

  /* ---- Part III: what the average hides ---- */
  .ctfig :global(.ct-head) { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; margin-bottom: 10px; }
  .ctfig :global(.ct-big) { font-family: var(--tsoi-font-mono); font-size: 30px; font-weight: 700; font-variant-numeric: tabular-nums;
    color: var(--tsoi-color-primary-text); line-height: 1; }
  .ctfig :global(.ct-biglab) { font-size: 13px; color: var(--tsoi-color-on-surface-variant); }
  .ctfig :global(.ct-svg) { width: 100%; display: block; }
  .ctfig :global(.ct-name) { font-size: 11.5px; fill: var(--tsoi-color-on-surface); }
  .ctfig :global(.ct-num) { font-family: var(--tsoi-font-mono); font-size: 10.5px; fill: var(--tsoi-color-on-surface-variant); font-variant-numeric: tabular-nums; }
  /* item green: the bars are items, and Part II taught that colour */
  .ctfig :global(.ct-bar) { fill: var(--lvl-item); opacity: 0.75; transition: opacity 0.45s ease, width 0.45s ease; }
  .ctfig :global(.ct-row.jewel .ct-bar) { opacity: 1; }
  .ctfig :global(.ct-row.jewel .ct-name) { font-weight: 700; }
  .ctfig :global(.ct-row.gone) { opacity: 0.18; }
  .ctfig :global(.ct-row.gone .ct-bar) { opacity: 0.25; }
  .ctfig :global(.ct-btn) { margin-top: 10px; }
  .ctfig :global(.ct-cap) { margin: 8px 0 4px !important; font-size: calc(14.5px * var(--tsoi-reading-scale, 1)) !important; line-height: 1.55 !important;
    color: var(--tsoi-color-on-surface-variant); min-height: 3em; }

  /* ---- Part III: many Indias ---- */
  .sdfig :global(.sd-svg) { width: 100%; display: block; touch-action: pan-y; }
  .sdfig :global(.sd-grid) { stroke: var(--tsoi-color-outline-variant); stroke-width: 1; opacity: 0.4; }
  .sdfig :global(.sd-axis) { stroke: var(--tsoi-color-outline-variant); stroke-width: 1; }
  /* every state the same weight: the figure is a distribution, not a ranking */
  /* the three prose-named states and the hovered dot wear saffron — the
     swarm stays ink so the highlight is the only warm thing in it */
  .sdfig :global(.sd-dot) { fill: var(--tsoi-color-on-surface); opacity: 0.42; stroke: var(--tsoi-color-surface); stroke-width: 1.5; }
  .sdfig :global(.sd-dot.named) { fill: var(--tsoi-color-primary); opacity: 0.95; }
  .sdfig :global(.sd-dot.on) { fill: var(--tsoi-color-primary); opacity: 1; }
  /* All India: one line straight through everybody */
  .sdfig :global(.sd-ai) { stroke: var(--tsoi-color-chart-1); stroke-width: 2; }
