<script>
  import { readTokens } from '../../../lib/dashboards/runtime';
  // initDrift (Delhi/Kerala chained drift) and initProof (the AM/GM semicircle) left with
  // the climb restructure; both are reserved for the Part II averaging collapsible (TODO).
  // initBase left with the parked base-effect section (Aug 2026) — still exported from the
  // widgets module for whatever that section becomes. initMerge/initStrands (the old
  // strands close) retired the same day for initClose; kept in the module, unused.
  // Three closes exist in the module: initClose (companion line),
  // initCloseLayers (haze — rejected as too noisy), and initCloseUnfold
  // (the line ends and its dot unfolds into the funnel — CHOSEN, 2026-08-01).
  // Swap the import + call + caption to change.
  import { initGap, initOneLine, initPyramid, initBeam, initIndexRate, initLongRun, initSectors, initAisles, initCore, initContrib, initStates, initRepo, initCloseUnfold } from '../../../lib/reads/inflation-widgets';
  import type { CoreData, GapData, LongRunData, OneLineData, PyramidData, RulerData, StrandsData, WildData } from '../../../lib/reads/inflation-widgets';
  import { initYourBasket, initBasketSlope, initSectorWeights } from '../../../lib/reads/basket-widgets';
  import type { BasketDiv, YourBasketData } from '../../../lib/reads/basket-widgets';

  const data: {
    gap: GapData; basket: BasketDiv[]; yourBasket: YourBasketData; oneLine: OneLineData;
    ruler: RulerData; core: CoreData; longRun: LongRunData;
    pyramid: PyramidData & { sectors: { rural: number; urban: number } };
    strands: StrandsData; wild: WildData;
    layers: { groups: { name: string; months: string[]; yoy: (number | null)[] }[] };
  } = JSON.parse(document.getElementById('inflation-read-data')!.textContent!);

  const yb = initYourBasket(document.querySelector<HTMLElement>('.ybfig'), data.yourBasket);
  const widgets = [
    initOneLine(document.querySelector<HTMLElement>('.hlfig'), data.oneLine),
    yb,
    initSectorWeights(document.querySelector<HTMLElement>('.rufig'), data.basket),
    initBasketSlope(document.querySelector<HTMLElement>('.bkfig'), data.basket),
    initIndexRate(document.querySelector<HTMLElement>('.rlfig'), { months: data.ruler.months, idx: data.ruler.combined }),
    initLongRun(document.querySelector<HTMLElement>('.lrfig'), data.longRun),
    initSectors(document.querySelector<HTMLElement>('.sxfig'), data.ruler, data.pyramid.sectors),
    initAisles(document.querySelector<HTMLElement>('.aifig'), data.ruler.months, data.strands.divisions),
    initCore(document.querySelector<HTMLElement>('.cofig'), data.core),
    initPyramid(document.querySelector<HTMLElement>('.pyfig'), data.pyramid),
    initBeam(document.querySelector<HTMLElement>('.bmfig'), data.yourBasket, data.pyramid.path[0]),
    initContrib(document.querySelector<HTMLElement>('.ctfig'), data.wild.contrib),
    initStates(document.querySelector<HTMLElement>('.sdfig'), data.wild.states),
    initRepo(document.querySelector<HTMLElement>('.rofig'), data.wild.repo),
    initCloseUnfold(document.querySelector<HTMLElement>('.scfig'), data.oneLine, data.pyramid),
  ];

  // echarts serves only the gap figure, so its ~1MB stays off the critical
  // path: every hand-drawn widget above initializes the moment this small
  // module runs, and the gap figure fills its reserved 300px when the library
  // lands. Pushed into the same array so theme/font rerenders reach it too.
  import('echarts').then((echarts) => {
    widgets.push(initGap(document.querySelector<HTMLElement>('.gapfig'), data.gap, { echarts, tokens: readTokens }));
  });

  const rerender = () => widgets.forEach((w) => w.refresh());
  new MutationObserver(rerender)
    .observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme', 'data-units'] });
  document.fonts?.ready.then(rerender);
</script>

