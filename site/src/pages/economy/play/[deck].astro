---
// Per-deck route (/economy/play/payments). Decks are retired from the rack
// but their URLs live forever, so the page keeps rendering, unlisted (the
// short-read treatment). Nothing points here any more: /economy/beats used to
// 301 in, and stopped (Jul 2026) once it turned out to be the site's top
// search result, feeding every visitor onto a noindex dead end. Games own the
// rack now.
import BeatsDeck from '../../../components/story/BeatsDeck.astro';
import { BEAT_DECKS } from '../../../lib/beats';

export function getStaticPaths() {
  return Object.keys(BEAT_DECKS).map((deck) => ({ params: { deck } }));
}

const deck = BEAT_DECKS[Astro.params.deck!];
---

<BeatsDeck deck={deck} />
