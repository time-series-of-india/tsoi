---
// The Explore index for the Economy section (/economy/explore) — explore
// holds products, and today its only product is a dashboard (a set of desks).
// Dashboards are instruments, not stories: they don't age into an archive, so
// the page is organised by STRUCTURE, not recency. Each product gets ONE
// gateway card and nothing else.
//
// It used to carry question-first rows under the gateway ("By bank" jumping
// to the bank desk) and a contents nav above it. Both went in Jul 2026: once
// the desks fold had collapsed the six standalone boards into a single
// /economy/explore/payments page, the rows were five links to five anchors on
// the one page the gateway already opens, and the contents nav was a
// table-of-contents over a single entry. The desk list belongs to the
// dashboard, which publishes its own jump nav — this page's job is just to
// hand you the door. Future products (food prices, ...) append to PRODUCTS
// and land beside payments.
//
// Meta here is freshness (the trust signal for a tool), not dispatch
// provenance: that's what the reads shelf carries.
import { readFileSync } from 'node:fs';
import StoryPage from '../../../layouts/StoryPage.astro';
import SectionHeader from '../../../components/editorial/SectionHeader.astro';
import ViewToggle from '../../../components/editorial/ViewToggle.astro';
import { lineMotif } from '../../../lib/lineMotif';

const sectionDate = new Date()
  .toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })
  .toUpperCase();

// Both Inflation products' cover-in-waiting: the one continuous CPI index
// line the time machine runs on (public/data/economy/rupee-time-machine.json,
// the same series described as "the headline back to 1969" — build-dashboard-
// thumbs.mjs hasn't captured either page yet, so this stands in the way
// Inflation Peaks' terrain stands in for its own screenshot-less card.
const rtmSeries = (JSON.parse(
  readFileSync('public/data/economy/rupee-time-machine.json', 'utf8'),
).idx as number[]);
// width is 8px narrower than the 240 viewBox, leaving a 4px margin either
// side (translated in the markup below) so the last point — and the time
// machine's solid "to" pin sitting on it — never clips against the card edge.
const boardLine = lineMotif(rtmSeries, { samples: 140, width: 232, top: 12, bottom: 118 });
// The time machine draws the same line, plus the two points a reader picks —
// an earlier month (hollow) and the one it's compared against (solid), the
// same hollow/solid pairing FormatMotif's game mark uses for guess vs actual.
const rtmFrom = boardLine.coords[Math.round(boardLine.coords.length * 0.22)];
const rtmTo = boardLine.coords[boardLine.coords.length - 1];

// One THEME group per subject, holding one or more product cards. It was one
// group per product until Aug 2026, when the Rupee Time Machine arrived and
// Inflation became a subject with two instruments on it rather than a single
// dashboard: the group header carries the subject and its cadence, and the
// cards under it are the things a reader can open. Payments still has one.
// Newest subject first (dispatch No. 2's Inflation ahead of dispatch No. 1's
// Payments) — only the group order encodes recency; within Inflation the two
// products sit in the order a reader meets them (the board, then the machine
// built on the same series).
//
// `thumb` is optional: the covers are captured by
// scripts/build-dashboard-thumbs.mjs and committed, so a product can be
// published here before its thumbs have been generated. Until then `motif`
// draws the product's own line instead of leaving the card bare — the card
// drops the cover and runs full width only once neither exists. `go` is the
// card's own verb: a dashboard is opened, a machine is opened, and neither
// should borrow the other's line.
const GROUPS = [
  {
    id: 'inflation',
    label: 'Inflation',
    cadence: 'Monthly · MoSPI releases',
    products: [
      {
        href: '/economy/explore/inflation',
        title: 'India Inflation',
        deck: 'Every inflation desk on one page: the headline back to 1969, the divisions that moved it, the whole basket it is built from, and where in the country it lands hardest.',
        go: 'Open the dashboard →',
        thumb: '/thumbs/explore/inflation.png',
        thumbDark: '/thumbs/explore/inflation-dark.png',
        motif: 'board' as const,
      },
      {
        href: '/economy/explore/rupee-time-machine',
        title: 'Rupee Time Machine',
        deck: 'Any amount, any two months since August 1969: what it spent like then against what it spends like now, on one continuous price line.',
        go: 'Open the machine →',
        thumb: '/thumbs/explore/rupee-time-machine.png',
        thumbDark: '/thumbs/explore/rupee-time-machine-dark.png',
        motif: 'rtm' as const,
      },
    ],
  },
  {
    id: 'payments',
    label: 'Payments',
    cadence: 'Monthly · RBI / NPCI releases',
    products: [
      {
        href: '/economy/explore/payments',
        title: 'India Payments',
        deck: 'Every payments desk on one page: the headline totals first, then one desk per question, from bank performance to what India buys on UPI.',
        go: 'Open the dashboard →',
        thumb: '/thumbs/explore/payments.png',
        thumbDark: '/thumbs/explore/payments-dark.png',
        motif: null,
      },
    ],
  },
];
---

<StoryPage
  title="Explore — Time Series of India"
  description="Interactive dashboards of India's economy — payments and prices — built from official RBI, NPCI, MoSPI and Labour Bureau data."
  og_image="/og/explore/index.png"
>
  <SectionHeader label="Economy · Explore" date={sectionDate}>
    <ViewToggle active="explore" slot="actions" />
  </SectionHeader>

  <!-- What explore IS, in one line. What a DESK is belongs to the dashboard
       itself (see explore/payments.astro's deck) — saying it in both places
       made the reader learn the same vocabulary twice. -->
  <p class="intro">
    Interactive views of India's economy.
  </p>

  {GROUPS.map((g) => (
    <section class="theme-group" id={g.id}>
      <h2 class="theme-head">
        <span class="theme-label">{g.label}</span>
        <span class="hair" aria-hidden="true"></span>
        <span class="cadence">{g.cadence}</span>
      </h2>

      <!-- the product cards — siblings, no elevation between them: a group
           with two instruments is not a group with a headline and a footnote -->
      {g.products.map((p) => (
        <a class:list={['gateway', { 'no-cover': !p.thumb && !p.motif }]} href={p.href}>
          {p.thumb ? (
            <span class="gw-cover">
              <img class="t-light" src={p.thumb} alt="" loading="lazy" />
              <img class="t-dark" src={p.thumbDark} alt="" loading="lazy" />
            </span>
          ) : p.motif === 'board' ? (
            <span class="gw-cover">
              <svg class="gw-motif" viewBox="0 0 240 135" preserveAspectRatio="none" aria-hidden="true">
                <g transform="translate(4, 0)">
                  <polyline points={boardLine.points} />
                </g>
              </svg>
            </span>
          ) : p.motif === 'rtm' ? (
            <span class="gw-cover">
              <svg class="gw-motif" viewBox="0 0 240 135" preserveAspectRatio="none" aria-hidden="true">
                <g transform="translate(4, 0)">
                  <polyline points={boardLine.points} />
                  <circle class="pin-from" cx={rtmFrom.x} cy={rtmFrom.y} r="3.25" />
                  <circle class="pin-to" cx={rtmTo.x} cy={rtmTo.y} r="3.25" />
                </g>
              </svg>
            </span>
          ) : null}
          <span class="gw-body">
            <span class="gw-title">{p.title}</span>
            <span class="gw-deck">{p.deck}</span>
            <span class="go">{p.go}</span>
          </span>
        </a>
      ))}
    </section>
  ))}
</StoryPage>

<style>
  .intro {
    max-width: 70ch;
    margin: calc(var(--tsoi-spacing-unit) * 2) 0 0;
    font: var(--tsoi-text-deck);
    letter-spacing: var(--tsoi-text-deck-tracking);
    color: var(--tsoi-color-on-surface-variant);
  }

  /* ── product group header: subject left, freshness right ────────────── */
  .theme-group {
    margin-top: calc(var(--tsoi-spacing-unit) * 5);
    /* anchor landings clear the masthead comfortably */
    scroll-margin-top: calc(var(--tsoi-spacing-unit) * 3);
  }
  .theme-head {
    display: flex; align-items: baseline; gap: var(--tsoi-column-gutter);
    margin: 0;
    padding-bottom: var(--tsoi-spacing-unit);
    border-bottom: var(--tsoi-rule-column) solid var(--tsoi-color-outline);
  }
  .theme-label {
    font: var(--tsoi-text-byline); font-weight: 500; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--tsoi-color-on-surface-variant);
    white-space: nowrap;
  }
  .theme-head .hair { flex: 1; }
  .cadence {
    font: var(--tsoi-text-byline); letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--tsoi-color-on-surface-variant); white-space: nowrap;
  }

  /* ── the dashboard card: the big slot — but compact: a gateway needs to
     be recognisable, not persuasive, and the next product group must stay
     within reach ────────────────────────────────────────────────────────── */
  .gateway {
    display: grid;
    grid-template-columns: 0.7fr 1fr;
    margin-top: calc(var(--tsoi-spacing-unit) * 2.5);
    border: 1px solid var(--tsoi-color-outline);
    background: var(--tsoi-color-surface-container-low);
    text-decoration: none; color: inherit;
    transition: background 0.15s, border-color 0.15s;
  }
  .gateway:hover { background: var(--tsoi-color-surface-container-high); border-color: var(--tsoi-color-primary); }
  /* A product whose covers have not been captured yet runs full width; the
     card keeps its weight on the page instead of reserving an empty frame. */
  .gateway.no-cover { grid-template-columns: 1fr; }
  .gw-cover {
    display: block; overflow: hidden; aspect-ratio: 16 / 9;
    border-right: var(--tsoi-rule-column) solid var(--tsoi-color-outline);
    background: var(--tsoi-color-surface-container-low);
  }
  .gw-cover img { width: 100%; height: 100%; object-fit: cover; object-position: top left; display: block; }
  /* selectors carry the same parent chain as the base img rule so they win
     on specificity over `.gw-cover img { display: block }` */
  .gw-cover .t-dark { display: none; }
  :global(html[data-theme='dark']) .gw-cover .t-light { display: none; }
  :global(html[data-theme='dark']) .gw-cover .t-dark { display: block; }
  /* the two Inflation products' stand-in cover: the CPI index line itself,
     same drawing (vector-effect keeps a true 1.5px stroke through the
     non-uniform viewBox scaling) Inflation Peaks' terrain uses on the play
     rack. The time machine adds the two months a reader is comparing — a
     hollow pin for the earlier one, solid for the one it's read against,
     the same pairing the game format's own mark uses for guess vs actual. */
  .gw-motif { display: block; width: 100%; height: 100%; }
  .gw-motif polyline {
    fill: none;
    stroke: var(--tsoi-color-primary);
    stroke-width: 1.5;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .gw-motif .pin-from {
    fill: var(--tsoi-color-surface-container-low);
    stroke: var(--tsoi-color-on-surface-variant);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .gw-motif .pin-to { fill: var(--tsoi-color-primary); }
  .gw-body {
    display: flex; flex-direction: column; justify-content: center;
    padding: calc(var(--tsoi-spacing-unit) * 2.5) calc(var(--tsoi-spacing-unit) * 3);
  }
  .gw-title {
    font: var(--tsoi-text-headline-lg);
    letter-spacing: var(--tsoi-text-headline-lg-tracking);
    line-height: 1.15;
  }
  .gateway:hover .gw-title { color: var(--tsoi-color-primary-text); }
  .gw-deck {
    max-width: 52ch;
    margin: var(--tsoi-spacing-unit) 0 0;
    font: var(--tsoi-text-body);
    color: var(--tsoi-color-on-surface-variant);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .go {
    margin-top: calc(var(--tsoi-spacing-unit) * 1.5);
    font: var(--tsoi-text-byline); font-weight: 500; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--tsoi-color-primary-text);
  }

  /* ── responsive ──────────────────────────────────────────────────────── */
  @media (max-width: 767px) {
    .gateway { grid-template-columns: 1fr; }
    .gw-cover {
      aspect-ratio: 16 / 9;
      border-right: none;
      border-bottom: var(--tsoi-rule-column) solid var(--tsoi-color-outline);
    }
    .gw-body { padding: calc(var(--tsoi-spacing-unit) * 2.5); }
  }
</style>
