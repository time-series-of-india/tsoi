---
// The dispatch front page, in its SUPPLEMENT-DAY configuration (15 Aug 2026).
// TSOI ships in thematic releases; each one is a numbered dispatch
// (src/lib/dispatches.ts). On an ordinary day this page presents the latest
// like a Sunday paper's front page — edition line, lead story, secondary
// cards, previous dispatches as a compact stack. Today the front belongs to
// the Independence Day supplement: it takes the lead position, and EVERY
// dispatch — the current one included — compacts to the stack's card, each
// self-identified by its own edition kicker, no "previous" label needed. The
// full binding (lead story, boards, the game card) lives in git for the day
// this configuration is retired.
import StoryPage from '../layouts/StoryPage.astro';
import FormatMotif from '../components/editorial/FormatMotif.astro';
import { DISPATCH_LIST } from '../lib/dispatches';
import { THEME_LABELS } from '../lib/themes';

const [latest] = DISPATCH_LIST;

const editionMonth = (iso: string) =>
  new Date(`${iso}T00:00:00`).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });

---

<StoryPage
  homeH1
  title="Time Series of India"
  description={`India's official public data, translated into charted reads, swipeable decks and live dashboards — released as numbered dispatches. Latest: ${THEME_LABELS[latest.theme]}.`}
>
  <!-- ── the Independence Day supplement ───────────────────────────────── -->
  <!-- A newspaper runs a supplement above the day's edition line on the
       morning it belongs to, and this is that: one card, above the current
       dispatch, and it is not part of it. It carries no edition number, no
       format row and no manifest, because it is not a dispatch item — the
       dispatch below is still Dispatch No. 2 and says so.

       IT IS THE ONLY FULL-BLEED IMAGE CARD ON THIS PAGE, and the backdrop is
       the film's own 1947 midnight: the sky's three stops, the dawn glow low
       and right of centre, two ridge bands, the landmass, the saffron rim light
       on top of it, and the walker standing on that line MID-STRIDE — the real
       figure, drawn by the engine's own drawWalker out of a live frame of the
       film rather than redrawn as a picture of him (see the note on the asset
       below). The line under him is the piece's own arc: a long shallow
       decline, a trough, and a climb at the right edge.

       The type is real DOM over it rather than baked into it — the kicker and
       the two-line lockup — so it is selectable, translatable, and legible to
       a reader who never loads the image.

       MYSTERY RULE. Nothing here names the series. The picture is a landscape
       with a figure on it; "Midnight" is Nehru's; and the standfirst is the
       page's own, which has been held to this rule since R1.

       Front page only. It is deliberately NOT added to any section index: a
       supplement runs once, on the front, on the day. -->
  <section class="supplement-block">
    <!-- The dateline stands ABOVE the frame, exactly where a dispatch's own
         edition line stands above its binding: it names the object, and the
         card below is free to be all picture. (It also puts real height
         between this card's title and the first dispatch card's, which used
         to share one glance in the viewport.) -->
    <p class="supplement-label">
      Independence Day Supplement &middot; 15 August 2026
    </p>
    <a class="supplement" href="/independence">
      <img class="supplement-bg" src="/independence/supplement.jpg" alt="" loading="eager" />
      <span class="supplement-ink">
        <span class="supplement-lockup">
          <span class="supplement-line1">The Walk</span>
          <span class="supplement-line2">through Midnight</span>
        </span>
        <span class="supplement-deck">Walk four and a quarter centuries of India, from Akbar&rsquo;s court to now.</span>
      </span>
    </a>
  </section>

  <!-- ── the dispatches, every one the same compact card ───────────────── -->
  <!-- Supplement-day configuration: the current dispatch folds into the same
       stack card the previous ones wear, each self-named by its edition
       kicker, so no "Previous dispatches" label is needed and nothing below
       the supplement competes with it for the lead. Format is carried by each
       item's motif — the house's wordless format language — never by a text
       badge. The full current-dispatch binding is in git, pre-supplement. -->
  <section class="stack">
    {DISPATCH_LIST.map((d) => {
      const cover = d.items.find((it) => it.thumb);
      return (
      <article class:list={['stack-card', { 'has-cover': !!cover }]}>
        {cover && (
          <a class="stack-cover" href={cover.href} aria-label={cover.title}>
            <img class="t-light" src={`${cover.thumb}.png`} alt="" loading="lazy" />
            <img class="t-dark" src={`${cover.thumb}-dark.png`} alt="" loading="lazy" />
          </a>
        )}
        <div class="stack-head">
          <span class="stack-kicker">Dispatch No. {d.edition} &middot; {editionMonth(d.date)}</span>
          <span class="stack-theme">{THEME_LABELS[d.theme]}</span>
        </div>
        <ul class="stack-items">
          {d.items.map((it) => (
            <li>
              <a href={it.href}>
                <FormatMotif format={it.format} variant={it.motif} meta={it.meta} />
                <span class="stack-title">{it.title}</span>
                <span class="stack-arrow" aria-hidden="true">&rarr;</span>
              </a>
            </li>
          ))}
        </ul>
      </article>
      );
    })}
  </section>
</StoryPage>

<style>
  /* ── the Independence Day supplement ──────────────────────────────────── */
  /* The front page's card grammar, kept: the same hairline in the outline
     token, the same 4px saffron rule down the left edge that marks the current
     dispatch below it, no icon, and no elevation — the card sits ON the page
     rather than over it. What it does not share is the paper: this one is a
     picture, and the picture is the film.

     The BACKDROP is a baked still (public/independence/supplement.jpg,
     generated from a live frame of the film — the sky, the ridges, the rim
     line and the engine's own walker) and everything readable on it is DOM
     text laid over the top. It is not a background-image: an <img> is what
     `object-fit: cover` is for, it is what a browser preloads, and it is the
     one element on this card that has an intrinsic size to reason about.

     RESPONSIVE, and the picture is composed for it: the walker stands at the
     exact centre of the still and the ground line runs its full width, so a
     `cover` crop at ANY column width keeps both — the crop eats sky and the
     ends of the line, which is what the composition has spare. The card's
     aspect ratio opens up as the column narrows, so the two authored lines of
     the title never have to share a row with him. */
  .supplement-block {
    margin-bottom: calc(var(--tsoi-spacing-unit) * 4);
  }

  /* The supplement's dateline, standing above the frame the way a dispatch's
     edition line stands above its binding: same caps voice, same saffron-as-
     text ink, centred. On the paper, not on the picture — which is also what
     frees the picture's own type to be nothing but the title. */
  .supplement-label {
    margin: 0 0 calc(var(--tsoi-spacing-unit) * 1.25);
    text-align: center;
    font: var(--tsoi-text-label-caps);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tsoi-color-primary-text);
  }

  .supplement {
    position: relative;
    display: block;
    border: var(--tsoi-rule-column) solid var(--tsoi-color-outline);
    border-left: 4px solid var(--tsoi-color-primary);
    /* Under the ink, so the card is the right colour for the half-second
       before the still decodes and for the reader who never gets it. */
    background: #12151f;
    /* The still is 1600x800 — exactly 2:1 — and the card is a hair wider than
       that, so `cover` takes a shallow slice off the top and bottom and leaves
       the walker and the whole of the ground line in frame at very close to the
       scale they were composed at. (16/11 was tried first and is the mistake
       this replaces: a 1.45 box cropping a 2.0 picture has to scale it up by
       half again to fill, which blew the figure up to twice his composed size
       and made the card 847px tall on the front page.) */
    aspect-ratio: 12 / 5;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
  }

  .supplement-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* The still's own subject is dead centre and its ground line runs edge to
       edge, so a centred crop is the composed one at every width. */
    object-position: 50% 50%;
  }

  /* The type is CENTRED over the sky, which is the part of the frame the
     zoomed-out composition keeps clear: the walker is small and low, the
     ground line runs the lower third, and the dawn glow is on the horizon.
     Nothing overlaps him at any width. (The dateline that used to open this
     block now stands above the card's border — see .supplement-label.) */
  .supplement-ink {
    position: relative;
    display: block;
    padding: calc(var(--tsoi-spacing-unit) * 2.75) calc(var(--tsoi-spacing-unit) * 2);
    text-align: center;
  }

  /* The lockup, and it is MIXED VOICE on purpose. "The Walk" is the masthead's
     own face — Playfair Display 900, upright — because it is the name of the
     thing and names are set in the publication's face. "through Midnight" is
     the film's serif italic, which is the face every word inside the film is
     set in, so the second line is spoken in the piece's own voice rather than
     in the paper's. One title, two registers, and the break between them is
     where the reader crosses from the front page into the film. */
  .supplement-lockup {
    display: block;
    margin-top: calc(var(--tsoi-spacing-unit) * 1.5);
    /* Cream rather than white, and the glow is the film's own text halo: a
       warm bloom rather than a drop shadow, because the sky behind it is lit
       from below and a grey shadow would read as a sticker on the picture. */
    color: #f4ece0;
    text-shadow:
      0 0 12px rgba(255, 170, 110, 0.28),
      0 0 34px rgba(255, 150, 70, 0.18);
  }

  .supplement-line1,
  .supplement-line2 {
    display: block;
    /* Two authored lines and never three: the measure is set by the longer of
       them, and nothing in it is allowed to wrap. Release-day device pass:
       a little more air between the two lines than a display face's usual
       set-solid. */
    white-space: nowrap;
    line-height: 1.16;
  }

  .supplement-line1 {
    font-family: var(--tsoi-font-headline);
    font-weight: 900;
    font-size: clamp(30px, 5.6vw, 54px);
    letter-spacing: -0.015em;
  }

  .supplement-line2 {
    /* The film declares --walk-serif on its own wrapper; this card is nowhere
       near it, so the stack is repeated here rather than reached for. */
    font-family: Georgia, 'Times New Roman', 'Noto Serif', serif;
    font-style: italic;
    font-weight: 400;
    /* A step further below line1 than the film's own poster ratio: at card
       size the two lines read as one title, and the italic riding nearly as
       large as the roman above it made them compete. */
    font-size: clamp(21px, 3.8vw, 37px);
    letter-spacing: 0.005em;
  }

  /* The film's serif rather than the site's byline face, which is mono: this
     line stands under a Playfair/Georgia lockup on the film's own sky, and a
     monospaced deck there reads as a caption that wandered in from a chart. */
  .supplement-deck {
    display: block;
    margin-top: calc(var(--tsoi-spacing-unit) * 1.25);
    font-family: Georgia, 'Times New Roman', 'Noto Serif', serif;
    font-size: clamp(12px, 1vw, 13.5px);
    line-height: 1.5;
    color: rgba(244, 236, 224, 0.8);
    /* Wide enough for the sentence to sit on one line where there is room, and
       balanced where there is not, so it never breaks one word onto a row of
       its own under the lockup. Auto margins keep the measure on the centre
       axis the whole block now sits on. */
    max-width: 48ch;
    margin-inline: auto;
    text-wrap: balance;
  }

  /* Same hover grammar as the cards below it — a change of state, not a lift.
     The card has no elevation to raise. */
  .supplement:hover .supplement-bg {
    transform: scale(1.012);
  }

  .supplement-bg {
    transition: transform 0.4s ease;
  }

  .supplement:focus-visible {
    outline: 2px solid var(--tsoi-color-primary);
    outline-offset: 2px;
  }

  /* A narrow column gets a taller card, so the lockup keeps its own room and
     the walker stays in frame under it rather than behind the words. */
  @media (max-width: 640px) {
    .supplement {
      aspect-ratio: 5 / 6;
    }

    .supplement-ink {
      padding: calc(var(--tsoi-spacing-unit) * 1.75) calc(var(--tsoi-spacing-unit) * 1.75);
    }

    .supplement-bg {
      /* Pull the crop DOWN as the frame gets tall: the sky above his head is
         the part the type is standing on, and the line under him is the part
         that must not be cropped away. */
      object-position: 50% 78%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .supplement-bg {
      transition: none;
    }

    .supplement:hover .supplement-bg {
      transform: none;
    }
  }

  /* ── the dispatch frame: same anatomy as a stack card, rendered large ──── */
  .dispatch {
    padding: calc(var(--tsoi-spacing-unit) * 3) calc(var(--tsoi-spacing-unit) * 3.5)
      calc(var(--tsoi-spacing-unit) * 3.5);
    border: var(--tsoi-rule-column) solid var(--tsoi-color-outline);
    border-left: 4px solid var(--tsoi-color-primary);
  }

  /* ── edition head ─────────────────────────────────────────────────────── */
  .edition-head {
    text-align: center;
    padding-bottom: calc(var(--tsoi-spacing-unit) * 1.75);
    border-bottom: var(--tsoi-rule-section) solid var(--tsoi-color-on-surface);
  }
  .edition-line {
    margin: 0;
    font: var(--tsoi-text-label-caps);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tsoi-color-primary-text);
  }
  /* the manifest: the dispatch declares its contents at zero scroll */
  .edition-manifest {
    margin: 6px 0 0;
    font: var(--tsoi-text-byline); letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--tsoi-color-on-surface-variant);
  }

  /* ── lead story ───────────────────────────────────────────────────────── */
  .lead {
    display: grid;
    /* the cover column is sized to the picture, not the other way round: the
       capture is portrait (720×824), so at 360px tall it wants ~315px of
       width and no more. A wider column just parks empty surface beside it. */
    grid-template-columns: minmax(0, 0.36fr) 1fr;
    margin-top: calc(var(--tsoi-spacing-unit) * 2.25);
    /* no border-left here: the .dispatch frame around this whole section
       already carries the identical 4px saffron rule, so the lead doesn't
       repeat the "current dispatch" mark — one draw of it is enough. */
    background: var(--tsoi-color-surface-container-low);
    text-decoration: none;
    color: inherit;
    transition: background 0.15s;
  }
  .lead:hover { background: var(--tsoi-color-surface-container-high); }
  /* no cover at all (thumb-less, motif-less) — same guard DashCard and the
     explore gateway use, so a bare lead never strands the text column in a
     0.36fr slot with nothing to fill the rest of the row */
  .lead:not(:has(.cover)) { grid-template-columns: 1fr; }
  .lead .cover {
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
    padding: calc(var(--tsoi-spacing-unit) * 2.5) 0;
    background: var(--tsoi-color-surface-container-low);
    border-right: var(--tsoi-rule-column) solid var(--tsoi-color-outline);
  }
  /* 320px: the cover is a DIAGRAM, and a diagram that can't be read is just a
     texture — so this is capped well above the ~250px floor where the step
     labels ("name & amount", "the part you never see") go to mush. It trades
     a bit of the size headroom 360px had (the capture is 720×824, so 360 was
     close to its native 2× size) for a tighter banner: the lead's right
     column only fills about half the banner's height at 1440px, leaving wide
     empty bands beside the text, and 320 slims the whole banner down without
     getting near the legibility floor. The height it costs is bought back by
     the fold rule below: the lead may own the first screen, never more. */
  .lead .cover img {
    width: auto; max-width: 100%; height: 100%; max-height: 320px;
    object-fit: contain; display: block;
  }
  /* theme-swapped thumbnails: both ship; CSS picks one (see economy/index). */
  .lead .cover .t-dark { display: none; }
  :global(html[data-theme='dark']) .lead .cover .t-light { display: none; }
  :global(html[data-theme='dark']) .lead .cover .t-dark { display: block; }

  /* the read's stand-in cover, before its thumbs are captured: a rising line
     drawn from the read's own headline index (lib/reads/motif.ts), plus a
     muted baseline so it reads as a chart rather than a stray mark. */
  .read-motif {
    display: block;
    width: 100%;
    max-width: 280px;
    height: auto;
  }
  .read-motif .baseline { stroke: var(--tsoi-color-outline); }
  .read-motif polyline {
    fill: none;
    stroke: var(--tsoi-color-primary);
    stroke-width: 1.5;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .lead-body {
    display: flex; flex-direction: column; justify-content: center;
    padding: calc(var(--tsoi-spacing-unit) * 2) calc(var(--tsoi-spacing-unit) * 3.5);
  }
  .tag {
    font: var(--tsoi-text-byline); font-weight: 500; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--tsoi-color-primary-text);
  }
  .lead-title {
    margin: calc(var(--tsoi-spacing-unit) * 1.25) 0 0;
    font: var(--tsoi-text-headline-xl);
    letter-spacing: var(--tsoi-text-headline-xl-tracking);
  }
  .lead:hover .lead-title { color: var(--tsoi-color-primary-text); }
  .lead-deck {
    max-width: 64ch;
    margin: calc(var(--tsoi-spacing-unit) * 1.25) 0 0;
    font: var(--tsoi-text-deck);
    letter-spacing: var(--tsoi-text-deck-tracking);
    color: var(--tsoi-color-on-surface-variant);
    /* three lines is the pitch; past that the lead starts eating the row
       below it, which is the one thing the fold rule forbids */
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .lead-cta {
    margin: calc(var(--tsoi-spacing-unit) * 1.75) 0 0;
    font: var(--tsoi-text-byline); font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--tsoi-color-primary-text);
  }
  .lead-cta span { display: inline-block; transition: transform 0.15s; }
  .lead:hover .lead-cta span { transform: translateX(3px); }

  /* ── secondary cards ──────────────────────────────────────────────────── */
  .list-label {
    margin: calc(var(--tsoi-spacing-unit) * 2) 0 calc(var(--tsoi-spacing-unit) * 1.25);
    font: var(--tsoi-text-byline); letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--tsoi-color-on-surface-variant);
  }
  .stack > .list-label { margin-top: calc(var(--tsoi-spacing-unit) * 5); }
  /* Second row of the dispatch: the narrow column stacks the game and any
     remaining boards; the lead dashboard stands alone in the wide one.
     Geometry serves the dispatch, never the reverse: a dispatch without a
     game falls back to a plain grid of wide cards (.no-game). */
  .item-row {
    display: grid;
    /* 0.62/1.38: the dashboard is the data centerpiece and size is
       hierarchy, so it takes emphatically the wider column. The old
       0.75/1.25 split — with BOTH boards stacked in the wide column — left
       the game's column mostly empty below the game card; now that the
       narrow column carries two cards it can be genuinely narrow. The 320px
       floor is the boards': below it a stacked board's cover strip plus its
       two-line blurb start crowding. The game card gives up its fixed
       560/442 ratio here (rule below), so the old 400px ratio-driven floor
       no longer applies. */
    grid-template-columns: minmax(320px, 0.62fr) minmax(0, 1.38fr);
    gap: calc(var(--tsoi-spacing-unit) * 3);
    /* start, not stretch: each card keeps its own content height; the two
       columns' depths differ and that is fine — the row's bottom edge is
       whichever column runs deeper. */
    align-items: start;
  }
  /* Content height, not the 560/442 ratio: in a 0.62fr column the ratio
     yields less height than the card's own content needs, so holding it
     would only force the column back to the width it just gave up. Same
     relief the tablet tier below and the shared component's ≤600px rule
     have always used. */
  .side-col :global(.game-card) { aspect-ratio: auto; max-width: none; }
  /* the narrow column costs the pitch its second-line fit; two clamped lines
     here cut "…a long way down." at the payoff word, and a card that is
     content-height anyway has the room to keep it */
  .side-col :global(.gc-body) { -webkit-line-clamp: 3; }
  .item-col {
    display: flex; flex-direction: column;
    gap: calc(var(--tsoi-spacing-unit) * 3);
    min-width: 0;
  }
  /* Flat, equal-weight cards on the front page. The lead read is a plain
     filled card with no outer edge, and here the game and dashboard match it:
     the game drops its full outline box (it read heavy and boxy beside the
     borderless read) and both drop their own saffron seam. The one saffron
     "current dispatch" mark this section carries is the .dispatch frame's
     left rule, drawn once — repeating it per card is the weight-asymmetry
     between sibling formats the card design language rules out. Scoped to the
     front page on purpose: the shared components keep their edges where they
     stand alone (GameCard on the Play rack, DashCard nowhere else yet). */
  .item-row :global(.game-card) { border: none; }
  .item-row :global(.dash-card) { border-left: none; }
  /* The dashboard wears its screenshot across the top here, not in DashCard's
     default side strip: a landscape shot in a narrow side slot is cropped to
     a vertical slice through the panels and reads as a rendering fault.
     No aspect-ratio and `height: auto` — the image is shown WHOLE at its own
     proportion (the capture is ~2.12:1: desk bar, the three stat tiles, and
     both chart panels), so nothing is cut and nothing has to be re-tuned here
     if build-dashboard-thumbs.mjs ever reframes the capture. */
  .item-col :global(.dash-card) { grid-template-columns: minmax(0, 1fr); }
  .item-col :global(.da-cover) {
    aspect-ratio: auto;
    border-right: none;
    border-bottom: var(--tsoi-rule-column) solid var(--tsoi-color-outline);
  }
  .item-col :global(.da-cover img) { height: auto; }
  /* the two Inflation explore items' stand-in covers, before their
     screenshots are captured — same sizing rule the real screenshots get. */
  .item-col .board-motif,
  .item-col .rtm-motif { display: block; width: 100%; height: auto; aspect-ratio: 300 / 141; }
  .board-motif polyline,
  .rtm-motif polyline {
    fill: none;
    stroke: var(--tsoi-color-primary);
    stroke-width: 1.5;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  /* the time machine's two compared months — hollow for the earlier one,
     solid for the one it's read against, the same pairing the game format's
     own mark uses for guess vs actual */
  .rtm-motif .pin-from {
    fill: var(--tsoi-color-surface-container-low);
    stroke: var(--tsoi-color-on-surface-variant);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .rtm-motif .pin-to { fill: var(--tsoi-color-primary); }
  .item-row.no-game { grid-template-columns: 1fr; }
  .item-row.no-game .item-col { display: grid; grid-template-columns: repeat(2, 1fr); }
  /* format marks (FormatMotif) — spacing/colour is contextual */
  .lead-body :global(.motif) { margin-top: calc(var(--tsoi-spacing-unit) * 1.25); }

  /* Inflation Peaks' terrain — identical rules to the Play rack's own
     .peaks-cover (economy/play.astro), which carries the reasoning for the
     margin; duplicated because Astro scopes styles per file and this svg is
     written here, not there. This column is the tight one: at tablet width
     the card has no slack left, so the cover sits flush under the pitch and
     the headroom is the only thing keeping the auto out of the text. */
  .peaks-cover { position: relative; display: block; margin-top: 20px; }
  .peaks-motif { display: block; width: 100%; height: 58px; overflow: visible; }
  .peaks-motif polyline {
    fill: none;
    stroke: var(--tsoi-color-primary);
    stroke-width: 1.5;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  /* the auto itself carries its own styles (components/play/PeaksAuto.astro) */

  /* ── previous dispatches (the stack): compact cards, muted accents ────── */
  .stack-card {
    display: grid;
