---
import StoryPage from '../layouts/StoryPage.astro';
import PublicationCatalogue from '../components/editorial/PublicationCatalogue.astro';
import EmailSignup from '../components/editorial/EmailSignup.astro';
import WeatherWingsCard from '../components/editorial/WeatherWingsCard.astro';
import { popularPublications } from '../lib/publications';
---

<StoryPage homeH1 hideFooterNewsletter og_image="/og/play/weather-wings.png" title="Time Series of India" description="India’s public data through individual reads, games, tools and visual stories.">
  <section class="lead" aria-label="Selected publication">
    <WeatherWingsCard />
  </section>
  <PublicationCatalogue heading="More from TSOI" pieces={popularPublications} sortable collapsible />
  <div id="newsletter" class="newsletter-strip">
    <EmailSignup strip heading="Follow India through data" blurb="Get new stories, games and interactive tools from TSOI in your inbox." />
  </div>
</StoryPage>

<style>
  /* Full-width lead for now. The puzzle box (components/editorial/PuzzleBox.astro)
     returns beside it, 70/30, once a current puzzle is published. */
  .lead { min-width:0; }
  .newsletter-strip { margin-top:calc(var(--tsoi-spacing-unit) * 5); scroll-margin-top:calc(var(--tsoi-spacing-unit) * 3); }
</style>
