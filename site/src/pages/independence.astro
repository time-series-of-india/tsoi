</style>

<script>
  import { initWalk } from '../lib/independence/walk';

  // R2b through R2d measured what was above the stage on every resize —
  // --walk-lead (the masthead's height) and --walk-head (the distance from the
  // top of the document to the top of the stage) — because the stage was a
  // full-bleed band sized against the viewport it had to fit inside. R2e's stage
  // is a framed deck in the page column at a flat 58dvh under a 660px ceiling,
  // so it needs to know nothing about what is above it and there is nothing left
  // for a script to measure. Both custom properties, the resize listener and the
  // fonts.ready re-measure went with the band; the only thing this page's script
  // does now is mount the walk.
  const stage = document.querySelector<HTMLElement>('.walk-stage');
  if (stage) initWalk(stage);
</script>
