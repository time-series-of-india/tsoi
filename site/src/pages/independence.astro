  /* The fold. The summary row is the heading plus a quiet caps word on the
     same baseline; the word is the whole affordance (no marker, no icon —
     the piece has none). Inside the open state the heading keeps exactly the
     margin it had when it stood alone, so opening the fold reflows nothing
     above it. */
  .refs-fold summary {
    display: flex;
    align-items: baseline;
    gap: calc(var(--tsoi-spacing-unit) * 1.5);
    cursor: pointer;
    list-style: none;
