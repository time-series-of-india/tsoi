  .door-line {
    font: var(--tsoi-text-byline);
    letter-spacing: var(--tsoi-text-byline-tracking);
    color: var(--tsoi-color-on-surface-variant);
  }

  /* ------------------------------------------------- tablet and mobile --- */
  /* Designed rather than inherited: Independence Day traffic arrives on
     phones. The rail becomes a pinned horizontal strip, the explainer moves
     above its chart, and the charts get shorter. */

  @media (max-width: 1023px) {
    .explorer {
      display: block;
    }

    .rail {
      position: sticky;
      top: 0;
      z-index: 5;
      padding-inline-end: 0;
      margin-bottom: calc(var(--tsoi-spacing-unit) * 3);
      background: var(--tsoi-color-background);
      border-bottom: var(--tsoi-rule-column) solid var(--tsoi-color-outline);
