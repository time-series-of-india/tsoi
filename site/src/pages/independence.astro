</style>

<script>
  import { initIndependenceCharts } from '../lib/independence/charts';

  initIndependenceCharts();

  // Scrollspy for the rail. The active panel drives both the rail state and the
  // address bar, so a reader can copy the URL at any point and land back on the
  // panel they were reading.
  const items = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('[data-rail]').forEach((a) => {
    const key = a.dataset.rail;
    if (key) items.set(key, a);
  });
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.panel'));

  if (items.size && panels.length && 'IntersectionObserver' in window) {
    let active = '';

    const setActive = (id: string) => {
      if (id === active) return;
      active = id;
      for (const [key, a] of items) a.classList.toggle('is-active', key === id);

      // Mobile strip: bring the active item into view HORIZONTALLY only.
      // scrollIntoView would also scroll the page vertically and fight the
      // reader, so the strip is scrolled directly instead.
      const a = items.get(id);
      const strip = a?.parentElement?.parentElement;
      if (a && strip && strip.scrollWidth > strip.clientWidth + 1) {
        strip.scrollTo({
          left: Math.max(0, a.offsetLeft - (strip.clientWidth - a.offsetWidth) / 2),
          behavior: 'smooth',
        });
      }

      history.replaceState(null, '', `#${id}`);
    };

    const visible = new Set<string>();
    const spy = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const id = (e.target as HTMLElement).id;
          if (e.isIntersecting) visible.add(id);
          else visible.delete(id);
        }
        const first = panels.find((p) => visible.has(p.id));
        if (first) setActive(first.id);
      },
      { rootMargin: '-30% 0px -55% 0px' },
    );
    for (const p of panels) spy.observe(p);

    // Landing on a deep link: the browser jumps for us, but the rail has to be
    // told before the first intersection callback arrives.
    const hash = location.hash.slice(1);
    if (hash && items.has(hash)) {
      setActive(hash);
      document.getElementById(hash)?.scrollIntoView();
    }
  }
</script>
