---
// Inflation Peaks — the page furniture around the canvas. Everything that
// moves lives in src/lib/play/peaks-engine.ts; this file is the frame: the
// same folio / masthead / sources-line editorial chrome the other play page
// wears, plus the two overlay cards (start, run over) which are ordinary
// site cards sitting on top of the canvas rather than anything drawn into it.
//
// The terrain is the real series now, so the page says real months. What used
// to be "Month 84" is an actual date, the axis carries actual years, and the
// sources line is the one the generator wrote from the splice it performed.
import StoryPage from '../../layouts/StoryPage.astro';
import ShareButtons from '../editorial/ShareButtons.astro';
import {
  INFLATION_PEAKS_DECK,
  INFLATION_PEAKS_KICKER,
  INFLATION_PEAKS_TITLE,
} from '../../lib/play/inflation-peaks';
import type { TerrainAnnotation, TerrainEra, TerrainPoint } from '../../lib/play/peaks-engine';
import { SPARK_H, SPARK_W, sparkPath } from '../../lib/play/peaks-spark';

interface Props {
  /** Content-hashed URL of the generated terrain, fetched at run time. */
  src: string;
  /** The generated sources line. It ships in the markup rather than arriving
   *  with the fetch because it is a disclosure about the data, and a
   *  disclosure that appears a moment after the thing it qualifies is worth
   *  less than one that was always there. */
  sources: string;
  /** The six eras, from the same generated file. Rendered server-side so the
   *  rack, the notes and the scorecard are real markup: they read and they
   *  are there before the terrain finishes downloading. */
  eras: TerrainEra[];
  /** The flagged months, for the notes on each stretch. */
  annotations: TerrainAnnotation[];
  /** The whole spine. Used at build time only, to draw the sparkline on each
   *  cartridge; the browser gets the same points through the fetch. */
  points: TerrainPoint[];
}

const { src, sources, eras, annotations, points } = Astro.props;

/* Newest first, everywhere the six are listed: the select, the rack, the
   basket on the cleared card, and the components table that reads in the
   rack's order.

   Time is still the axis — it just runs the other way, and the reason is that
   this is a menu before it is a chronology. Inflation has broadly calmed down
   over the six decades, so newest-first is roughly easiest-first: the 2020s
   at the top of the rack are the training ground, and the seventies at the
   bottom are the wall. A first-time player reads down a list from the top,
   and the top should not be 34.7% in 1974. It also puts the cartridge that
   arrives loaded in the machine first in the rack it came from.

   Roughly, not exactly, and the interface does not claim otherwise: the
   nineties are harder than the eighties that precede them. What each card
   shows is its own shape, drawn on the scale all six share, which is the
   honest way to let a player judge before picking.

   Weight decides nothing here either, though it no longer disagrees. It used
   to be mean absolute year-on-year, which ranked the eras by how far from
   zero they sat: the eighties took the second-largest weight in the basket
   for a decade of inflation pinned near nine, which is high flat ground, and
   flat is flat at any altitude. It is now how far the rate moved month to
   month, which is the same thing the terrain is made of, so the heavy
   stretches and the hard ones are broadly the same stretches. Broadly: the
   scorecard is still a scorecard and the rack still shows shapes. */
const rack = [...eras].sort((a, b) => (a.from < b.from ? 1 : -1));

/* The cartridge sparkline, drawn from the era's own months onto ONE vertical
   scale shared by all six. Scaling each card to its own range would make
   every era look equally dramatic, which is precisely backwards: the point of
   the rack is that you can see the seventies tower over inflation targeting
   before you pick either. */
const lo = Math.min(...points.map((p) => p.yoy));
const hi = Math.max(...points.map((p) => p.yoy));

const eraSpark = (e: TerrainEra): string =>
  sparkPath(points.filter((p) => p.ym >= e.from && p.ym <= e.to).map((p) => p.yoy), lo, hi);

const eventsFor = (e: TerrainEra) => annotations.filter((a) => a.era === e.id);
const pct = (w: number) => `${(w * 100).toFixed(1)}%`;
const years = (e: TerrainEra) => `${e.from.slice(0, 4)}–${e.to.slice(0, 4)}`;

/* The month form the slot bar's readout uses. The generated era carries
   fromLabel and toLabel in full — "January 2000 to December 2009" — which is
   right in the sources line and in prose, and too many letters for a caption
   sitting between a control and a switch. The chart's own axis has always used
   the short form; this is the same clock, so it reads the same way. Derived
   here rather than in the generator: the long labels are what the sentences
   below want. */
const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const shortMonth = (ym: string) => `${MON[+ym.slice(5) - 1]} ${ym.slice(0, 4)}`;

/* What is in the machine on arrival: the first cartridge in the rack, which
   is the newest stretch. It used to be the lightest by weight, on the
   reasoning that the lightest era was also the calmest ground. That held
   while weight was mean absolute level; under travel weighting the lightest
   is the 2000s, which is not the stretch the copy calls the place to learn
   the controls and is not the card the eye lands on first.

   Reading it off the rack settles both, and settles them permanently: the
   loaded cartridge is the first one you see, whatever the data does to the
   weights next time the generator runs. The script does not repeat this rule
   either — it reads the loaded cartridge back out of the markup, so there is
   one source of truth for it and not two. */
const loaded = rack[0];

/* The four reporting columns and what each one means, one sentence each.
   These used to be a definition list under the table with a worked example
   below it, which was the right content in the wrong place: a reader asks
   "what is this column" while looking at the column, and answering it four
   screens down meant scrolling away from the thing that raised the question.
   As tooltips on the headings they sit exactly where the question occurs, and
   the sixty lines of prose that carried them go.

   All four, not just the two that look arithmetic. Mode carries the
   multiplier and Contributes carries the reweighting; with the prose gone,
   dropping those two would leave the score with nothing anywhere on the page
   explaining how it is reached.

   One sentence each is the constraint, not a target. A tooltip that needs a
   paragraph is a tooltip standing in for a section, and the honest fix for
   that would be to bring the section back. */
const COLUMN_NOTES = [
  {
    label: 'Weight',
    info: 'How rough the stretch is, and so what it is worth: the average month-to-month move in the rate, scaled so the six sum to 100%.',
  },
  {
    label: 'Best run',
    info: 'Months driven, out of the months in the stretch. One run counts per stretch: the one that earned most, not the longest, so a short run on Hard can beat a longer one on Easy.',
  },
  {
    label: 'Mode',
    info: 'The mode that run was driven on. It multiplies what the run earned: Easy 0.6, Medium 1.0, Hard 1.4.',
  },
  /* Written to stand on its own, because on a phone it is the whole report:
     the narrow layout drops Best run and Mode to fit three columns, and the
     cartridge and the basket chips state both in words. A definition for a
     column you cannot see is not missing, but the mode multipliers would be,
     so they are spelled out here; "its weight" points at the Weight column,
     which sits beside this one at every width. */
  {
    label: 'Contributes',
    info: 'What the stretch puts in: the share you drove, times its mode (Easy 0.6, Medium 1.0, Hard 1.4), times its weight. The column sums to the index, so every row moves when a new stretch reports.',
  },
];
---

<StoryPage
  title={`${INFLATION_PEAKS_TITLE} — Time Series of India`}
  description={INFLATION_PEAKS_DECK}
  og_type="article"
  og_image="/og/play/inflation-peaks.png"
>
  <article class="peaks">
    <!-- folio, not a back button: states where the game lives, never where
         the reader came from (same convention as the read pages). -->
    <nav class="folio" aria-label="Section">
      <a href="/economy">Economy</a><span class="dot" aria-hidden="true">&middot;</span><a href="/economy/play">Play</a>
    </nav>

    <header class="masthead">
      {/* Share sits on the kicker line's right edge — the game has no reader
          controls, so the reads' toolbar would be a row holding one icon;
          this is the same 30px control in the masthead the deck's fab and
          the flagship's toolbar already taught. 'end' so the popover opens
          inward from the page edge. */}
      <div class="mast-top">
        <p class="kicker">{INFLATION_PEAKS_KICKER}</p>
        <ShareButtons title={INFLATION_PEAKS_TITLE} variant="icon" align="end" />
      </div>
      <h1>{INFLATION_PEAKS_TITLE}</h1>
      {/* Deliberately NOT the card's sentences, which is where this landed for
          a while. The card has to sell the game to somebody who has never seen
          it, so it spends its opening on the country and the span; the page has
          the title, the kicker and the machine itself already on screen, and
          repeating "India's inflation, 1969 to 2026" under a headline that
          says Inflation Peaks is a sentence the reader has just read.

          What the page needs instead is the rule of the thing. "The peaks are
          the peaks" is the whole claim in four words: the terrain is not
          scenery shaped to be fun, it is the series, and the hard part is hard
          because 1974 was. */}
      <p class="deck">
        The terrain is the inflation series. Every hill is a month of
        year-on-year inflation, the peaks are the peaks, and the only control
        you have is the throttle.
      </p>
    </header>

    {/* The machine: one ruled box holding the slot bar and the chart, so the
        thing you loaded a cartridge into is visibly one object rather than a
        control floating near a canvas. */}
    <div class="machine">
      <div class="slot">
        {/* The cartridge is switchable from here, so a player never has to
            scroll to the rack to change stretch. A native select rather than
            a custom popup: it is one element, it works with a keyboard and a
            screen reader for free, and on a phone it opens the platform's own
            picker. The sparkline sits beside it rather than inside it,
            because an option element cannot hold a drawing — all six are in
            the markup and five are hidden. */}
        <div class="slot-load">
          <span class="slot-tag">Loaded</span>
          <span class="slot-select">
            <select id="peaks-era-select" aria-label="Stretch">
              {rack.map((e) => (
                <option value={e.id} selected={e.id === loaded.id}>{e.label}</option>
              ))}
            </select>
          </span>
          {rack.map((e) => (
            <span class="slot-spark" data-slot-spark={e.id} hidden={e.id !== loaded.id}>
              <svg viewBox={`0 0 ${SPARK_W} ${SPARK_H}`} preserveAspectRatio="none" aria-hidden="true">
                <path class="spark-line" d={eraSpark(e)} fill="none" vector-effect="non-scaling-stroke" />
              </svg>
              {/* Where the run has reached, on the one drawing of the whole
                  stretch that is on screen while you drive. A span rather than
                  a circle in the svg above: that viewBox is stretched to the
                  slot's box, and a circle inside it comes out an egg. */}
              <span class="spark-dot" data-spark-dot hidden></span>
            </span>
          ))}
          {/* Where the run has got to, in months and in the month it actually
              is. This used to be the stretch's span — "Jan 2020 to Jun 2026" —
              which is a fact you need once, when you pick a cartridge, and
              which the notes below the machine state anyway. The position in
              it is a fact you want continuously, and it belongs beside the map
              that is showing you the same thing as a dot.

              Two spans rather than one string because the phone keeps only the
              count; rendered at the start line so the bar is right before any
              script runs. */}
          <span class="slot-span" id="peaks-slot-span">
            <span class="span-month" id="peaks-slot-month">{shortMonth(loaded.from)}</span
            ><span class="span-count" id="peaks-slot-count">0/{loaded.months - 1}</span>
          </span>
        </div>
        {/* Mode is a switch on the machine, not a peer of the rack. It says
            what it does to the terrain rather than naming three tiers of
            player, because it is a zoom and a speed, and the gridlines scale
            with it: Hard is the same series read on a taller axis. */}
        <div class="slot-mode">
          <span class="slot-tag" id="peaks-mode-label">Mode</span>
          <div class="modes" role="group" aria-labelledby="peaks-mode-label">
            <button class="mode" type="button" data-mode="easy" aria-pressed="false">Easy</button>
            <button class="mode" type="button" data-mode="medium" aria-pressed="true">Medium</button>
            <button class="mode" type="button" data-mode="hard" aria-pressed="false">Hard</button>
          </div>
        </div>
      </div>

    <div class="stage" id="peaks-stage">
      <canvas
        id="peaks-canvas"
        role="img"
        aria-label="Inflation terrain chart. The line is monthly year-on-year inflation; you drive a car across it."
      ></canvas>

      {/* The corner of the chart used to count the months, which the slot bar
          now does, beside the map they are a position on. What it carries
          instead is the figure the months are being spent on: your index.
          Static during a run, on purpose — it is what you are playing FOR, and
          the moment it moves is the moment a run beat the one it replaces. A
          step smaller than the month count it replaces, because the live
          number should be the loudest one on the machine and this is not it.

          The figure only, with no Provisional or Published beside it. The mark
          is a caveat about how the number was computed, which is a thing to
          read when you are reading the score; here the number is glanced at
          between hills, and a word explaining it is furniture over the chart.
          The scorecard carries it, where the basket that earns it is. */}
      <p class="hud" id="peaks-hud" hidden>
        <span class="hud-label">Index score</span>
        <span class="hud-value" id="peaks-hud-index"></span>
      </p>

      <!-- ?fps=1 turns this on; it is a build instrument, not furniture. -->
      <p class="fps" id="peaks-fps" hidden></p>

      {/* Nothing sits over the chart until a run ends. There used to be a
          card here explaining the game, shown before the first run and again
          after every cartridge change — an explanation you need once and a
          screen you dismiss forever after. The pedal states the control, the
          line under it states the rest, and the terrain is on screen from the
          moment the page loads. */}
      <div class="veil" id="peaks-veil" hidden>
        {/* Two parts, and the split is the point. The result, the note and
            the basket scroll; the action does not. The card is 401px of
            content in the 325px the chart leaves it whenever the run ends
            near a flagged month, and every version of this that let the whole
            card scroll put Retry off the bottom of it — on a laptop, not just
            on a phone. A sticky footer was tried once and was worse, because
            a positioned one overlays the last chip in the basket forever;
            this one is a flex row outside the scroller, so it reserves its
            own space and hides nothing. */}
        <div class="card" id="peaks-end">
          <div class="card-scroll" id="peaks-card-scroll">
            <p class="card-kicker" id="peaks-end-kicker">Run over</p>
            <h2 id="peaks-end-title">You crashed.</h2>
            <p class="score">
              <span id="peaks-end-months">0</span>
              <span class="score-unit">months survived</span>
              {/* The clock, on every run. It used to appear on clears only,
                  on the reasoning that a crash time is a slower way of saying
                  how far you got. It is now the board's tiebreaker at every
                  score, so hiding the number a player is ranked on would be
                  perverse. */}
              <span class="score-time" id="peaks-end-time" hidden></span>
            </p>
            {/* Where this run sits among every run filed on the same stretch,
                once enough of them have been. Set in the byline face like the
                event note below it: both are remarks about the run rather than
                part of the result. It is absent, not empty, whenever there is
                no figure to print — a stretch nobody else has driven, an
                endpoint that is down, a preview build with nowhere to ask.
                The stretch's runs are fetched when the run starts, so the line
                is on the card in the frame the card appears rather than
                landing on it a moment later. */}
            <p class="card-pct" id="peaks-end-pct" hidden></p>
            {/* The index, on the runs that moved it. The card used to say
                nothing about the score at all, which meant the run that
                completed a basket — the one run that brings an index into
                existence — answered by pointing at Hard. A player could drive
                all six stretches and never learn the figure existed.

                It is not on every card. A crash on a stretch you have already
                driven moves nothing, and a line repeating an unchanged number
                after every run is furniture. It appears when the index
                publishes, when a run moves it, and for as long as a published
                index has not been filed, which is the whole of the case for
                mentioning it. */}
            <p class="card-index" id="peaks-end-index" hidden></p>
            <p class="card-body" id="peaks-end-note"></p>
            {/* What was happening where you died, when the data has something
                to say about it. Set in the byline face rather than the body
                face: it is a note on the run, not part of the result. */}
            <p class="card-context" id="peaks-end-context" hidden></p>

            {/* The basket: six chips carrying their own progress, each one
                loading that stretch and putting you back at its start line.

                On a clear only. A crash wants one thing and the card should
                offer one thing, which is another go at the stretch you were
                already on; the basket there was a menu offered to somebody who
                had not asked for one, and it pushed Retry into a scroll. The
                cartridge select in the slot bar is two inches away and does
                the same job whenever it IS wanted. A clear is the opposite
                case: the run is over, there is nothing to try again, and what
                to drive next is the only question left. So that is the card
                the basket belongs to, and there it is the point of the card
                rather than a footnote under it. */}
            <div class="next" id="peaks-next" hidden>
              <p class="next-head" id="peaks-next-head">Your basket</p>
              <ul class="next-list">
                {rack.map((e) => (
                  <li>
                    <button class="next-item" type="button" data-next={e.id}>
                      <span class="next-name">{e.label}</span>
                      {/* The stretch's own shape, on the one vertical scale
                          every sparkline on this page shares, so the chip and
                          the cartridge in the rack are recognisably the same
                          object. A basket of six names asks you to remember
                          which decade was which; a basket of six shapes just
                          shows you. */}
                      <svg
                        class="next-spark"
                        viewBox={`0 0 ${SPARK_W} ${SPARK_H}`}
                        preserveAspectRatio="none"
                        aria-hidden="true"
                      >
                        <path class="spark-line" d={eraSpark(e)} fill="none" vector-effect="non-scaling-stroke" />
                      </svg>
                      <span class="next-prog" data-next-prog={e.id}>&mdash;</span>
                    </button>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          {/* Retry is the whole action on a crash and takes the saffron. On a
              clear it steps back to a quiet outline: the run it would repeat
              is one you have already finished, and the six chips above are
              what the card is asking. Same button, same handler, one class. */}
          <div class="actions">
            {/* The step up, once there is nothing left to clear. It names one
                stretch and one mode rather than announcing that Hard exists,
                because there is no such thing as having finished Medium: the
                index takes each era's best run at that run's mode credit, so a
                player who drove the seventies on Easy and the nineties on Hard
                is in exactly the same basket as one who drove all six the same
                way. What IS defined per era is headroom, 1.4 minus whatever
                its counted run earned, and that is what this offers. */}
                        <button class="btn-primary" id="peaks-step" type="button" hidden></button>
            <button class="btn-primary" id="peaks-retry" type="button">Retry</button>
            {/* Quiet on purpose: the card carries one measurement and one
                loud action (Retry, or the step up), and this is neither. It
                quotes the run that just ended — months, stretch, mode — as
                plain text, the same read-only mechanics OffByHowMuch's finale
                uses. No image, no card: that is explicitly deferred. Hidden
                until a run has actually ended, wired in boot() below. */}
            <button class="is-quiet" id="peaks-end-share" type="button" hidden>Share</button>
          </div>
        </div>
      </div>
    </div>

    {/* The machine used to carry its own score strip along this bottom edge,
        mirroring the bulletin. It has gone. The argument for it was that the
        bulletin is four screens down and a score you have to go looking for
        is not one you are playing for — which was true when the bulletin was
        four screens down. It is not any more: the drawers put the score two
        rules under the pedal, and the figure rides on the shut drawer's
        summary, so it reads without opening anything.

        What the strip cost was the one thing this page cannot spare. It added
        a row to the bottom of the machine, and on a 13-inch laptop that row
        is the difference between the pedal being on screen when a run ends
        and being just below the fold — so every replay began with a scroll to
        find the bar the page had just told you to hold. */}
    </div>

    {/* The throttle. It lives below the chart rather than on it so that the
        chart scrolls like any other part of the page: a finger landing on the
        canvas while scrolling past the game used to accelerate the rickshaw. */}
    <div class="pedal-wrap">
      {/* The key sits inside the sentence rather than after it, so the
          instruction reads as one phrase. On touch the keycap is hidden and
          HTML whitespace collapsing leaves "Hold to drive". */}
      {/* Two labels, switched by the disabled state rather than by script, so
          there is no moment where the bar is live and still says loading.
          Between page load and the terrain arriving there is nothing to drive
          on, and this is where the page says so — the card that used to say
          it has gone. */}
      <button class="pedal" id="peaks-pedal" type="button" disabled>
        <span class="pedal-wait" id="peaks-wait">Loading the series</span>
        <span class="pedal-label">Hold <span class="keycap">Space</span> to drive</span>
      </button>
    </div>

    <p class="controls">Release to coast. Space does the same thing as the bar.</p>

    {/* The rack. Six cartridges, newest first, each carrying its own stretch
        of the series drawn on the scale all six share — so the card tells you
        what you are about to drive before you drive it, and the wild one is
        obvious from across the page.

        Folded, and shut on arrival. The slot bar loads any of the six without
        it, which makes this the scenic route to a job already done in one
        control two inches under the chart; open, it put four screens of
        cartridge art between the pedal and the score. Shut, the page is the
        machine, the pedal and the scorecard, and the rack is there for the
        reader who wants to compare terrain before picking. */}
    <details class="rack drawer">
      <summary>
        <span class="drawer-title">
          <h2 id="peaks-rack-h">The rack</h2>
          <span class="drawer-hint drawer-mark">Six stretches to drive</span>
        </span>
      </summary>
      <div class="drawer-body">
        <p class="setup-note">
          Six stretches of the series. Pick one and it loads into the machine
          above. Every card is drawn to the same vertical scale, so their
          heights are comparable.
        </p>

        <ul class="carts">
          {rack.map((e) => (
            <li>
              <button class="cart" type="button" data-era={e.id} aria-pressed={e.id === loaded.id}>
                <svg class="cart-spark" viewBox={`0 0 ${SPARK_W} ${SPARK_H}`} preserveAspectRatio="none" aria-hidden="true">
                  <path class="spark-line" d={eraSpark(e)} fill="none" vector-effect="non-scaling-stroke" />
                </svg>
                <span class="cart-name">{e.label}</span>
                <span class="cart-meta">
                  <span>{years(e)}</span>
                  <span>{e.peak.toFixed(1)}% peak</span>
                </span>
                <span class="cart-best" data-cart-best={e.id}>Never driven</span>
              </button>
            </li>
          ))}
        </ul>
        {/* Notes on whatever is loaded, inside the same section as the rack
            rather than ruled off below it: picking a cartridge and reading
            about the one you picked is a single act, and a section rule between
            them said they were two. All six are in the markup and five are
            hidden, so this is right without waiting on a script and switching
            costs no reflow of anything else. */}
        <div class="notes" aria-live="polite">
          <h3>About this stretch</h3>
          {rack.map((e) => (
          <div class="note" data-notes={e.id} hidden={e.id !== loaded.id}>
            <p class="note-char">{e.character}</p>
            {/* Two facts about the terrain, and only facts about the terrain.
                Trough went because the peak is the one that says what driving
                this will be like, and weight went because it is not a terrain
                fact at all: it is how much the era counts toward the index,
                which the bulletin states in a column headed Weight, next to
                what that weight is doing. */}
            <ul class="stats">
              <li><span class="stat-v">{e.months}</span><span class="stat-k">Months</span></li>
              <li><span class="stat-v">{e.peak.toFixed(1)}%</span><span class="stat-k">Peak</span></li>
            </ul>
            {eventsFor(e).length > 0 && (
              <div class="events">
                <p class="events-head">What happened here</p>
                <ul>
                  {eventsFor(e).map((a) => (
                    <li>
                      <span class="ev-when">{a.label}</span>
                      <span class="ev-rate">{a.yoy.toFixed(1)}%</span>
                      <span class="ev-text">{a.text}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
          ))}
        </div>
      </div>
    </details>

    {/* The bulletin. CPI is a weighted average of its components and so is
        this, so it is set the way a release is: the components above, the
        headline figure here, and a publication rule that says when the figure
        is final rather than when it exists. */}
    {/* Folded on the same furniture as the rack, and shut like it. Shut used
        to be impossible here — a score nobody can see is not a score — and it
        stopped being impossible when the figure and its mark moved onto the
        summary. What folds is the working: coverage, the six components,
        their weights and what each one contributes. The score itself is
        always on screen.

        So the page is now the machine, the pedal, and two closed drawers
        above the sources, which fits a laptop without scrolling, and a reader
        who wants the arithmetic is one click from all of it. */}
    <details class="bulletin drawer">
      <summary>
        <span class="bulletin-head">
          {/* Named for what it is to the player. "Index" alone is accurate —
              it is weighted, it publishes on a rule, it is not a total — and
              it told a first-time reader nothing about whether it was a score
              or a price level. The word stays, because the whole section is
              built on it; "score" goes in front so nobody has to work that
              out. */}
          <span class="card-kicker">Your score</span>
          <h2 id="peaks-index-h" class="drawer-mark">Inflation Peaks index score</h2>
        </span>
        {/* The figure rides on the summary, not in the body, so a shut drawer
            still states the score and whether it is final. A drawer you have
            to open to find out what it says is a drawer nobody shuts. The
            working — coverage and the components — is what folds.

            A figure from the first run, marked provisional until the basket is
            complete. It used to be withheld entirely, on the argument that an
            index over four of six components is not a smaller index but a
            different one — which is true of the sum, and stops being true once
            the reported components are reweighted to themselves. So it is
            reweighted, which is what a statistical office does with a component
            it could not collect, and the number is on one scale from the first
            run to the last. What publication marks is that the basket is whole.

            Still nothing at all before the first run: an em dash at headline
            size reads as a stray rule and a zero reads as a score of zero. */}
        {/* The figure, then its standing and its share control on a second
            line under it. All three used to sit on one baseline with the
            button four screens down inside the drawer, which had it both ways:
            a row that was already a number plus a caveat, and a share nobody
            could reach without opening the working. Stacking buys the button a
            home beside the thing it shares and keeps the top line a figure. */}
        <span class="index-value" id="peaks-index-value" hidden>
          <span id="peaks-index"></span>
          <span class="index-meta">
            {/* Both states are printed, because the mark is the only thing on
                a shut drawer that says whether the figure can be quoted. It
                used to hide itself on publication, which left the best score
                the page can report as the one with no mark at all.

                And it explains itself, on the same dotted underline the column
                headings wear. "Provisional" is a word a reader can be expected
                to know and a rule they cannot: the page has one, and it is the
                whole reason the section is set as a release. One line each,
                rewritten per state by paintIndex. */}
            <span class="index-mark tip" id="peaks-index-mark" data-info="Publishes when all six stretches have reported.">Provisional</span>
            {/* Share, of the figure alone — text only, same read-only
                mechanics as the run-over card's. It quotes exactly what this
                drawer already says: the index, and (once the board has placed
                it) the rank line above the distribution, word for word. A
                provisional index shares as provisional rather than borrowing a
                rank it has not been placed for.

                Inside the summary, so it is there whether the working is open
                or shut — the score is always on screen and now so is the way
                to send it. A button inside a summary would toggle the drawer
                on its way up, so its handler stops the click (see wireShare's
                caller). */}
            <button class="index-share" id="peaks-index-share" type="button" hidden>Share</button>
          </span>
        </span>
      </summary>

      <div class="drawer-body">
        <p class="index-status is-headline" id="peaks-index-status">
          Drive a stretch and it reports here.
        </p>
        {/* The tiebreaker, and only once there is a tie to break: every era
            cleared, and the clock reading the runs the index is actually
            counting rather than the fastest ones on record. */}
        <p class="index-time" id="peaks-index-time" hidden></p>

        {/* The components, in the order the rack has them, with the column
            that matters last: what each era puts into the figure. It now puts
            in exactly that — the contribution is divided by the share of the
            basket that has reported before it is printed, so the column adds
            up to the headline and a total line can say so.

            It did not before. The cell held weight times credit and the
            headline divided the sum by coverage, so a table showing 49.8 sat
            under a figure of 87.3 and a column headed Contributes contributed
            nothing you could check. The reweighting was always there; it was
            happening between the table and the figure, where a reader cannot
            see it. Doing it per row moves one division into the open and buys
            the whole claim an index release makes about itself.

            The cost is that a row moves when OTHER rows report, since the
            share being divided by grows: clear the 2020s alone and it reads
            100.0, add the seventies and it reads 31.7. That is real — it is
            what a component's share of a growing basket does — and the total
            line is what makes it legible, because the thing that stays put is
            the sum.

            On screen from the first visit, with the two columns that are
            facts about the basket rather than facts about you — the component
            and its weight — already filled, and the three that report a run
            left empty. It used to be hidden until something reported, on the
            argument that a table of em dashes is a form and not a release.
            The argument was against the em dashes: a column of them says a
            value is missing six times over, where an empty cell says nothing
            at all and lets the weights be read as what they are, which is the
            basket you are being asked to fill. Blank throughout, then, for the
            same reason, whether it is the first visit or the fifth.

            The head row is not aria-hidden any more, because the labels now
            carry the definitions and something has to be able to reach
            them. */}
        <ul class="eras" id="peaks-eras">
          <li class="era-head">
            <span>Component</span
            >{COLUMN_NOTES.map((c) => (
              <span class="num"><span class="tip" data-info={c.info}>{c.label}</span></span>
            ))}
          </li>
          {/* The component name loads the component. The bulletin is where a
              player works out which stretch is worth driving next — it is the
              only place weight, best run and contribution sit in one row — and
              having decided, they had to scroll back up and find the same name
              in the rack or the select. The row already names the thing; the
              name may as well be the way to it.

              A button, not a span with a handler, or it is unreachable from a
              keyboard. Its affordance is the hover lift the rack and the
              basket chips already use, deliberately NOT the dotted underline:
              that is taken, by the four column headings above, and a dotted
              name in the first column would read as a fifth definition rather
              than as a control. */}
          {rack.map((e) => (
            <li class="era-row">
              <span class="era-name"><button class="era-load" type="button" data-load={e.id}>{e.label}</button></span>
              <span class="num">{pct(e.weight)}</span>
              <span class="num best" data-best={e.id}></span>
              <span class="num on-mode" data-on-mode={e.id}></span>
              <span class="num contrib" data-contrib={e.id}></span>
            </li>
          ))}
          {/* The sum line, on a rule, the way any table of parts closes. Both
              totals are honest sums of the column printed above them: the
              weights of all six, which is the whole basket by construction,
              and the contributions, which is the figure. Best run and mode do
              not total — there is no such thing as a total mode — so they are
              left empty rather than filled with a dash that means nothing. */}
          <li class="era-total">
            <span class="era-name">Total</span>
            <span class="num">{pct(rack.reduce((a, e) => a + e.weight, 0))}</span>
            <span class="num"></span>
            <span class="num"></span>
            <span class="num contrib" id="peaks-total-contrib"></span>
          </li>
        </ul>

        {/* Scores are kept where they are made, and this is where a reader
            asks. It is the only line of the old method block that survived the
            move to tooltips, because it is not a definition of a column: it is
            a fact about the table as a whole.

            The second sentence is the disclosure. Nothing is asked and nothing
            is pressed — a published index joins the distribution on its own —
            so this is the only place a reader is told it happens.

            It used to end "with no name attached", which was a scar from the
            leaderboard this replaced: it answered a question a first-time
            player has not asked, and by answering it, planted it. And the two
            sentences read as a contradiction because one word was doing two
            jobs. Your RUNS are what stay in the browser; the INDEX is the one
            figure that goes anywhere. Naming them separately is the whole
            fix. */}
        {/* How the figure is built, in two sentences, directly under the table
            that does the building.

            This was a tooltip on the figure for a while and it was the wrong
            instrument: a hover is for a word whose definition you have momentarily
            forgotten, not for the one piece of arithmetic the whole section
            exists to explain, and it made a reader hunt for an explanation
            with no affordance saying it was there. Here it is simply on the
            page, where the columns it refers to are visible.

            The second sentence is the one that earns the block. An index that
            FALLS after a run reads as a bug, and nothing on screen accounted
            for it: the figure is an average over the stretches that have
            reported, so a first weak run on a new stretch joins that average
            below it. Said once, plainly, rather than left to be inferred from
            the Contributes definition. */}
        <p class="setup-note index-method">
          <b>How it adds up.</b> Each stretch scores the share of it you drove,
          times its mode. The index is those scores averaged over the stretches
          that have reported, weighted by the Weight column, so a first weak run
          on a new stretch can pull it down.
        </p>

        <p class="setup-note">Your runs are kept in this browser. The published index goes up anonymously and joins the distribution below.</p>

        {/* One panel, one file, no names. There was a leaderboard here for a
            while — a top ten with four-character initials, the arcade cabinet
            move — and it was the wrong artifact for this game. Four characters
            are not an identity, two players can both be PG and the page had to
            match your own row on the alias AND the figure to find you. A top
            ten needs a crowd behind it to mean anything, and it is a wall the
            eleventh onward can never scale. It made every filing an act of
            self-selection, so the curve was of people who bothered to type a
            name rather than of people who finished the game. And it published
            reader-supplied text under this masthead, policed by a blocklist
            that four characters and leetspelling will always eventually beat.

            The curve answers the same question better, and one line under it
            answers the rest: your exact position, said in the terms it can
            support at that size. See rankLine.

            On the bulletin's own publication grammar: here when there is a
            board to draw, absent otherwise. An empty frame promising a chart
            is worse than no frame. The drawing is built by the script rather
            than rendered here, because it comes off a file that arrives when
            the drawer opens. */}
        <section class="board" id="peaks-board" hidden>
          <h3>The distribution</h3>
          {/* The count, and how old it is. A filing lands instantly and the
              curve does not: the aggregation behind it runs on a schedule, so
              the count under a chart a reader has just joined is one short for
              a few minutes, and with nothing on the page about it the only
              available conclusion is that something failed.

              A timestamp rather than a sentence, because the fact is about
              this file: it is true whether or not the reader has ever filed,
              and a paragraph of explanation would be read once and never
              again. It goes behind the same dotted underline every other
              definition on this page uses, so it is there for the reader who
              wonders and invisible to the one who does not. */}
          <p class="board-count">
            <span id="peaks-board-count"></span>
            <span
              class="board-fresh"
              id="peaks-board-fresh"
              data-info="The distribution is rebuilt every few minutes. A newly published index appears on the next one."
              hidden
            ></span>
          </p>
          <div class="board-chart" id="peaks-board-chart"></div>
          <p class="board-rank" id="peaks-board-rank" hidden></p>
        </section>

      </div>
    </details>

    {/* Ruled off, like the rack and the score above it. The citation is a
        third thing this page says, not a footnote to the drawer it happened to
        follow — and once the score drawer shuts, an unruled sources block
        slides straight under the summary and reads as its subtitle. */}
    <div class="sources-wrap">
      <p class="sources">{sources}</p>
    </div>

    {/* Navigation, not a call to action, past the sources — the same folio
        grammar the reads close on: two sibling formats, never one. */}
    <nav class="folio folio-end" aria-label="More on inflation">
      <a href="/economy/read/price-of-nearly-everything">Read: Inflation: The Price of Nearly Everything</a><span class="dot" aria-hidden="true">&middot;</span><a href="/economy/explore/inflation">Dashboard: India Inflation</a>
    </nav>
  </article>

  <span id="peaks-src" data-src={src} hidden></span>
</StoryPage>

<style>
  .peaks {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: calc(var(--tsoi-spacing-unit) * 2.25);

    /* The engine reads this off the canvas rather than picking a token
       itself. --outline-variant is one token, but it lands on two different
       grounds: #D8CEBC on light's #F5F0E5 is about twice the contrast step
       of #272B33 on dark's #14161A, so the same "quiet hairline" reads as a
       distraction in light and a whisper in dark. Light steps down one; dark
       is already right and keeps the outline token. */
    --peaks-grid: var(--tsoi-color-surface-dim);

    /* Everything on the score panels that means you: the index, its
       components, your mark on the curve, your row in the table.

       This was teal for a while, borrowed from the inflation read, where the
       first figure teaches saffron as the headline and teal as the reader's
       own basket. The borrowing stopped paying once the page above it
       settled: the terrain is saffron, the auto is green and yellow, and a
       teal panel underneath made the fourth accent on a page that only has
       one subject. Ink says "you" perfectly well, and it says it quietly,
       which is what a column of your own numbers wants.
       Saffron survives here as one thing only, the top of the board, which is
       the one figure on these panels that belongs to somebody else. */
    --tsoi-color-you: var(--tsoi-color-on-surface);
    --tsoi-color-you-text: var(--tsoi-color-on-surface);

    /* Row lift for the era table, on the same principle as the grid above and
       for a blunter reason: dark's --surface-dim is #14161A, which IS the dark
       background, so a hover or selection painted with it is invisible. Dark
       lifts with --surface, the one step up that exists there. */
    --peaks-lift: var(--tsoi-color-surface-dim);

    /* The partitions between the machine, the rack, the score and the
       sources. They were the site's section rule, 2px of --on-surface, which
       is right on a read where the rule is separating one argument from the
       next and too loud on a page whose subject is a drawing: four black bars
       across the column competed with the terrain for the eye and made the
       page look ruled rather than composed. A hairline in --outline divides
       just as clearly at a fraction of the weight. Local to this page, not
       the token — the reads still want the heavy rule. */
    --peaks-rule: 1px solid var(--tsoi-color-outline);

    /* The ground under the curve, and the third token to need the same
       correction for the same reason: dark's --surface-dim IS dark's
       background, so the area fill has been painting the chart onto itself.
       It went unnoticed while the camera framed every era along the bottom
       edge and the fill was a thin band. Now that the chart is framed around
       the terrain, the fill is most of the box and has to be visible, or the
       line floats in the middle of nothing. */
    --peaks-fill: var(--tsoi-color-surface-dim);

    /* The auto's livery, handed to the engine, which reads it off the canvas
       rather than knowing any colour of its own. The values are the site's
       auto tokens, which also paint the two cover cards and the social card,
       so all four drawings of this vehicle move together. Green shell under a
       yellow canopy is what a CNG auto actually looks like, and matching the
       thing rather than the palette frees the site's saffron for the terrain,
       where it belongs, because the terrain is the data. */
    --peaks-car-body: var(--tsoi-color-auto-body);
    --peaks-car-roof: var(--tsoi-color-auto-roof);
  }
  html[data-theme='dark'] .peaks {
    --peaks-grid: var(--tsoi-color-outline-variant);
    --peaks-lift: var(--tsoi-color-surface);
    --peaks-fill: var(--tsoi-color-surface);
    /* Set here and nowhere else, so the lamp is a property of the dark theme
       rather than a flag the engine carries. Unset in light, and an unset
       headlamp is an unlit one. */
    --peaks-headlamp: var(--tsoi-color-auto-lamp);
  }

  .folio {
    font: var(--tsoi-text-byline);
    font-weight: 500;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 4px 0;
  }
  .folio a { color: var(--tsoi-color-primary-text); text-decoration: none; }
  .folio a:hover { text-decoration: underline; }
  .folio .dot { color: var(--tsoi-color-on-surface-variant); padding-inline: 5px; }
  /* Same move as the reads: a hairline and the byline face say this is
     navigation past the sources, not a second masthead. */
  .folio-end { padding-top: calc(var(--tsoi-spacing-unit) * 2); border-top: 1px solid var(--tsoi-color-outline-variant); }

  .masthead {
    border-bottom: var(--peaks-rule);
    padding-bottom: calc(var(--tsoi-spacing-unit) * 1.5);
    display: flex;
    flex-direction: column;
    gap: var(--tsoi-spacing-unit);
  }
  /* the kicker line carries the share control at its right edge; centering
     keeps the 30px button from stretching the line */
  .mast-top {
    display: flex; align-items: center; justify-content: space-between;
    gap: calc(var(--tsoi-spacing-unit) * 2);
  }
  .kicker {
    margin: 0;
    font: var(--tsoi-text-byline);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tsoi-color-primary-text);
  }
  h1 {
    margin: 0;
    font: var(--tsoi-text-headline-xl);
    letter-spacing: var(--tsoi-text-headline-xl-tracking);
    text-wrap: balance;
  }
  .deck {
    margin: 0;
    max-width: 62ch;
    font: var(--tsoi-text-deck);
    letter-spacing: var(--tsoi-text-deck-tracking);
    color: var(--tsoi-color-on-surface-variant);
  }

  /* The machine is the ruled box; the chart is what is inside it. The saffron
     top rule and the outline used to sit on the stage, and have moved out one
     level so that the slot bar is inside the same object as the canvas rather
     than a control sitting above a separate one. */
  .machine {
    border: 1px solid var(--tsoi-color-outline);
    border-top: 2px solid var(--tsoi-color-primary);
    background: var(--tsoi-color-background);
  }
  /* The machine and the throttle are controls, not prose. On a phone, a tap
     on the chart flashed the platform's blue selection highlight, and a long
     press on the pedal grabbed the coasting line under it and raised the
     text-lookup popup mid-run.

     Opting the controls out was not enough, and the reason is worth writing
     down: WebKit does not treat `user-select: none` as "this gesture selects
     nothing". It treats it as "not here" and goes looking for the nearest
     selectable text instead. So holding the throttle on an iPad reached PAST
     the opted-out pedal and PAST the opted-out line under it, and highlighted
     "The rack" two rules below — a heading nobody was pointing at, complete
     with a Copy / Look Up bubble over the game, on every single run.

     There is no radius to tune, so the region is the whole article and the
     exceptions are named: the parts a reader might actually want to copy get
     selection back. Which is the same rule as before, stated the other way
     round, and this way there is nowhere for the gesture to escape to. */
  .peaks {
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }
  /* The prose, and only the prose. Not the summaries: a drawer's heading is
     the handle you pull, and it is the handle the long press was landing on. */
  .masthead,
  .drawer-body,
  .sources-wrap {
    -webkit-user-select: text;
    user-select: text;
    -webkit-touch-callout: default;
  }
  .stage {
    position: relative;
    background: var(--tsoi-color-background);
  }

  /* The slot: what is loaded, and the switch that decides how it plays. */
  /* One row that never wraps: the mode switch belongs on the right-hand edge
     of the machine at every width, and wrapping put it under the cartridge
     name on a phone. What gives way instead is the furniture around the
     select — the tag and the date span — neither of which is the control. */
  .slot {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    gap: calc(var(--tsoi-spacing-unit) * 1.5);
    padding: 8px 10px 8px 12px;
    border-bottom: 1px solid var(--tsoi-color-outline-variant);
  }
  .slot-load {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  .slot-tag {
    font: var(--tsoi-text-byline);
    font-weight: 500;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tsoi-color-on-surface-variant);
    white-space: nowrap;
  }
  .slot-span {
    font: 400 12px var(--tsoi-font-mono);
    letter-spacing: 0.02em;
    color: var(--tsoi-color-on-surface-variant);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  /* The brackets are punctuation around the month, so they belong to the
     count's presentation and not to its text. When the phone drops the month
     they go with it, leaving a bare 15/77 rather than an orphaned pair. */
  .slot-span .span-count::before { content: ' ('; }
  .slot-span .span-count::after { content: ')'; }
  /* The month you are in reads at full ink: it is the one live word on the
     bar, and the terrain under the auto is that month. */
  .slot-span .span-month { color: var(--tsoi-color-on-surface); }
  .slot-mode { display: flex; align-items: center; gap: 8px; }

  /* The readout closes the machine the way the slot bar opens it: same
     padding, same hairline, same uppercase tag on the left. The figure is set
     in the mono face at the size a number can be read at a glance without
     competing with the chart above it, and the note takes the right-hand
     edge, where the mode switch sits on the top bar. */

  /* The select. Stripped back to the site's own furniture — a hairline box,
     the body face, a caret drawn as two rules rather than an icon — because
     a platform select in the middle of this page is the one control that
     would not look like it belongs to it. */
  .slot-select { position: relative; display: inline-flex; min-width: 0; }
  .slot-select::after {
    content: '';
    position: absolute;
    right: 9px;
    top: 50%;
    width: 5px;
    height: 5px;
    margin-top: -4px;
    border-right: 1.5px solid var(--tsoi-color-on-surface-variant);
    border-bottom: 1.5px solid var(--tsoi-color-on-surface-variant);
    transform: rotate(45deg);
    pointer-events: none;
  }
  .slot-select select {
    appearance: none;
    -webkit-appearance: none;
    max-width: 100%;
    margin: 0;
    padding: 5px 24px 5px 9px;
    background: transparent;
    border: 1px solid var(--tsoi-color-outline);
    border-radius: var(--tsoi-radius-sm);
    font: var(--tsoi-text-body);
    font-weight: 600;
    font-size: 14px;
    line-height: 1.2;
    color: var(--tsoi-color-on-surface);
    cursor: pointer;
    text-overflow: ellipsis;
  }
  .slot-select select:hover { background: var(--peaks-lift); }
  .slot-select select:focus-visible { outline: 2px solid var(--tsoi-color-primary); outline-offset: 1px; }
  /* The option list is painted by the platform, so it gets the page's own
     ground rather than whatever white the OS would default to in dark mode. */
  .slot-select option {
    background: var(--tsoi-color-surface-container-low);
    color: var(--tsoi-color-on-surface);
  }

  .slot-spark[hidden] { display: none; }
  .slot-spark {
    display: block;
    position: relative;
    flex: none;
    width: 54px;
    height: 20px;
  }
  .slot-spark svg { display: block; width: 100%; height: 100%; }
  /* The run's position on the loaded stretch, which makes the slot's line the
     map this game did not otherwise have: the canvas shows the few years
     around you and nothing about where that is in the decade.

     It is the auto's green, because the dot IS the auto. Saffron would be
     wrong twice over now — it is the series' colour, and the line under the
     dot is already wearing it.

     Positioned in percentages so it holds at both slot widths, and the ring
     is what keeps a 5px mark off a 1.5px line of similar weight.

     Nudged rather than animated: months arrive as whole steps and a step is
     well under a pixel here, so the transition is only smoothing the arrival,
     not inventing motion. It stops at the reduced-motion setting like
     everything else, where the dot simply jumps. */
  .spark-dot[hidden] { display: none; }
  .spark-dot {
    position: absolute;
    width: 5px;
    height: 5px;
    margin: -2.5px 0 0 -2.5px;
    border-radius: 50%;
    background: var(--tsoi-color-auto-body);
    box-shadow: 0 0 0 1px var(--tsoi-color-surface-container-low);
    transition: left 0.25s linear, top 0.25s linear;
  }
  @media (prefers-reduced-motion: reduce) {
    .spark-dot { transition: none; }
  }
  canvas {
    display: block;
    width: 100%;
    /* 400px shows ~44 percentage points of range at 9px per point, comfortably
       around a series topping out near 35%. It was 360, which is the closer
       fit to the terrain and forty pixels too short for the run-over card:
       the card is the reason for the number now, and the extra range is real
       on Hard, where the same hills are drawn 1.4 times taller. */
    height: 400px;
    /* The chart is not the throttle any more, so it scrolls like anything
       else on the page. The pedal is the only element that swallows a drag. */
    touch-action: pan-y;
  }
  canvas:focus-visible { outline: 2px solid var(--tsoi-color-primary); outline-offset: -2px; }

  /* Same guard, and this one had been missing since M1: the counter is marked
     hidden in the markup and has been showing on the start screen the whole
     time, reading "0 / 113" over a card that says the run has not begun. */
  .hud[hidden] { display: none; }
  .hud {
    position: absolute;
    top: 10px;
    right: 12px;
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 6px;
    font: 500 11px var(--tsoi-font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tsoi-color-on-surface-variant);
    font-variant-numeric: tabular-nums;
    pointer-events: none;
  }
  .hud-value {
    font-size: 17px;
    letter-spacing: normal;
    color: var(--tsoi-color-on-surface);
  }

  .fps {
    position: absolute;
    bottom: 34px;
    right: 12px;
    margin: 0;
    font: 400 10px var(--tsoi-font-mono);
    color: var(--tsoi-color-on-surface-variant);
    pointer-events: none;
  }

  .veil {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: calc(var(--tsoi-spacing-unit) * 2);
  }
  .veil[hidden] { display: none; }

  /* Laid out like the site's cards, because that is what they are. The end
     card carries the basket as well as the result, which is more than the
     chart leaves room for at any width once the run ends near a flagged
     month. It scrolls inside itself rather than escaping the machine or
     dropping a section on small screens — but only the part above the action
     row scrolls, so Retry is on screen whatever the card holds. */
  .card {
    width: min(440px, 100%);
    max-height: 100%;
    overflow: hidden;
    box-sizing: border-box;
    background: var(--tsoi-color-surface-container-low);
    border: 1px solid var(--tsoi-color-outline);
    border-top: 2px solid var(--tsoi-color-primary);
    padding: calc(var(--tsoi-spacing-unit) * 2.75) calc(var(--tsoi-spacing-unit) * 3);
    display: flex;
    flex-direction: column;
    gap: calc(var(--tsoi-spacing-unit) * 1.25);
  }
  /* min-height: 0 is what makes this work at all: a flex item defaults to
     min-content height, which for a scroll container is its whole content,
     so without it the card grows past the chart instead of scrolling. */
  .card-scroll {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: calc(var(--tsoi-spacing-unit) * 1.1);
  }
  .card[hidden] { display: none; }
  .card-kicker {
    margin: 0;
    font: var(--tsoi-text-byline);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tsoi-color-primary-text);
  }
  .card h2 {
    margin: 0;
    font: var(--tsoi-text-headline-lg);
    letter-spacing: var(--tsoi-text-headline-lg-tracking);
    text-wrap: balance;
  }
  .card-body {
    margin: 0;
    font: var(--tsoi-text-body);
    color: var(--tsoi-color-on-surface-variant);
  }
  .card-body:empty { display: none; }
  /* Takes the place the Drive button used to hold: full ink so it reads as
     the instruction rather than more explanation, but still a sentence, so
     it does not compete with the actual control below the chart. */
  .card-cta {
    margin: 0;
    font: var(--tsoi-text-body);
    font-weight: 600;
    color: var(--tsoi-color-on-surface);
  }

  .score {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-variant-numeric: tabular-nums;
  }
  .score span:first-child {
    font: var(--tsoi-text-metric-xl);
    letter-spacing: var(--tsoi-text-metric-xl-tracking);
  }
  .score-unit {
    font: var(--tsoi-text-byline);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tsoi-color-on-surface-variant);
  }
  /* The clock, in the mono face the game's other numbers use and in saffron,
     because it is the second thing you scored. Not uppercase: it is a
     reading, not a label. */
  .score-time[hidden] { display: none; }
  .score-time {
    font: 400 12px var(--tsoi-font-mono);
    letter-spacing: 0.02em;
    color: var(--tsoi-color-primary-text);
  }

  /* The basket on the run-over card. Chips rather than cards proper: they sit
     inside a card already, and a card inside a card is the elevation move the
     site does not make. Three across at every width — the labels are short
     enough, and two rows of three is the shape the six actually have. */
  /* Another display rule, another guard. The basket ships hidden and only a
     cleared run shows it. */
  .next[hidden] { display: none; }
  .next { display: flex; flex-direction: column; gap: 7px; }
  .next-head {
    margin: 0;
    font: var(--tsoi-text-byline);
    font-weight: 500;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tsoi-color-on-surface-variant);
  }
  .next-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }
  .next-item {
    appearance: none;
    width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 1px;
    text-align: left;
    background: transparent;
    border: 1px solid var(--tsoi-color-outline-variant);
    border-radius: var(--tsoi-radius-sm);
    padding: 6px 8px;
    cursor: pointer;
    color: var(--tsoi-color-on-surface);
  }
  .next-item:hover { background: var(--peaks-lift); border-color: var(--tsoi-color-outline); }
  .next-item:focus-visible { outline: 2px solid var(--tsoi-color-primary); outline-offset: 1px; }
  /* The one you just drove is marked, not disabled: replaying it is Retry,
     but the chip should still say which row this run belongs to. */
  .next-item[data-suggested] { border-color: var(--tsoi-color-primary); }
  .next-name {
    font: 500 11px var(--tsoi-font-body);
    letter-spacing: 0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* Stretched to the chip's width like the slot's is, and taller than it first
     looks like it needs to be. All six are drawn on one vertical scale, which
     is what lets the rack say the seventies tower over inflation targeting —
     but the price of that scale is that five of the six live in the bottom
     third of it. Under about twenty pixels they collapse into six versions of
     the same flat line and the chips stop being worth drawing at all. Two rows
     of chips make this sixteen pixels of card, which the scroller can afford
     and the recognition is worth. */
  .next-spark {
    display: block;
    width: 100%;
    height: 24px;
    margin: 3px 0 2px;
    overflow: visible;
  }
  .next-prog {
    font: 400 10px var(--tsoi-font-mono);
    letter-spacing: 0.02em;
    color: var(--tsoi-color-on-surface-variant);
  }
  /* Three states, because a cleared stretch is not one thing. Undriven stays
     at variant weight; cleared reads at full ink; cleared on Hard takes the
     saffron, because that is the only one with nothing left to gain. Saffron
     used to mean cleared, which made a Medium sweep look finished when half
     the index was still on the table. */
  .next-prog.has-run { color: var(--tsoi-color-on-surface); }
  .next-prog.is-clear { color: var(--tsoi-color-primary-text); }

  /* The action row, outside the scroller. The hairline is doing a job: it
     marks where the scrolling part ends, so a card with more above the fold
     looks like one rather than like a card that stops mid-basket. */
  .actions {
    flex: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    padding-top: calc(var(--tsoi-spacing-unit) * 1.25);
    border-top: 1px solid var(--tsoi-color-outline-variant);
  }
  .actions button,
  .actions a {
    font: 600 15px var(--tsoi-font-body);
    cursor: pointer;
    border-radius: var(--tsoi-radius-md);
    border: 1px solid transparent;
    padding: 11px 20px;
    text-decoration: none;
    transition: background 0.15s, transform 0.05s;
  }
  .actions button[hidden] { display: none; }
  .actions button:active { transform: translateY(1px); }
  /* Light: --primary with white text, the pairing the other game's primary
     button uses, for the contrast reason recorded there. Dark is a different
     problem and needs a different answer: dark's --primary is a much brighter
     saffron (#FF8236), and white on it measures about 2.3:1. --on-primary is
     the token that exists for exactly this, and in dark it is near-black. */
  .btn-primary { background: var(--tsoi-color-primary); color: #fff; }
  html[data-theme='dark'] .btn-primary { color: var(--tsoi-color-on-primary); }
  .btn-primary:hover { background: var(--tsoi-color-primary-container); }
  /* Retry on a cleared card: the same control, stepped back to an outline so
     the six chips above it are what the card is asking. It also gives back
     eight pixels of the card's height, which is where the last row of the
     basket came from. */
  /* Scoped through .actions on purpose. Astro stamps its cid attribute onto
     both halves of a descendant selector, so `.actions button` ships as
     (0,3,1) and out-specifies a bare `.btn-primary.is-quiet` at (0,3,0) —
     which silently kept the padding, the weight and the transparent border of
     the loud version while letting the colour through. */
  .actions button.is-quiet {
    background: transparent;
    border-color: var(--tsoi-color-outline);
    color: var(--tsoi-color-on-surface-variant);
    font-weight: 500;
    padding: 7px 16px;
  }
  .actions button.is-quiet:hover {
    background: var(--peaks-lift);
    color: var(--tsoi-color-on-surface);
  }
  .btn-ghost {
    background: transparent;
    border-color: var(--tsoi-color-outline);
    color: var(--tsoi-color-on-surface);
  }
  .btn-ghost:hover { background: var(--tsoi-color-surface-container-high); }

  /* The pedal. Sized for a thumb (56px is the comfortable floor for a
     control you hold rather than tap), full width so it cannot be missed, and
     stating its own function rather than relying on a caption elsewhere.
     `touch-action: none` lives here and nowhere else, so the pedal is the only
     part of the page that swallows a drag. */
  .pedal {
    width: 100%;
    min-height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: var(--tsoi-color-primary);
    color: #fff;
    border: 1px solid transparent;
    border-radius: var(--tsoi-radius-md);
    font: 600 15px var(--tsoi-font-body);
    letter-spacing: 0.02em;
    cursor: pointer;
    text-align: center;
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    transition: background 0.08s, transform 0.04s;
  }
  html[data-theme='dark'] .pedal { color: var(--tsoi-color-on-primary); }
  /* The whole tactile budget: a 1px drop and a darker fill. No shadow, so
     nothing here becomes elevation. */
  .pedal.is-down {
    background: var(--tsoi-color-primary-container);
    transform: translateY(1px);
  }
  /* Between page load and the terrain arriving there is nothing to drive on.
     The bar stays in place and keeps its size so the page does not shift
     under a waiting finger; it just reads as not-yet. */
  .pedal:disabled {
    opacity: 0.45;
    cursor: default;
  }
  /* Which of the two labels shows is a function of the disabled state, so the
     bar cannot be live and still say loading, or ready and still say it. */
  .pedal:disabled .pedal-label,
  .pedal:not(:disabled) .pedal-wait { display: none; }
  .pedal .keycap {
    display: inline-block;
    margin-inline: 2px;
    vertical-align: baseline;
    font: 500 11px var(--tsoi-font-mono);
    letter-spacing: 0.06em;
    padding: 3px 8px;
    border: 1px solid currentColor;
    border-radius: var(--tsoi-radius-sm);
    opacity: 0.85;
  }
  /* Touch devices have no Space bar to advertise. */
  @media (hover: none) {
    .pedal .keycap { display: none; }
  }

  .controls,
  .sources {
    margin: 0;
    font: var(--tsoi-text-byline);
    font-size: 11px;
    line-height: 1.5;
    letter-spacing: 0.04em;
    color: var(--tsoi-color-on-surface-variant);
    max-width: 70ch;
  }
  .sources { color: var(--tsoi-color-on-surface-variant); opacity: 0.85; }
  /* Ruled off on the page's own section rule, because the citation is a third
     thing this page says and not the tail of the drawer above it. Margin
     alone was enough while the score never folded; shut it and the sources
     slid up under the summary and read as its subtitle. A rule cannot be
     collapsed by the thing above it changing height.

     The rule goes on a wrapper and not on the paragraph, because the
     paragraph is capped at 70ch for reading and a border follows the box:
     put on .sources it drew a section rule two-fifths of the way across the
     column and stopped, which reads as a broken rule rather than a short
     one. The wrapper spans; the text still wraps where it should. */
  .sources-wrap {
    /* More air than the drawer's own partitions take. What sits above this
       rule used to be a chart, which ends in white space; it is a table now,
       and a table ends in a row, so the citation needs the gap to say it is
       not the next one. */
    padding-top: calc(var(--tsoi-spacing-unit) * 2);
    border-top: var(--peaks-rule);
  }

  /* ── Section drawers ──────────────────────────────────────────────────
     The rack and the bulletin fold on the same furniture, because they are
     the same kind of thing to a player: neither is read on the way in. The
     section rule stays exactly where it was and the heading keeps its size,
     so a shut drawer is the rule and the heading it always was. Nothing here
     moves the machine or the pedal.

     The caret sits against the heading, not on the far edge of the rule. On
     the edge it was 900px from the words it belonged to and read as furniture
     on the section rule rather than a control on the heading — which is to
     say the drawers did not look like drawers at all. Against the text it is
     the same mark the select wears, two rules turned through 45 degrees, and
     it is unmistakably attached to the thing it opens. */
  .drawer {
    padding-top: calc(var(--tsoi-spacing-unit) * 1.5);
    border-top: var(--peaks-rule);
  }
  /* Aligned on the last baseline in the row, which is the heading's. Centring
     was wrong on the bulletin, whose title is a two-line stack: the caret
     took the centre of kicker-plus-heading and landed in the gap between
     them, level with neither.

     Aligning the summary's own flex items does not fix it, and two rounds of
     trying said why. flex-end pins boxes, and a box bottom is below the
     baseline by whatever the descender space happens to be. `last baseline`
     asks the right question and gets the wrong answer, because the item
     carrying the heading is itself a flex container and Chrome reports its
     FIRST line's baseline as its last — so the caret aligned to the kicker,
     which is the exact fault being fixed.

     So the caret stops being a flex item. It is an inline-block on the last
     text of the heading line: the hint in the rack, the heading itself in the
     bulletin. An inline-block's baseline IS its bottom margin edge, so it
     lands on the text baseline by construction, at any type size, in any
     container, with nothing to re-tune. */
  .drawer > summary {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    list-style: none;
  }
  .drawer > summary::-webkit-details-marker { display: none; }
  /* An 8px square rotated 45 degrees is a diamond about 11px tall, and the
     stroke that shows sits low in the box pointing down and high pointing up.
     The nudges centre the visible apex on the text's own middle in both
     states; they are corrections to the glyph, not to the layout. */
  .drawer-mark::after {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-left: 10px;
    border-right: 1.75px solid var(--tsoi-color-on-surface);
    border-bottom: 1.75px solid var(--tsoi-color-on-surface);
    transform: translateY(-1px) rotate(45deg);
  }
  .drawer[open] .drawer-mark::after { transform: translateY(2px) rotate(-135deg); }
  /* The heading answers the pointer too, because the caret alone is an 8px
     shape and a reader who has not noticed it has nothing to hover. */
  .drawer > summary:hover .drawer-title,
  .drawer > summary:hover .bulletin-head,
  .drawer > summary:hover .drawer-hint { color: var(--tsoi-color-primary-text); }
  .drawer > summary:hover .drawer-mark::after {
    border-right-color: var(--tsoi-color-primary);
    border-bottom-color: var(--tsoi-color-primary);
  }
  .drawer > summary:focus-visible { outline: 2px solid var(--tsoi-color-primary); outline-offset: 3px; }
  .drawer > summary h2 {
    margin: 0;
    font: var(--tsoi-text-headline-sm);
    letter-spacing: var(--tsoi-text-headline-sm-tracking);
  }
  /* Heading and hint on one baseline, wrapping to two lines on a narrow
     phone rather than squeezing the heading. */
  .drawer-title {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 2px calc(var(--tsoi-spacing-unit) * 0.75);
  }
  /* What is inside, stated on the shut drawer. A caret says something opens
     and nothing else; a reader deciding whether to open it wants to know
     what for. */
  .drawer-hint {
    font: var(--tsoi-text-byline);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--tsoi-color-on-surface-variant);
  }
  .drawer-body {
    display: flex;
    flex-direction: column;
    gap: calc(var(--tsoi-spacing-unit) * 1.25);
    padding-top: calc(var(--tsoi-spacing-unit) * 1.5);
  }

  /* ── The rack ─────────────────────────────────────────────────────────
     One drawer: the six cartridges, then notes on whichever is loaded. The
     notes used to be a section of their own with the same heavy rule above
     them, which put a page-level division between choosing a thing and
     reading about the thing you chose. */
  .rack > .drawer-body { gap: calc(var(--tsoi-spacing-unit) * 1.5); }
  /* A hairline and a smaller heading, so the notes read as the second half of
     the rack rather than the next thing on the page. */
  .notes {
    display: flex;
    flex-direction: column;
    gap: calc(var(--tsoi-spacing-unit) * 1.25);
    padding-top: calc(var(--tsoi-spacing-unit) * 1.25);
    border-top: 1px solid var(--tsoi-color-outline);
  }
  .notes h3 {
    margin: 0;
    font: var(--tsoi-text-byline);
    font-weight: 500;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tsoi-color-on-surface-variant);
  }
  .setup-note {
    margin: 0;
    font: var(--tsoi-text-byline);
    font-size: 11px;
    line-height: 1.5;
    letter-spacing: 0.04em;
    color: var(--tsoi-color-on-surface-variant);
    max-width: 70ch;
  }

  /* Three buttons that behave as one control, so they are drawn as one:
     a single outline with hairlines between, not three separate objects. */
  .modes {
    display: flex;
    border: 1px solid var(--tsoi-color-outline);
    border-radius: var(--tsoi-radius-sm);
    overflow: hidden;
  }
  .mode {
    appearance: none;
    background: transparent;
    border: 0;
    border-left: 1px solid var(--tsoi-color-outline);
    padding: 5px 11px;
    font: 500 11px var(--tsoi-font-body);
    letter-spacing: 0.04em;
    white-space: nowrap;
    color: var(--tsoi-color-on-surface-variant);
    cursor: pointer;
  }
  .mode:first-child { border-left: 0; }
  .mode:hover { background: var(--peaks-lift); color: var(--tsoi-color-on-surface); }
  .mode[aria-pressed='true'] {
    background: var(--tsoi-color-primary);
    color: #fff;
    /* The fill paints its own hairline on every side. Matching the
       neighbour's border colour (below) is exact arithmetic and holds at
       whole device pixel ratios; at the fractional ones a real laptop
       actually runs at, the fill's edge and the border's edge round to
       different device pixels and the background opens a pale seam between
       them. A ring cannot open a seam against itself. It also fills the
       wedge the group's 2px radius bites out of whichever segment is on an
       end, since the parent clips this ring to the same curve. */
    box-shadow: 0 0 0 1px var(--tsoi-color-primary);
  }
  /* A hairline is how two unpressed segments are told apart. Against the
     filled one it is not a separator, it is a seam down the edge of a solid
     block, and it read as a rendering fault. Both edges of the pressed
     segment take the fill colour instead: its own border disappears into its
     background, and its right-hand neighbour's border extends the fill by the
     one pixel it occupies. No layout moves when the switch is thrown. */
  .mode[aria-pressed='true'],
  .mode[aria-pressed='true'] + .mode { border-left-color: var(--tsoi-color-primary); }
  html[data-theme='dark'] .mode[aria-pressed='true'] { color: var(--tsoi-color-on-primary); }

  /* ── Cartridges ───────────────────────────────────────────────────────
     Six flat cards, all the same weight as each other, distinguished by the
     one thing that actually differs: the shape of the series inside them.
     The loaded one takes a saffron rule across its top edge, which is the
     same rule the machine wears, so the pair reads as "this is what is in
     that". Nothing is raised above anything else. */
  .carts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }
  .cart {
    appearance: none;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 6px;
    text-align: left;
    background: transparent;
    border: 1px solid var(--tsoi-color-outline-variant);
    border-top: 2px solid var(--tsoi-color-outline-variant);
    padding: 10px 12px 12px;
    cursor: pointer;
    color: inherit;
    font: var(--tsoi-text-body);
  }
  .cart:hover { background: var(--peaks-lift); }
  .cart:focus-visible { outline: 2px solid var(--tsoi-color-primary); outline-offset: 1px; }
  .cart[aria-pressed='true'] {
    border-color: var(--tsoi-color-outline);
    border-top-color: var(--tsoi-color-primary);
    background: var(--peaks-lift);
  }
  /* Tall enough that the calm eras still show their wiggle. On a scale that
     has to reach 34.7% the quiet decades are a few pixels of movement, and at
     34px five of the six cards were the same flat line. Where a card's line
     sits vertically is doing as much work as its shape: the eighties ride
     high and flat, inflation targeting runs low and flat, and those are
     different things to drive. */
  .cart-spark {
    display: block;
    width: 100%;
    height: 54px;
  }
  .spark-line {
    stroke: var(--tsoi-color-outline);
    stroke-width: 1.25;
    stroke-linejoin: round;
  }
  /* Saffron marks the one being pointed at, wherever a sparkline appears: the
     cartridge in the machine, the slot's own map, and the stretch the card is
     recommending. Everything else stays at outline weight. */
  .cart[aria-pressed='true'] .spark-line,
  .next-item[data-suggested] .spark-line,
  .slot-spark .spark-line { stroke: var(--tsoi-color-primary); }
  .cart-name { font-weight: 600; }
  .cart-meta,
  .cart-best {
    font: 400 11px var(--tsoi-font-mono);
    letter-spacing: 0.02em;
    color: var(--tsoi-color-on-surface-variant);
  }
  .cart-meta { display: flex; justify-content: space-between; gap: 8px; }
  .cart-best.has-run { color: var(--tsoi-color-on-surface); }
  .cart-best.is-clear { color: var(--tsoi-color-primary-text); }

  /* ── Notes on the loaded stretch ──────────────────────────────────────── */
  .note[hidden] { display: none; }
  .note {
    display: flex;
    flex-direction: column;
    gap: calc(var(--tsoi-spacing-unit) * 1.25);
  }
  .note-char {
    margin: 0;
    max-width: 62ch;
    font: var(--tsoi-text-body);
    color: var(--tsoi-color-on-surface);
    text-wrap: pretty;
  }
  .stats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--tsoi-spacing-unit) * 2.5);
  }
  .stats li { display: flex; flex-direction: column; gap: 2px; }
  .stat-v {
    font: 400 20px var(--tsoi-font-mono);
    letter-spacing: -0.01em;
    color: var(--tsoi-color-on-surface);
    font-variant-numeric: tabular-nums;
  }
  .stat-k {
    font: var(--tsoi-text-byline);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tsoi-color-on-surface-variant);
  }
  .events { display: flex; flex-direction: column; gap: 8px; }
  .events-head {
    margin: 0;
    font: var(--tsoi-text-byline);
    font-weight: 500;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tsoi-color-primary-text);
  }
  .events ul { list-style: none; margin: 0; padding: 0; }
  .events li {
    display: grid;
    grid-template-columns: 8em 4em 1fr;
    gap: 4px 14px;
    align-items: baseline;
    padding: 8px 0;
    border-top: 1px solid var(--tsoi-color-outline-variant);
  }
  .ev-when,
  .ev-rate {
    font: 400 12px var(--tsoi-font-mono);
    letter-spacing: 0.02em;
    color: var(--tsoi-color-on-surface-variant);
  }
  .ev-rate { text-align: right; }
  .ev-text {
    font: var(--tsoi-text-byline);
    font-size: 12px;
    line-height: 1.55;
    color: var(--tsoi-color-on-surface-variant);
    text-wrap: pretty;
  }

  /* ── The components table ─────────────────────────────────────────────
     Numbers stated the way the rest of the site states them: a rule under
     the head, hairlines between rows, figures in the mono face and
     right-aligned so the columns read down. It reports and nothing more —
     picking a stretch is the rack's job now. */
  .eras {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* The two rows have to resolve the SAME track widths, which is why these
     are rem and not em: the head is set at 10px and the rows at 15px, so an
     em template gave the head 45px where the rows had 67.5, and every column
     of figures sat a third of its own width left of the label above it. */
  .era-head,
  .era-row {
    display: grid;
    grid-template-columns: 1fr 4.25rem 5.25rem 4.75rem 5.75rem;
    gap: 10px;
    align-items: baseline;
    width: 100%;
    text-align: left;
  }
  .era-head {
    padding: 0 6px 6px;
    border-bottom: 1px solid var(--tsoi-color-on-surface);
    font: var(--tsoi-text-byline);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tsoi-color-on-surface-variant);
  }
  .era-row {
    border-bottom: 1px solid var(--tsoi-color-outline-variant);
    padding: 10px 6px;
    font: var(--tsoi-text-body);
  }
  .era-name { font-weight: 600; min-width: 0; }
  /* Inherits everything, so the cell reads exactly as it did when it was
     text. The negative margin lets the hover panel sit proud of the label
     without moving it, which keeps the first column's baseline aligned with
     the four columns of figures beside it. */
  .era-load {
    margin: -3px -6px;
    padding: 3px 6px;
    border: 0;
    border-radius: var(--tsoi-radius-sm);
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .era-load:hover { background: var(--peaks-lift); }
  .era-load:focus-visible { outline: 2px solid var(--tsoi-color-primary); outline-offset: 1px; }
  /* The stretch already in the machine. The rack marks its own with a saffron
     edge and this is the same fact in a table, so it is the same saffron, on
     the side the eye reads first. */
  .era-load[aria-current='true'] {
    box-shadow: inset 2px 0 0 var(--tsoi-color-primary);
  }
  .era-row .num,
  .era-head .num {
    font: 400 12px var(--tsoi-font-mono);
    letter-spacing: 0.02em;
    color: var(--tsoi-color-on-surface-variant);
  }
  .num { text-align: right; }
  .era-head .num { font: var(--tsoi-text-byline); font-size: 10px; }
  /* A reported component reads at full ink; an era you have never driven
     stays at variant weight with its em dash. The table should show at a
     glance which rows are still missing from the basket. */
  .era-row .best.has-run,
  .era-row .contrib.has-run { color: var(--tsoi-color-on-surface); }
  .era-row .contrib.is-clear { color: var(--tsoi-color-you-text); }

  /* The sum line. A heavier rule above it than the hairlines between rows and
     none below, which is how a column of figures is closed on paper, and no
     row padding on the bottom for the same reason. The label sits in the
     byline face rather than the body face the components use: it names an
     operation, not a component. */
  .era-total {
    display: grid;
    grid-template-columns: 1fr 4.25rem 5.25rem 4.75rem 5.75rem;
    gap: 10px;
    align-items: baseline;
    width: 100%;
    text-align: left;
    padding: 10px 6px 0;
    border-top: 1px solid var(--tsoi-color-on-surface-variant);
    margin-top: -1px;
  }
  .era-total .era-name {
    font: var(--tsoi-text-byline);
    font-weight: 500;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tsoi-color-on-surface-variant);
  }
  .era-total .num {
    font: 400 12px var(--tsoi-font-mono);
    letter-spacing: 0.02em;
    color: var(--tsoi-color-on-surface-variant);
  }
  /* The one figure on this line that is the score, so it carries the ink the
     score carries everywhere else on the page. */
  .era-total .contrib { color: var(--tsoi-color-you-text); }

  /* ── The bulletin ─────────────────────────────────────────────────────
     Same furniture as the setup block above it, deliberately: this is the
     second half of one statement, not a separate feature. */
  .bulletin-head { display: flex; flex-direction: column; gap: 4px; }
  .bulletin-head h2 {
    margin: 0;
    font: var(--tsoi-text-headline-sm);
    letter-spacing: var(--tsoi-text-headline-sm-tracking);
  }
  /* The figure rides on the summary, to the right of the heading and past the
     caret, so a shut drawer still reports. `order` puts it there rather than
     source position: the caret is a ::after and therefore always last in the
     markup, and it has to render second, between the heading and the figure.
     Everything else stays at order 0 and keeps source order. */
  /* The figure sits on the heading's line rather than centred against the
     two-line stack, which is what flex-end buys here: the caret is not a flex
     item any more, so nothing else in this row depends on the alignment. */
  .bulletin > summary { flex-wrap: wrap; align-items: flex-end; }
  .bulletin > summary .index-value { order: 1; margin-left: auto; }

  /* The figure carries the weight, so it is set at headline size in the mono
     face the rest of the numbers use, with the mode beside it at byline size
     — an index value means nothing without saying which basket it is for. */
  /* The [hidden] guard is not optional on anything given a display rule: the
     UA's `[hidden] { display: none }` loses to a class selector, so a flex
     container marked hidden stays on screen. This one hid nothing until it
     was caught in a screenshot, with the mode label sitting under a
     provisional index like a published one. */
  .index-value[hidden] { display: none; }
  /* A column, right-aligned: the figure on its own line and its standing and
     share control on a second one under it. Flat, the three were a figure with
     two tails on it; stacked, the figure keeps the size it was set at and the
     small print sits where small print goes. */
  .index-value {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 7px;
    font: 400 40px var(--tsoi-font-mono);
    letter-spacing: -0.01em;
    line-height: 1;
    color: var(--tsoi-color-you-text);
  }
  .index-meta { display: flex; align-items: center; gap: 10px; }
  /* The caveat beside it drops to variant ink. It is a word about the
     figure's standing, not part of the figure, and at full ink the two would
     read as one long string. */
  .index-value .index-mark { color: var(--tsoi-color-on-surface-variant); }
  /* The provisional mark, beside the figure rather than under it, at the
     size the mode label was going to be: a figure that carries its own
     caveat cannot be quoted without it. Never hidden — it reads Published
     when the basket is whole. */
  .index-mark {
    font: var(--tsoi-text-byline);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tsoi-color-on-surface-variant);
  }
  .index-status {
    margin: 0;
    font: var(--tsoi-text-byline);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--tsoi-color-you-text);
  }
  .index-time[hidden] { display: none; }
  .index-time {
    margin: 0;
    font: 400 12px var(--tsoi-font-mono);
    letter-spacing: 0.02em;
    color: var(--tsoi-color-on-surface-variant);
  }
  /* Carrying the section on its own, before there is a figure to carry it. */
  .index-status.is-headline { font-size: 15px; }

  /* The bulletin's share trigger — the same quiet outline treatment the
     board's own ShareMenu button wears (components/dashboard/ShareMenu.astro),
     so a reader who has seen that control elsewhere on the site recognizes
     this one. It sits on the summary beside the mark now, so it takes the
     mark's own type and no layout of its own. */
  .index-share[hidden] { display: none; }
  .index-share {
    font: var(--tsoi-text-byline); font-weight: 500; font-size: 10px;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--tsoi-color-primary-text);
    background: transparent; border: 1px solid var(--tsoi-color-outline);
    border-radius: 2px; padding: 4px 10px; cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
  }
  .index-share:hover { border-color: var(--tsoi-color-primary); background: var(--tsoi-color-surface-container-high); }

  /* ── The distribution ─────────────────────────────────────────────────
     The last part of the release, ruled and headed the way the notes under
     the rack are: a sub-section of the bulletin rather than the next thing on
     the page.

     The drawing is written by the script, so its own rules are :global —
     Astro stamps the component id onto both halves of a descendant selector,
     and an injected <svg> carries no id to be stamped. The frame around it is
     ordinary markup and keeps the scope. */
  .board[hidden] { display: none; }
  .board {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: calc(var(--tsoi-spacing-unit) * 1.25);
    border-top: 1px solid var(--tsoi-color-outline);
  }
  .board h3 {
    margin: 0;
    font: var(--tsoi-text-byline);
    font-weight: 500;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tsoi-color-on-surface-variant);
  }
  .board-count,
  .board-rank {
    margin: 0;
    font: 400 12px var(--tsoi-font-mono);
    letter-spacing: 0.02em;
    color: var(--tsoi-color-on-surface-variant);
  }
  /* The one sentence on this section that is about the reader, so it takes
     the ink the reader's own figures take everywhere else. */
  .board-rank[hidden] { display: none; }
  .board-rank { color: var(--tsoi-color-you-text); }
  /* Set a step down from the count it follows: the reading is the count, and
     this is a note on the reading's age. The dotted underline arrives from
     panel-chrome with the data-info, so nothing here draws it.

     And no cursor either. panel-chrome styles every [data-info] the same way
     and sets none, so the other fifteen tooltip triggers on this page leave
     the pointer alone; this one asked for `help` and was the only thing on
     the page wearing a question mark. */
  .board-fresh[hidden] { display: none; }
  .board-fresh {
    margin-left: 10px;
    font-size: 11px;
    color: var(--tsoi-color-on-surface-variant);
    opacity: 0.8;
  }
  .board-fresh:hover { opacity: 1; }
  .board-chart { width: 100%; }
  .board-chart :global(svg) { display: block; width: 100%; }
  /* Chart idiom, which on this site means the distribution is ink and the
     hues are reserved for the two marks that are not data about everybody.
     Same neutral the cartridge sparklines are drawn in.

     One filled step rather than 141 separate bars. At a few hundred filings
     the gap between bars is wider than the bars, so a histogram drawn in
     rects reads as a comb; the same numbers drawn as a continuous step read
     as the shape they are. The outline on top is what keeps a one-play bin
     visible once the peak is a thousand. */
  .board-chart :global(.board-area) { fill: var(--tsoi-color-outline); }
  .board-chart :global(.board-edge) {
    fill: none;
    stroke: var(--tsoi-color-outline);
    stroke-width: 1;
    stroke-linejoin: round;
  }
  .board-chart :global(.board-axis) { stroke: var(--tsoi-color-outline); stroke-width: 1; }
  .board-chart :global(.board-tick) {
    fill: var(--tsoi-color-on-surface-variant);
    font: 400 10px var(--tsoi-font-mono);
    letter-spacing: 0.02em;
  }
  /* Ink is you and saffron is the top of the board. The reader's rule is the
     heavier of the two: this is their page, and the leader is context on it.
     Ink over the distribution stays legible because the distribution is drawn
     in --outline, several steps lighter than --on-surface, in both themes. */
  .board-chart :global(.board-you) { stroke: var(--tsoi-color-you); stroke-width: 2; fill: none; }
  .board-chart :global(.board-you-fig) {
    fill: var(--tsoi-color-you-text);
    font: 500 11px var(--tsoi-font-mono);
    letter-spacing: 0.01em;
  }
  .board-chart :global(.board-top) { stroke: var(--tsoi-color-primary); stroke-width: 1.5; fill: none; }
  .board-chart :global(.board-top-fig) {
    fill: var(--tsoi-color-primary-text);
    font: 400 11px var(--tsoi-font-mono);
    letter-spacing: 0.01em;
  }

  /* The info affordance, matching the dashboards: a dotted underline and
     nothing else. No icon, which is the site's rule, and the same 3px offset
     and variant-coloured dots panel-chrome injects, so a reader who has met
     this on the payments dashboard has already learnt it here.

     Two kinds of trigger wear it — the four reporting column headings, and
     the provisional/published mark beside the figure — and they are the same
     kind of thing: a word on the page that has a definition the page used to
     spell out in prose. One class, so a third never gets invented.

     The tooltip itself is panel-chrome's, one implementation of hover, focus
     and tap-to-toggle rather than a second written for this page. Only the
     trigger's styling lives here, because both of these are set in uppercase
     at 10 and 11px and the injected rule does not know that. */
  .tip {
    text-decoration: underline dotted;
    text-decoration-color: var(--tsoi-color-on-surface-variant);
    text-underline-offset: 3px;
  }
  .era-head .tip:hover,
  .era-head .tip:focus-visible { color: var(--tsoi-color-on-surface); }
  .tip:focus-visible { outline: 2px solid var(--tsoi-color-primary); outline-offset: 2px; }
  /* The mark is already at variant weight beside a 40px figure; lifting it on
     hover the way a heading lifts would read as the figure changing state. It
     answers with its dots instead. */
  .index-mark.tip:hover { text-decoration-color: var(--tsoi-color-on-surface); }


  /* The percentile line on the run-over card, in the same register as the
     event note below it: byline face, variant ink, a remark about the run
     rather than a second result. No rule on the leading edge — that mark
     belongs to the aside about the terrain, and two lines wearing it would
     make the card look ruled.

     It holds one line's height while it is on the card, so a sentence that
     wraps on a phone does not shove the basket down after paint, and none at
     all when there is nothing to say. */
  .card-pct[hidden] { display: none; }
  .card-pct {
    margin: 0;
    min-height: 1.4em;
    font: var(--tsoi-text-byline);
    font-size: 12px;
    line-height: 1.4;
    letter-spacing: 0.01em;
    color: var(--tsoi-color-on-surface-variant);
  }

  /* The index line, in the reader's own colour and set a step up from the
     byline face the percentile line uses: this is a second result, not a
     remark about the first. */
  .card-index[hidden] { display: none; }
  .card-index {
    margin: 0;
    font: 500 13px var(--tsoi-font-mono);
    line-height: 1.4;
    letter-spacing: 0.01em;
    color: var(--tsoi-color-you-text);
  }

  /* The event note on the run-over card. A rule on the leading edge marks it
     as an aside about the run rather than a second result line, which is the
     same move a pull quote makes in the reads. */
  .card-context {
    margin: 0;
    padding-left: 12px;
    border-left: 2px solid var(--tsoi-color-primary);
    font: var(--tsoi-text-byline);
    font-size: 12px;
    line-height: 1.55;
    letter-spacing: 0.01em;
    color: var(--tsoi-color-on-surface-variant);
    text-wrap: pretty;
  }

  /* ── Short screens ────────────────────────────────────────────────────
     The pedal is the only control this game has, and on a 13-inch laptop it
     sat 116px below the fold: a first-time visitor saw a chart and no way to
     drive it. What buys those pixels back, in the order the least is given
     up: the rhythm between the folio, the masthead and the machine, then the
     chart itself. The chart gives up fifty and keeps 350, which is ten above
     the floor the terrain needs to stay readable at Hard.

     Height, not width, because this is a fold problem and a 1280×1000 window
     does not have it. Phones are excluded by the same logic — 390×844 already
     fits, and its canvas is tuned to the run-over card. */
  @media (min-width: 701px) and (max-height: 860px) {
    .peaks { gap: calc(var(--tsoi-spacing-unit) * 1.25); }
    .folio { padding: 0; }
    .masthead { gap: 6px; padding-bottom: var(--tsoi-spacing-unit); }
    canvas { height: 350px; }

    /* A shorter chart is a shorter run-over card, so the card is set as
       tightly here as it is on a phone. Without this a crash beside a flagged
       month — the seventies, most of the time — cut the basket to a ten-pixel
       sliver of its first row, which is the same thing that read as a
       rendering fault the last time this card was tuned. Retry does not move:
       it is outside the scroller and was never the part at risk. */
    .veil { padding: 10px; }
    .card {
      padding: calc(var(--tsoi-spacing-unit) * 1.75) calc(var(--tsoi-spacing-unit) * 2.25);
      gap: 8px;
    }
    .card-scroll { gap: 6px; }
    .actions { padding-top: 10px; }
    /* And the basket set as tightly as the phone sets it, because on a
       cleared run every one of the six has to be reachable without scrolling
       to it — a chip you have to drag into view is not an offer. */
    .next { gap: 5px; }
    .next-list { gap: 5px; }
    .next-item { padding: 4px 7px; }
  }

  /* A second step for the shorter laptops — a 1440×779 window is 21px worse
     off than the 1280×800 the budget was set against. The title takes the
     next size down in the same scale and the chart goes to its floor. */
  @media (min-width: 701px) and (max-height: 799px) {
    h1 {
      font: var(--tsoi-text-headline-lg);
      letter-spacing: var(--tsoi-text-headline-lg-tracking);
    }
    canvas { height: 340px; }
  }

  @media (max-width: 700px) {
    /* Three across on a phone too, so the rack is two rows everywhere and the
       six read as one object. At 105px a card cannot hold a sparkline that
       tall, a name at body size, and two figures side by side, so all three
       give a little: the strip is shorter, the name drops to 12px, and the
       years and the peak stack instead of sitting on one line. */
    .cart { padding: 7px 8px 9px; gap: 4px; }
    .cart-spark { height: 40px; }
    .cart-name { font-size: 12px; line-height: 1.25; }
    .cart-meta { flex-direction: column; gap: 1px; }
    .cart-meta,
    .cart-best { font-size: 10px; }
    /* The slot keeps its shape on a phone — select and sparkline on the left,
       mode switch hard against the right edge — by dropping the two labels
       that are not controls. The dates are in the notes section below and the
       switch is self-evidently a switch. */
    .slot { padding: 8px; gap: 8px; }
    .slot-load .slot-tag,
    .slot-mode .slot-tag { display: none; }
    /* Four things do not fit a 360px bar. The select has to hold the longest
       cartridge name ("The seventies", 94px of text) or it stops saying what
       is loaded, and the mode switch is three buttons wide however it is cut,
       so the map and the readout both slim down: the map to 32px, the
       readout per the block below. */
    .slot-load { gap: 6px; }
    .slot-spark { width: 32px; }
    /* The chevron sits 9px in, so 20px of inset clears it with room; the stock
       24px was sized for a desktop bar that had pixels to spare. */
    .slot-select select { padding-right: 20px; }
    .mode { padding: 5px 5px; }
    /* Quieter over the chart than on a desktop, and for a reason the desktop
       does not have: the phone's chart is a third of the width, so the same
       figure covers three times as much terrain. It is context, not the score
       you are watching, and at this size it stops competing with the drive. */
    .hud { top: 8px; right: 8px; gap: 4px; font-size: 9px; }
    .hud-value { font-size: 13px; }
    /* The readout stays on a phone now that it is live state rather than the
       stretch's dates, but it cannot have the room it takes on a desktop: the
       select, the map and the mode switch are all ahead of it in the queue. So
       it drops the month and keeps the count, which is the half that changes
       every second and the half a player is actually watching. The month is
       still on the chart's own axis, an inch above. */
    .slot-span { font-size: 11px; }
    .slot-span .span-month { display: none; }
    .slot-span .span-count::before,
    .slot-span .span-count::after { content: none; }

    /* Five columns will not fit a phone. Best run and Mode go, in that
       order: the cartridge and the basket chip state both, per era, in
       words. Weight stays because this column is now the only place the
       page states the basket at all — the era notes dropped their Weight
       stat when it stopped being a terrain fact — and a phone that showed
       contributions without the weights they are computed from would be
       asking the reader to take the arithmetic on faith. It also keeps the
       Weight tooltip reachable, which is where the formula lives. */
    .era-head,
    .era-row,
    .era-total { grid-template-columns: 1fr 4.75rem 5.25rem; }

    /* The card's actions stack full width on a phone. They are a wrapping row
       everywhere else and that was fine while there were two of them, but a
       card that clears a stretch can carry the step up to Hard beside Retry,
       and right-aligned buttons of different widths wrap into a ragged
       staircase down the corner of the most important card in the game.
       Stacked, they read as a deliberate list in the order the card is asking
       them, and each becomes a full-width
       target on the device where that matters most. */
    .actions {
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
    }
    .era-head span:nth-child(3),
    .era-head span:nth-child(4),
    .era-row span:nth-child(3),
    .era-row span:nth-child(4),
    .era-total span:nth-child(3),
    .era-total span:nth-child(4) { display: none; }

    /* The month and the rate stack above the sentence rather than shrinking
       a three-column grid into a phone. */
    .events li { grid-template-columns: auto 1fr; }
    .ev-rate { text-align: left; }
    .ev-text { grid-column: 1 / -1; }
    .stats { gap: calc(var(--tsoi-spacing-unit) * 1.75); }
    .stat-v { font-size: 17px; }
    .index-value { font-size: 34px; }
    canvas { height: 370px; }

    /* The run-over card carries a result, a note, an event and the basket,
       which is more than a phone canvas fits however tightly it is set. So:
       set it tightly, and keep the one control that must never be below the
       fold outside the part that scrolls. */
    .veil { padding: 8px; }
    .card {
      padding: 14px 16px;
      gap: 8px;
    }
    .score span:first-child { font-size: 30px; }
    .card-body,
    .card-context { font-size: 12.5px; }
    .next-list { gap: 5px; }
    .next-item { padding: 4px 7px; }
    .card-scroll { gap: 8px; }
    /* Retry hard right, where a thumb already is on a one-handed phone. The
       reordering that used to sit here — Retry above the event note, so that
       Retry stayed on screen — is gone: the action row is outside the
       scroller now, so the card reads in its own order again.

       A sticky footer was tried before either of these and is worse than
       both: pinning Retry over the card hides the last row of the basket for
       good, and the basket is the thing this card was given. */
    .actions { justify-content: flex-end; padding-top: 10px; }
    .actions button { padding: 9px 18px; }
  }
</style>

<script>
  import { createGame, MODES } from '../../lib/play/peaks-engine';
  import type { Game, GameMode, RunEnd, TerrainData, TerrainEra } from '../../lib/play/peaks-engine';
  import { initInfoTooltips } from '../../lib/panel-chrome';
  import { SPARK_H, sparkAt } from '../../lib/play/peaks-spark';

  /* The column definitions, on the same hover/focus/tap machinery the
     dashboards use. Wired before the terrain fetch and outside the guard
     below, because the table is real markup that renders without the engine:
     if the series never arrives, the basket and its weights are still on
     screen and their headings should still explain themselves. */
  initInfoTooltips();

  /* ── The score endpoints ────────────────────────────────────────────────
     Everything below this line is best-effort and the game never waits on any
     of it. A token that does not arrive, a POST that fails, a board that has
     not been aggregated yet: each one degrades to the line or the section
     simply not being there. Nothing here renders a loading state or an error,
     because there is nothing a player would do with either.

     PUBLIC_PLAY_API is a build-time var so a preview deploy can point at a
     staging endpoint; with nothing set, only the real production hostname
     files anything, so localhost runs never reach a histogram. Same gate and
     same reasoning as the other game. */
  const apiBase = import.meta.env.PUBLIC_PLAY_API || '';
  const shouldBeacon = () => !!apiBase || location.hostname === 'timeseriesofindia.com';

  /* No Content-Type header on purpose: application/json would force a CORS
     preflight when apiBase is cross-origin (previews), and the endpoints
     answer OPTIONS with their POST-only 405. A bare POST is a CORS-simple
     request that always sends, and the worker parses the body without
     consulting the header.

     Resolves false rather than throwing, so a caller that cares whether the
     server took it — the filing row does — can ask without a try block, and
     one that does not can ignore it. */
  function post(path: string, body: unknown): Promise<boolean> {
    if (!shouldBeacon()) return Promise.resolve(false);
    return fetch(`${apiBase}${path}`, { method: 'POST', body: JSON.stringify(body), keepalive: true })
      .then((r) => r.ok)
      .catch(() => false);
  }

  /** Null on anything that is not JSON under a 2xx, including the four
   *  seconds this page is willing to wait for one. */
  async function getJson<T>(path: string): Promise<T | null> {
    try {
      const r = await fetch(`${apiBase}${path}`, { signal: AbortSignal.timeout(4000) });
      if (!r.ok) return null;
      return (await r.json()) as T;
    } catch {
      return null;
    }
  }

  /** The aggregated shapes, as far as this page reads them. Everything else
   *  the worker publishes is ignored rather than typed. */
  type PeaksStats = { plays: number; hist: number[] };
  type PeaksBoard = {
    plays: number;
    /** One bin per tenth of an index, 0.0 to 140.0. Everything this panel
     *  says — your mark, the top of the board, your exact position in it — is
     *  read off this one array. */
    hist: number[];
    /** Total-time buckets for the leading players only, nested by score bin:
     *  `{ "1339": { "88": 2, "91": 1 } }`. Absent on a board written before
     *  the table existed, and absent for every score outside the covered
     *  band, which is most of them. */
    times?: Record<string, Record<string, number>>;
    /** When the worker last rebuilt this file. Optional because a board
     *  written before the field existed is still a board. */
    updated_at?: string;
  };

  /** The bin an index falls in, on the board's scale of tenths. */
  const boardBin = (index: number) => Math.max(0, Math.min(1400, Math.round(index * 10)));
  /** The same for a total time, on the table's scale of five seconds. */
  const timeBucket = (secs: number) => Math.max(0, Math.min(1439, Math.floor(secs / 5)));

  /** Counts, grouped the way the rest of the site groups figures. en-IN, so a
   *  board with a hundred thousand filings on it reads 1,00,000 and not
   *  100,000 — the other game and every dashboard already do this, and a
   *  board is not the place to start writing numbers a second way. */
  const grp = (n: number) => n.toLocaleString('en-IN');

  /** 1st, 2nd, 3rd, 342nd. */
  function ordinal(n: number): string {
    const s = ['th', 'st', 'nd', 'rd'];
    const v = n % 100;
    return `${n}${s[(v - 20) % 10] || s[v] || s[0]}`;
  }

  /* A stretch of the series as eight levels of block, for the share texts.
     A shared score is a number somebody else has no scale for; the same score
     with the terrain under it says what the number was up against, and the
     terrain is the one thing this game has that a score screenshot does not.
     Eight levels is what Unicode gives, and it is enough: this is a silhouette
     of a drive, not a chart.

     Sixteen glyphs at most, because the text has to survive a platform that
     wraps at a fixed width, and a wrapped sparkline is a broken picture rather
     than a short one.

     Each glyph is the HIGHEST month in its bucket, not the month that happens
     to land on the stride. Sixteen glyphs across 683 months is one in
     forty-three, and reading every forty-third month stepped straight over
     September 1974: the whole spine came out as a flat row of mid-blocks with
     no peak in it, on a game called Inflation Peaks. Highest ground per bucket
     is a skyline, it cannot miss a spike, and peaks are the subject.

     The caller passes the floor and ceiling rather than the routine taking
     them from the values, and that is the whole reason two players can compare
     these. Normalised to its own run, a crash in a quiet year and a crash in
     1974 draw the identical picture; normalised to the stretch both are
     driving, the same months always come out as the same glyphs. */
  const SPARK_BLOCKS = '▁▂▃▄▅▆▇█';
  const SPARK_GLYPHS = 16;

  /* How many months each glyph stands for, and how many glyphs that makes.
     The row is always this long, whatever the run did. */
  const sparkStep = (n: number) => Math.ceil(n / SPARK_GLYPHS);
  const sparkCells = (n: number) => Math.ceil(n / sparkStep(n));

  /* The months the run never reached, drawn as light shade.

     The row used to BE the run: it was drawn from the months driven, so it
     grew with the score. Two things were wrong with that. A short run drew
     almost nothing — five months of the seventies came out as a single glyph,
     which is not a picture of anything — and the LENGTH of the row was
     carrying the score, which no reader can measure without the full-length
     version beside it to compare against. The row is now a fixed length and
     the run is how much of it is drawn in.

     This was very nearly a second row instead, a ▓░ progress bar under a
     course drawn in full, which is the better design on paper: it keeps the
     unreached terrain visible, and everyone driving the same stretch posts the
     same skyline. It was measured and dropped. The shade characters and the
     block characters do not share an advance width in a proportional font — at
     16px they differ by 32px over sixteen cells in Helvetica and 27px in
     Georgia, matching only in monospace and the system UI stack. So in the
     fonts most shares are actually read in, the bar came out a sixth shorter
     than the course above it and its end pointed at the wrong hill. One row
     cannot be misaligned with itself.

     What it costs is the shape of the ground ahead, and that is the honest
     trade: within a row you can have a height or a shade, not both. */
  const SPARK_UNREACHED = '░';

  /** `reached` is how many cells to draw as terrain; the rest go to shade. */
  function blockSpark(values: number[], lo: number, hi: number, reached = Infinity): string {
    if (!values.length) return '';
    const span = hi - lo || 1;
    const step = sparkStep(values.length);
    let out = '';
    let cell = 0;
    for (let i = 0; i < values.length; i += step, cell++) {
      if (cell >= reached) {
        out += SPARK_UNREACHED;
        continue;
      }
      let peak = -Infinity;
      for (let j = i; j < Math.min(i + step, values.length); j++) {
        if (values[j] > peak) peak = values[j];
      }
      const level = Math.round(((peak - lo) / span) * (SPARK_BLOCKS.length - 1));
      out += SPARK_BLOCKS[Math.min(SPARK_BLOCKS.length - 1, Math.max(0, level))];
    }
    return out;
  }

  /* Both ends are clamped rather than rounded, and for the same reason: at
     sixteen cells over a decade one cell is eight months, so rounding alone
     lets the row tell two lies. A run that moved at all draws a cell, because
     a player who drove five months has not driven none; and a run that did not
     clear leaves a cell shaded, because 123 of 124 rounds to a full row and a
     full row has to mean the stretch was finished. */
  function reachedCells(fraction: number, cells: number): number {
    if (fraction >= 1) return cells;
    if (fraction <= 0) return 0;
    return Math.min(cells - 1, Math.max(1, Math.round(fraction * cells)));
  }

  /* Where you stand, in the terms the number can actually support at that
     size. Three branches and two thresholds, and both thresholds are about
     honesty rather than taste.

     Near the top, a rank is the better fact and the crowd behind it is what
     makes it one: "4th of 5,210" says more than "top 1%" ever could. Twenty
     rather than ten because a tie at the ceiling can swallow ten places on
     its own, and because twenty is about where the next rank up stops being
     someone you can picture overtaking.

     Deep in the pack a rank stops being well defined. The index is rounded to
     a tenth and players bunch: at ten thousand filings 98% of them share a
     figure with somebody, and with no clock left to separate them, "342nd"
     would be a precise position inside a tie block of forty. It would also
     move every time a stranger filed. A percentage claims less and means more.

     And under fifty filings a percentage is invention, which is the same floor
     the run-over card already uses before it will quote one. */
  const RANK_NAMED = 20;
  const PCT_FLOOR = 50;

  /* The same standing, said to two different readers. On the page it is
     addressed to the player, who is looking at their own panel. In a share it
     is being handed to somebody who is not the player, so "you" would name the
     wrong person and the crowd needs a noun of its own: "214th of 1,203" alone
     reads as a bare pair of numbers once it is out of the panel that framed
     it. The percentile branch already names what it is counting, so it needs
     no second version. */
  function rankLine(
    hist: number[],
    bin: number,
    plays: number,
    voice: 'page' | 'share' = 'page',
  ): string {
    if (!(plays > 0) || bin < 0 || bin >= hist.length) return '';
    let above = 0;
    for (let i = bin + 1; i < hist.length; i++) above += Number(hist[i]) || 0;
    const rank = above + 1;
    if (rank <= RANK_NAMED) {
      /* Ties counted rather than labelled. "Joint 1st of 5,206" put the tie
         word in front of the whole phrase, where it could be read as a claim
         about the 5,206 rather than about the handful standing on your tenth.
         Saying how many are level with you cannot be read that way, and it is
         the more interesting number besides.

         Your own entry is in the bin already, so a second occupant is a
         genuine tie. On the very first publish, before the cron has folded you
         in, this reads one short: the conservative direction, and the
         freshness marker beside it is already explaining the lag. */
      const level = Math.max(0, (Number(hist[bin]) || 0) - 1);
      const tie = level > 0 ? `, tied with ${grp(level)} ${level === 1 ? 'other' : 'others'}` : '';
      return voice === 'share'
        ? `${ordinal(rank)} of ${grp(plays)} drivers${tie}.`
        : `You are ${ordinal(rank)} of ${grp(plays)}${tie}.`;
    }
    if (plays < PCT_FLOOR) {
      return voice === 'share'
        ? `${ordinal(rank)} of ${grp(plays)} drivers.`
        : `You are ${ordinal(rank)} of ${grp(plays)}.`;
    }
    const pct = midpointPct(hist, bin, plays);
    return pct == null ? '' : `Higher than ${pct}% of filed indexes.`;
  }

  /* And then the clock, which is what is left to say once the score has
     stopped saying anything. The index saturates and duration does not, so
     this is the sentence that still has somewhere to go after a player has
     driven everything on Hard.

     Only for the leading thousand, because that is the only place the worker
     keeps the table and the only place it works: further down, the popular
     scores hold hundreds of people whose totals sit inside a few seconds of
     each other, and no bucket width separates them. A score the table does
     not hold simply gets no second sentence. */
  function clockLine(cell: Record<string, number> | null | undefined, bucket: number | null): string {
    if (!cell || bucket == null) return '';
    let faster = 0;
    let total = 0;
    for (const [k, n] of Object.entries(cell)) {
      const c = Number(n) || 0;
      total += c;
      if (Number(k) < bucket) faster += c;
    }
    // Alone at your score: the line above found nobody level with you, so
    // there is nobody here to be faster than.
    if (total < 2) return '';
    /* Your own run is in the table, so another in your own bucket is a tie on
       the clock too, because five seconds apart over a whole basket is the
       same drive. Before the fold this reads one short, the same way the line
       above it does, and settles on the next rebuild. */
    const tied = (Number(cell[String(bucket)]) || 0) > 1;
    /* The crowd must be able to hold the position. Between filing and the next
       fold you are not in this cell, and if you are also the slowest in it
       then faster counts every entry there is: the honest reading of that is
       one more person than the table knows about, and without the clamp it
       printed "5th fastest of the 4", which is not a thing. Mid-cell the same
       gap simply reads one short, which is the direction the rest of the
       pre-fold wording already errs in. */
    const crowd = Math.max(total, faster + 1);
    const place = faster === 0
      ? (tied ? 'Tied fastest' : 'Fastest')
      : `${tied ? 'Tied ' : ''}${ordinal(faster + 1)} fastest`;
    return `${place} of the ${grp(crowd)} at that score.`;
  }

  /** The best anyone has filed: the highest bin with anything in it. Null on
   *  a board with nothing on it yet. */
  function topIndexOf(hist: number[]): number | null {
    for (let i = hist.length - 1; i >= 0; i--) if ((Number(hist[i]) || 0) > 0) return i / 10;
    return null;
  }

  /** Everything below you plus half of everything level with you, over the
   *  whole population — the midpoint method the other game's percentile line
   *  uses, and for the same reason: a bin you are standing in should not count
   *  entirely for or against you. Clamped off both ends, because a histogram
   *  that contains your own run cannot honestly say 100%. */
  function midpointPct(hist: number[], bin: number, plays: number): number | null {
    if (!(plays > 0) || bin < 0 || bin >= hist.length) return null;
    let below = 0;
    for (let i = 0; i < bin; i++) below += Number(hist[i]) || 0;
    const at = Number(hist[bin]) || 0;
    return Math.max(1, Math.min(99, Math.round((100 * (below + at / 2)) / plays)));
  }

  /* ── Share ─────────────────────────────────────────────────────────────
     Plain text, read-only, the same two behaviours the other game's finale
     uses (OffByHowMuch's buildShareText/copy flow): the OS sheet where the
     platform has one, else the clipboard with a label that says what
     happened. No network compose page, no image, no POST anywhere — this
     only quotes a figure already on screen. */
  const canShare = typeof navigator.share === 'function';
  async function copyToClipboard(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      // Async clipboard denied/unavailable: the same off-screen textarea
      // fallback OffByHowMuch's finale uses.
      try {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        const ok = document.execCommand('copy');
        ta.remove();
        return ok;
      } catch {
        return false;
      }
    }
  }
  /** Wires one share/copy button. `getText` is asked fresh on every click,
   *  since both callers' state (a run just ended; the index bulletin) moves
   *  under the button between clicks — an empty result means there is
   *  nothing yet worth sharing, and the click does nothing. */
  function wireShare(btn: HTMLButtonElement, getText: () => string) {
    const label = btn.textContent || 'Share';
    let timer: number | undefined;
    btn.addEventListener('click', async () => {
      const text = getText();
      if (!text) return;
      if (canShare) {
        try {
          await navigator.share({ text });
          return; // the sheet itself was the feedback; a cancel needs none
        } catch (err) {
          if (err instanceof DOMException && err.name === 'AbortError') return;
          // anything else (rare share failures): fall through to the clipboard
        }
      }
      const ok = await copyToClipboard(text);
      if (timer) clearTimeout(timer);
      btn.textContent = ok ? 'Copied to clipboard' : 'Couldn’t copy';
      timer = window.setTimeout(() => { btn.textContent = label; }, 2200);
    });
  }

  const canvas = document.getElementById('peaks-canvas') as HTMLCanvasElement | null;
  const stage = document.getElementById('peaks-stage');
  const srcEl = document.getElementById('peaks-src');

  /* The terrain is 683 months of observations and it arrives over the
     network, so nothing below can run until it does. Everything the game
     needs is in that one file; if it does not come, the page says so plainly
     rather than leaving a dead bar under an empty chart. */
  if (canvas && stage && srcEl) {
    // Narrowed once here: boot() runs after a fetch, and TypeScript will not
    // carry a null check across that boundary on its own.
    const cv: HTMLCanvasElement = canvas;
    const stageEl: HTMLElement = stage;
    const waitEl = document.getElementById('peaks-wait')!;
    const pedal = document.getElementById('peaks-pedal') as HTMLButtonElement;

    fetch(srcEl.dataset.src!)
      .then((r) => {
        if (!r.ok) throw new Error(`${r.status} ${r.statusText}`);
        return r.json();
      })
      .then((terrain: TerrainData) => boot(terrain))
      .catch((err) => {
        console.error('[peaks] terrain failed to load', err);
        // The pedal stays disabled, so this is the label that shows.
        waitEl.textContent = 'The series did not load. Reloading usually fixes it.';
      });

  function boot(terrain: TerrainData) {
    const veil = document.getElementById('peaks-veil')!;
    const hud = document.getElementById('peaks-hud')!;
    const hudIndexEl = document.getElementById('peaks-hud-index')!;
    const endKicker = document.getElementById('peaks-end-kicker')!;
    const endTitle = document.getElementById('peaks-end-title')!;
    const endMonths = document.getElementById('peaks-end-months')!;
    const endTime = document.getElementById('peaks-end-time') as HTMLElement;
    const endNote = document.getElementById('peaks-end-note')!;
    const endContext = document.getElementById('peaks-end-context')!;
    const endPctEl = document.getElementById('peaks-end-pct') as HTMLElement;
    const cardScrollEl = document.getElementById('peaks-card-scroll') as HTMLElement;
    const nextEl = document.getElementById('peaks-next') as HTMLElement;
    const nextHeadEl = document.getElementById('peaks-next-head')!;
    const retryBtn = document.getElementById('peaks-retry') as HTMLButtonElement;
    const stepBtn = document.getElementById('peaks-step') as HTMLButtonElement;
    const endIndexEl = document.getElementById('peaks-end-index') as HTMLElement;
    const endShareBtn = document.getElementById('peaks-end-share') as HTMLButtonElement;
    const indexShareBtn = document.getElementById('peaks-index-share') as HTMLButtonElement;
    /* What the step-up button is currently offering. Held rather than
       recomputed on click, so the button always does what it says. */
    let pendingStep: { era: TerrainEra; mode: GameMode } | null = null;
    const fpsEl = document.getElementById('peaks-fps')!;
    const slotMonthEl = document.getElementById('peaks-slot-month')!;
    const slotCountEl = document.getElementById('peaks-slot-count')!;
    const eraSelect = document.getElementById('peaks-era-select') as HTMLSelectElement;
    const slotSparks = [...document.querySelectorAll<HTMLElement>('[data-slot-spark]')];
    const sparkDots = [...document.querySelectorAll<HTMLElement>('[data-spark-dot]')];

    /* The sparkline's own floor and ceiling: the whole spine, not the loaded
       stretch, because all six cards are drawn on one vertical scale so the
       seventies visibly tower over the rest. The dot has to use the same pair
       or it would ride above and below its own line. */
    const sparkLo = Math.min(...terrain.points.map((p) => p.yoy));
    const sparkHi = Math.max(...terrain.points.map((p) => p.yoy));

    /** Where the run has got to, said twice on the same bar: as a dot on the
     *  map, and as the month it is standing in. `null` is "nothing driven yet"
     *  — the dot goes away and the readout falls back to the start line.
     *
     *  Both halves are here rather than in two handlers because they are one
     *  fact, and a page that reported it in two places from two callbacks
     *  would eventually report it inconsistently. */
    function markProgress(m: number | null): void {
      const at = m ?? 0;
      for (const dot of sparkDots) {
        if (dot.parentElement?.dataset.slotSpark !== era.id || m == null) {
          dot.hidden = true;
          continue;
        }
        const t = at / Math.max(1, slice.points.length - 1);
        const y = sparkAt(slice.points.map((p) => p.yoy), sparkLo, sparkHi, t);
        dot.style.left = `${(t * 100).toFixed(2)}%`;
        dot.style.top = `${((y / SPARK_H) * 100).toFixed(2)}%`;
        dot.hidden = false;
      }
      /* The month you are actually in, not a count of months driven, because
         the terrain under the auto is a real date and the whole game is that
         those two are the same thing. The count follows in brackets, since a
         score still has to be a score. */
      const p = slice.points[Math.min(at, slice.points.length - 1)];
      slotMonthEl.textContent = shortMonth(p.ym);
      slotCountEl.textContent = `${at}/${clearTarget()}`;
    }

    let live = false;
    /* The run the end-card share button quotes. Set in onEnd, read at click
       time — a run's months are not known until it has actually ended. */
    let lastEnd: RunEnd | null = null;

    pedal.disabled = false;

    const COPY = {
      crash: { kicker: 'Run over', title: 'You crashed.' },
      cleared: { kicker: 'Run over', title: 'You cleared it.' },
    };

    /* Where the run ended, in the terms the terrain is made of: a real month
       and what inflation was actually running at. The score is a month count,
       so the month it lands on is the one the player reached. */
    const MONTHS_LONG = ['January', 'February', 'March', 'April', 'May', 'June',
      'July', 'August', 'September', 'October', 'November', 'December'];
    const monthName = (ym: string) => `${MONTHS_LONG[+ym.slice(5) - 1]} ${ym.slice(0, 4)}`;
    /* The short form, for the one place a date sits beside a control rather
       than inside a sentence. Same list the chart's axis uses. */
    const MONTHS_SHORT = MONTHS_LONG.map((m) => m.slice(0, 3));
    const shortMonth = (ym: string) => `${MONTHS_SHORT[+ym.slice(5) - 1]} ${ym.slice(0, 4)}`;

    /* One line on a clear, two on a crash, and the difference is not brevity
       for its own sake. A crash card has to say where you died, because that
       is the only place the run's shape is reported. A cleared one already
       says it in the heading and the month count above, so restating "you
       drove it end to end" is the card telling you what you just watched —
       and the basket underneath is what the card is actually for. */
    function whereItEnded(months: number, outcome: 'crash' | 'cleared'): string {
      const p = slice.points[Math.min(months, slice.points.length - 1)];
      const when = monthName(p.ym);
      return outcome === 'cleared'
        ? `The last month was ${when}, at ${p.yoy.toFixed(1)}%.`
        : `You crashed in ${when}. Inflation: ${p.yoy.toFixed(1)}%.`;
    }

    /* The second line, when the run ended somewhere that meant something.
       Six months either side: close enough that the event is what the player
       was driving through, far enough that the big ones are not missed by a
       month. The nearest annotation wins, so a crash between two flagged
       events gets the one it is actually closer to rather than the first in
       the file. */
    const NEAR_MONTHS = 6;
    const annotations = terrain.annotations ?? [];

    function contextFor(ym: string): string {
      const i = ymIndex(ym);
      let best: { d: number; text: string; label: string } | null = null;
      for (const a of annotations) {
        const d = Math.abs(ymIndex(a.ym) - i);
        if (d <= NEAR_MONTHS && (!best || d < best.d)) best = { d, text: a.text, label: a.label };
      }
      if (!best) return '';
      // "That month" only when it is; otherwise name the month being referred
      // to, so the sentence never implies the event happened where you died.
      return best.d === 0 ? best.text : `${best.label}: ${best.text}`;
    }

    const ymIndex = (ym: string) => +ym.slice(0, 4) * 12 + (+ym.slice(5) - 1);

    /* ── Era and mode ───────────────────────────────────────────────────
       An era is not a mode of the engine, it is a shorter terrain: the
       engine already treats terrain.points as the whole run, so slicing the
       spine gives correct month counts, a correct finish line, an axis that
       starts where the era starts, and peak labels measured against the era
       rather than the century. Changing either choice therefore means
       building a new game, which is why the handle is a let. */
    const eras = terrain.eras!;
    /* Which cartridge is in the machine on arrival is decided by the markup,
       which has already rendered it as the pressed one. Reading it back is a
       line of code; keeping a second copy of the rule here would be a second
       thing to get wrong. */
    const preloaded = document.querySelector<HTMLElement>('.cart[aria-pressed="true"]')?.dataset.era;
    let era: TerrainEra = eras.find((e) => e.id === preloaded) ?? eras[0];
    let mode: GameMode = MODES[1];
    let slice: TerrainData;
    // Assigned by build(), which runs before anything below can fire.
    let game: Game | undefined;

    function sliceFor(e: TerrainEra): TerrainData {
      const from = terrain.points.findIndex((p) => p.ym === e.from);
      const to = terrain.points.findIndex((p) => p.ym === e.to);
      return { ...terrain, points: terrain.points.slice(from, to + 1) };
    }

    /** What a full clear of the current era scores: the one denominator the
     *  HUD and the index both have to agree on. */
    const clearTarget = () => slice.points.length - 1;

    /* The run-over card's share text, in four lines: what was being driven,
       how far it got, what it came to, and where to try it.

       The glyph row is the reason this is not one line. Everything else here
       is a figure somebody else has no feel for — 43 of 120 months could be an
       easy stretch badly driven or a brutal one survived — and the row is the
       terrain those months actually were. It is also the only part of the game
       that travels: a score is a claim, a silhouette is evidence. The row is
       always the full stretch, so the shaded tail is the score said a second
       way and two runs are comparable at a glance.

       "Survived" reads true on a clear too: a clear is surviving every month
       there was. The end sentence is re-personed from the card's own, which
       says "you crashed" to the player sitting in front of it; in a share the
       reader is somebody else and the sentence is about a third person. */
    function endShareText(): string {
      if (!lastEnd) return '';
      const eraName = era.label.replace(/^The /, 'the ');
      const ys = slice.points.map((p) => p.yoy);
      const reached = reachedCells(lastEnd.months / clearTarget(), sparkCells(ys.length));
      const drive = blockSpark(ys, Math.min(...ys), Math.max(...ys), reached);
      const p = slice.points[Math.min(lastEnd.months, slice.points.length - 1)];
      const ended = lastEnd.outcome === 'cleared'
        ? `Drove it end to end, last month ${shortMonth(p.ym)} at ${p.yoy.toFixed(1)}%.`
        : `Crashed in ${shortMonth(p.ym)}, inflation at ${p.yoy.toFixed(1)}%.`;
      return [
        `🛺 Inflation Peaks · ${eraName} · ${mode.label}`,
        drive,
        `Survived ${lastEnd.months} of ${clearTarget()} months. ${ended}`,
        `See how far you get: ${location.href}`,
      ].join('\n');
    }
    wireShare(endShareBtn, endShareText);

    /** The same figure for any era, without building its slice. Monthly
     *  readings bound one fewer month of driving than there are readings. */
    const targetOf = (e: TerrainEra) => e.months - 1;

    /* ── Bests and the index ────────────────────────────────────────────
       Local only in M2: one record per browser, holding a best per era and
       mode plus a random client id. The id is not identity and is not meant
       to be one: it exists so the board can tell a player who has improved
       from a player who is new, and so a browser is one point on the curve
       rather than one per visit. Nothing derived from a filing carries it. */
    const STORE_KEY = 'tsoi-peaks-v1';
    /* `time` holds the duration of the run `best` is counting, on the same
       era:mode keys, and the two are written together. It is optional on read
       rather than versioned: a record written before it existed is a record
       with no times yet, which is exactly what an absent object means. So is
       a key present in `best` and missing from `time` — a run recorded back
       when only clears were clocked. Both read as "unknown", and the first
       run at equal distance replaces them. */
    type Store = {
      pid: string;
      best: Record<string, number>;
      time?: Record<string, number>;
    };

    function loadStore(): Store {
      try {
        const raw = localStorage.getItem(STORE_KEY);
        if (raw) {
          const s = JSON.parse(raw) as Store;
          if (s && typeof s.pid === 'string' && s.best) {
            if (!s.time) s.time = {};
            return s;
          }
        }
      } catch {
        // Private browsing, a full quota, a user who clears storage: all fine.
        // Scores are a convenience, and the game does not depend on them.
      }
      return { pid: newPid(), best: {}, time: {} };
    }

    function newPid(): string {
      return typeof crypto?.randomUUID === 'function'
        ? crypto.randomUUID()
        : `p${Math.random().toString(36).slice(2)}${Date.now().toString(36)}`;
    }

    const store = loadStore();
    const bestKey = (eraId: string, modeId: string) => `${eraId}:${modeId}`;

    function saveStore() {
      try {
        localStorage.setItem(STORE_KEY, JSON.stringify(store));
      } catch {
        /* see loadStore */
      }
    }

    /** Records a run and reports whether it beat what was there. Better means
     *  further, or the same distance in less time.
     *
     *  Distance and time used to be kept independently, each taking its own
     *  best: months from any run, seconds from the fastest clear. That made
     *  the clock uncompetable. A player who drove the nineties to 74 months
     *  again, ten seconds faster, had the run thrown away — not more months,
     *  so not better — and could watch the board tell them time was what held
     *  them back while the page refused to record a faster one.
     *
     *  So the two move in lockstep. The stored time is the time OF the
     *  counting run, never the minimum over all runs: under a universal clock
     *  a two-second crash at month three is the fastest run anybody will ever
     *  drive, and it must not become their time. */
    function recordRun(months: number, secs: number): boolean {
      const k = bestKey(era.id, mode.id);
      const times = (store.time ??= {});
      const had = store.best[k];
      const hadSecs = times[k];
      const better = had == null
        || months > had
        // An equal run with no time on record beats it: an unknown time is
        // not a fast one, and every run from here carries one.
        || (months === had && (hadSecs == null || secs < hadSecs));
      if (!better) return false;
      store.best[k] = months;
      times[k] = secs;
      saveStore();
      return true;
    }

    /** m:ss. Rounded to the second before splitting, so 59.7s is 1:00 and
     *  never 0:60. */
    function fmtTime(secs: number): string {
      const t = Math.round(secs);
      return `${Math.floor(t / 60)}:${String(t % 60).padStart(2, '0')}`;
    }

    /* ── Filing the run ─────────────────────────────────────────────────
       Two requests open with every run and both are read when it ends: a
       token, which is what lets the server believe the run happened, and the
       stretch's aggregated runs, which is what the percentile line is
       computed from.

       The token is fetched at the start of the run and not before, because
       its age is the whole of the server's plausibility check — a token
       minted on page load would vouch for a run that had not begun. One in
       flight at a time, since a token belongs to a run and there is only ever
       one of those.

       Fetching the stats at the same moment is not an optimisation of the
       network, it is what keeps the card still: by the time a run ends the
       answer has long arrived, so the line paints with the card rather than
       arriving a moment after it and pushing the basket down. */
    type Filing = {
      era: string;
      mode: string;
      token: Promise<string | null>;
      stats: Promise<PeaksStats | null>;
    };
    let filing: Filing | null = null;
    /* Which run's card is on screen. A run started before a slow response
       comes back must not have the previous run's line written onto it. */
    let endSeq = 0;

    function openFiling() {
      if (!shouldBeacon()) {
        filing = null;
        return;
      }
      /* The era and mode are held rather than read again at the end, so a run
         files against the stretch it was actually driven on whatever the slot
         bar says by then. */
      filing = {
        era: era.id,
        mode: mode.id,
        token: getJson<{ token?: unknown }>('/api/peaks-token').then((j) =>
          typeof j?.token === 'string' ? j.token : null,
        ),
        stats: getJson<PeaksStats>(`/api/peaks-stats/${era.id}-${mode.id}.json`),
      };
    }

    /** Files the run that just ended and writes the percentile line, or does
     *  neither, which is the whole of the failure handling. A token that never
     *  arrived means this run files nothing. */
    function closeFiling(months: number) {
      const f = filing;
      filing = null;
      const seq = ++endSeq;
      endPctEl.textContent = '';
      endPctEl.hidden = true;
      if (!f) return;
      f.token.then((token) => {
        if (token) post('/api/peaks-run', { era: f.era, mode: f.mode, months, token });
      });
      f.stats.then((stats) => {
        if (seq !== endSeq) return;
        /* One measurement to a card, and the index outranks the stretch when
           both have something to say. A run that moved the score has already
           been placed against everybody who has ever filed one; following that
           with where it stands among the runs on this one stretch is the same
           reader measured twice, in units that invite comparing. The stretch
           line is what the far commoner card gets — the run that changed
           nothing — and there it is the only measurement there is.

           Both lines are written in the frame the card appears, this one a
           beat later off a promise, so the index line is already up or already
           hidden by the time this asks. */
        if (!endIndexEl.hidden) return;
        const line = percentileLine(stats, months);
        endPctEl.textContent = line;
        endPctEl.hidden = !line;
      });
    }

    /** Where this run stands among the ones already filed on the stretch.
     *
     *  Two forms, and the threshold between them is about what the sample can
     *  support. Above fifty runs a percentage is a fair summary of a
     *  distribution. Below it a percentage is invention, so the line counts
     *  instead: "longer than 9 of the 15 runs filed here" claims nothing about
     *  a population, and every number in it is one you could go and check.
     *
     *  It used to say "Among the first 15 runs filed on this stretch" under
     *  the threshold, which was a fact about the board's age rather than about
     *  the run — it read the same whether you drove four months or a hundred
     *  and eighteen. And it was not a brief phase: the fifty is per stretch AND
     *  per mode, eighteen counters, most of which may never reach it. A line
     *  that sits in the card's one measurement slot has to measure something. */
    function percentileLine(stats: PeaksStats | null, months: number): string {
      if (!stats || !Array.isArray(stats.hist) || !(stats.plays > 0)) return '';
      const plays = stats.plays;
      if (plays >= 50) {
        const pct = midpointPct(stats.hist, months, plays);
        return pct == null ? '' : `Further than ${pct}% of runs on this stretch.`;
      }
      /* Runs strictly shorter than this one. A run in the same bin is neither
         beaten nor beating, which is the same tie rule the percentile's
         midpoint method applies, stated the blunt way a count has to. The
         histogram was fetched when this run started, so it holds the runs
         before it and not the run itself. */
      let below = 0;
      for (let i = 0; i < months && i < stats.hist.length; i++) below += Number(stats.hist[i]) || 0;
      if (plays === 1) {
        return below === 1
          ? 'Longer than the only other run filed here.'
          : 'The only other run filed here went further.';
      }
      /* The bottom of the board, said as a fact about the board. It used to
         read "All 2 runs filed here went further", which is not English at
         two and is a verdict at twenty: its sibling line leads with what you
         did, and this one led with how many people had beaten you. The count
         was the part that stung, because the count is what quantifies it. */
      if (below === 0) return 'Every run filed here so far went further.';
      if (below === plays) return `Longer than all ${grp(plays)} runs filed here.`;
      return `Longer than ${grp(below)} of the ${grp(plays)} runs filed here.`;
    }

    const indexEl = document.getElementById('peaks-index')!;
    const indexStatusEl = document.getElementById('peaks-index-status')!;
    const indexValueEl = document.getElementById('peaks-index-value') as HTMLElement;
    const indexMarkEl = document.getElementById('peaks-index-mark') as HTMLElement;
    const indexTimeEl = document.getElementById('peaks-index-time') as HTMLElement;
    const totalContribEl = document.getElementById('peaks-total-contrib')!;

    /* ── What a run is worth ────────────────────────────────────────────
       One basket, not three. Bests are still kept per era and mode — every
       run you have made is still remembered — but the index takes the best
       one of them per era whatever mode it was set on, and credits it by
       that mode's exaggeration.

       The credit is not a number invented for scoring: exaggeration is how
       much taller the same months were made, so a stretch driven on Hard was
       1.4 times the climb the true scale asks for and is worth 1.4 times as
       much of it. Clearing everything on Medium is exactly 100.0, which is
       the property worth keeping; Easy alone caps you at 60 and the way to
       raise it is to go back and drive the same era harder.

       The version this replaces keyed the whole basket on the current mode,
       so a player who drove the seventies on Easy and the nineties on Hard
       published nothing, ever — which is exactly the behaviour six eras in a
       rack invite. */
    type Counting = { months: number; mode: GameMode; credit: number; secs: number | null };

    function counting(e: TerrainEra): Counting | null {
      let best: Counting | null = null;
      for (const m of MODES) {
        const k = bestKey(e.id, m.id);
        const months = store.best[k];
        if (months == null) continue;
        const credit = (months / targetOf(e)) * m.exaggeration;
        if (!best || credit > best.credit) {
          best = { months, mode: m, credit, secs: store.time?.[k] ?? null };
        }
      }
      return best;
    }

    /* ── What is left to gain ───────────────────────────────────────────
       There is no state called "finished on Medium" and there should not be.
       The index was three per-mode baskets once, and a player who drove the
       seventies on Easy and the nineties on Hard published nothing at all,
       which is why it became one basket taking each era's best run at that
       run's mode credit. Reintroducing a per-mode milestone would put that
       back.

       Headroom does not care what anything was driven on. Each era's counted
       run earns a credit; the ceiling is the top mode's exaggeration; the
       difference is what is still on the table, and it is defined however
       mixed the six are. */

    /** The next mode up from whatever counts for this era, or null when the
     *  era is not cleared yet or is already counted at the top mode. */
    function stepUp(e: TerrainEra): GameMode | null {
      const run = counting(e);
      if (!run || run.months < targetOf(e)) return null;
      const i = MODES.indexOf(run.mode);
      return i >= 0 && i < MODES.length - 1 ? MODES[i + 1] : null;
    }

    /* Which one to offer. Not the biggest gain: weight is how far the rate
       moved, so the heaviest stretch is also the roughest one, and after a
       clean Medium sweep the largest gain by a wide margin is the seventies.
       Pointing a player who has just finished at the wall is arithmetically
       right and a poor invitation. It was a poor invitation under the old
       weights too, for the opposite reason; this is not a rule that changed
       when they did.
       So, the cheapest rung. Lowest step first, which puts any era still
       counted on Easy ahead of one already on Medium, and within a step the
       calmest terrain — the era whose own range is narrowest. The bulletin
       prints weight and contribution for anyone who would rather optimise. */
    function nextStep(): { era: TerrainEra; mode: GameMode } | null {
      let best: { era: TerrainEra; mode: GameMode; rung: number; range: number } | null = null;
      for (const e of eras) {
        const m = stepUp(e);
        if (!m) continue;
        const rung = MODES.indexOf(m);
        const range = e.peak - e.trough;
        if (!best || rung < best.rung || (rung === best.rung && range < best.range)) {
          best = { era: e, mode: m, rung, range };
        }
      }
      return best;
    }

    /* Newest first, which is the order the select, the rack, the bulletin and
       the basket are all printed in. Derived rather than passed, because the
       markup derives it the same way from the same array and two copies of an
       ordering rule is one too many. */
    const rackOrder = [...eras].sort((a, b) => (a.from < b.from ? 1 : -1));

    /** The one stretch the card points at, and the mode to drive it on.
     *
     *  There was no such function before, and the gap showed: the basket
     *  outlined whichever cartridge was loaded, which right after a clear is
     *  the stretch you have just finished. The card congratulated you and
     *  then pointed back at the thing you were done with, while the only
     *  actual recommendation on the page — the step up — appeared at the very
     *  last stage of the game and nowhere before it.
     *
     *  So one recommendation, in three stages, and the chip and the button
     *  both read from it. A card that highlights one stretch and offers
     *  another is a card arguing with itself.
     *
     *  Never driven comes first, and in rack order rather than by any measure
     *  of worth: a player with empty slots is being introduced to a series,
     *  and the series has an order. Then the stretch closest to clearing,
     *  because a basket wants filling before it wants improving and the
     *  cheapest win is the best invitation. Only when all six are cleared
     *  does `nextStep` take over, which is the case it was written for. */
    function recommend(): { era: TerrainEra; mode: GameMode } | null {
      const fresh = rackOrder.find((e) => !counting(e));
      // Nothing on record for this one, so nothing to improve and no mode to
      // inherit: it goes on whatever switch is already set.
      if (fresh) return { era: fresh, mode };
      /* On the counting run's OWN mode, which is the whole of the offer here
         and was the bug when it was not.
         An era is short when the run that counts for it is short, and the run
         that counts is the highest credit, not the highest month count. Clear
         the 2020s on Medium while a 69/77 on Hard is on record and the Hard
         run still counts: 69/77 × 1.4 beats 77/77 × 1.0. The era correctly
         reads as eight months short — and the card then offered to drive it on
         Medium, where the best available run was already on record and already
         worth less. Following the recommendation changed nothing at all.
         So the mode comes off the run being improved. The button says "on
         Hard", which is both the true offer and the thing that stops it
         reading as an invitation to repeat what you have just done. */
      let near: { era: TerrainEra; mode: GameMode; short: number } | null = null;
      for (const e of rackOrder) {
        const run = counting(e)!;
        const short = targetOf(e) - run.months;
        if (short <= 0) continue;
        if (!near || short < near.short) near = { era: e, mode: run.mode, short };
      }
      if (near) return { era: near.era, mode: near.mode };
      return nextStep();
    }

    /** Eras with no cleared run on record, in any mode. */
    const notCleared = () =>
      eras.filter((e) => {
        const run = counting(e);
        return !run || run.months < targetOf(e);
      }).length;

    /** Every reporting era's contribution, printed to one decimal, rounded so
     *  the column adds up to the figure it is printed under.
     *
     *  Rounding each cell on its own does not do that. Six cells at one
     *  decimal can miss their own sum by a tenth — 22.7, 31.7, 20.7 and 12.1
     *  make 87.2 under a headline of 87.3 — and a table whose entire claim is
     *  that it sums to the headline cannot be off by a tenth. So the residual
     *  is handed out by largest remainder, the method a statistical office
     *  uses for exactly this: floor every cell, then give the spare tenths to
     *  the cells that were cut closest to rounding up. No cell moves further
     *  than plain rounding was already free to move it, and the column is
     *  exact against the total.
     *
     *  Returns tenths, not the printed string, so the caller can still tell an
     *  era that reported zero from one that did not report. */
    function contributions(covered: number): Map<string, number> {
      const exact = new Map<string, number>();
      let total = 0;
      for (const e of eras) {
        const run = counting(e);
        if (!run) continue;
        const v = (100 * e.weight * run.credit) / covered;
        exact.set(e.id, v);
        total += v;
      }
      const out = new Map<string, number>();
      const rema: { id: string; frac: number }[] = [];
      let floored = 0;
      for (const [id, v] of exact) {
        const t = Math.floor(v * 10);
        out.set(id, t);
        floored += t;
        rema.push({ id, frac: v * 10 - t });
      }
      rema.sort((a, b) => b.frac - a.frac);
      const spare = Math.round(total * 10) - floored;
      for (let i = 0; i < spare && i < rema.length; i++) {
        out.set(rema[i].id, out.get(rema[i].id)! + 1);
      }
      return out;
    }

    function paintIndex() {
      /* The weight of the components that have reported, worked out before
         anything is printed because every contribution is stated as a share
         of it. Dividing by it is what puts a partial basket on the same scale
         as a whole one, and since the six weights sum to 1 it is a no-op once
         all six are in: the provisional figure and the published one are the
         same arithmetic, not two scores that swap places at the end.

         It used to be accumulated in the loop below and applied afterwards,
         to the sum only. That put the division between the table and the
         figure, where a reader cannot see it, and left a column headed
         Contributes holding numbers that did not add up to anything on the
         page. Doing it first costs a second pass over six eras and buys a
         table that sums to its own headline. */
      let covered = 0;
      for (const e of eras) if (counting(e)) covered += e.weight;
      const contrib = contributions(covered);

      let reporting = 0;
      /* Kept in tenths and divided once at the end. Adding 22.8 + 31.7 + 20.7
         + 12.1 as doubles lands on 87.30000000000001, which survives toFixed
         and is still not what the total line and the headline should be
         agreeing on. Integers cannot drift. */
      let sumTenths = 0;
      /* The clock the board ranks on: the six counting runs added up, which
         exists as soon as all six carry a time. `allClear` is a separate fact
         and only decides the wording — a total across six clears is worth
         saying differently from a total across a basket still being built. */
      let allClear = true;
      let allTimed = true;
      /* Cleared on the hardest mode, all six: the one state the index cannot
         be improved out of. It decides a single sentence, and that sentence
         has to exist, because the published mark otherwise promises a better
         run will raise a figure that has nowhere left to go. */
      let allTopped = true;
      let totalSecs = 0;
      for (const e of eras) {
        const target = targetOf(e);
        const run = counting(e);
        const bestCell = document.querySelector(`[data-best="${e.id}"]`)!;
        const modeCell = document.querySelector(`[data-on-mode="${e.id}"]`)!;
        const contribCell = document.querySelector(`[data-contrib="${e.id}"]`)!;
        const cartCell = document.querySelector(`[data-cart-best="${e.id}"]`)!;
        const nextCell = document.querySelector(`[data-next-prog="${e.id}"]`)!;
        if (!run) {
          /* Empty, not an em dash. The three reporting columns are asking to
             be filled; a dash in each says "missing" six times over and turns
             a basket into a form. The cartridge and the basket chip below
             still say it in words, because there the row IS the component
             and has room for a sentence. */
          bestCell.textContent = '';
          modeCell.textContent = '';
          contribCell.textContent = '';
          cartCell.textContent = 'Never driven';
          nextCell.textContent = 'Not driven';
          bestCell.classList.remove('has-run');
          contribCell.classList.remove('has-run', 'is-clear');
          cartCell.classList.remove('has-run', 'is-clear');
          nextCell.classList.remove('has-run', 'is-clear');
          allClear = false;
          allTimed = false;
          allTopped = false;
          continue;
        }
        reporting++;
        // Tenths, already reconciled against the total by `contributions`.
        const tenths = contrib.get(e.id)!;
        sumTenths += tenths;
        const cleared = run.months >= target;
        if (!cleared) allClear = false;
        if (run.secs == null) allTimed = false;
        else totalSecs += run.secs;
        bestCell.textContent = `${run.months}/${target}`;
        modeCell.textContent = run.mode.label;
        contribCell.textContent = (tenths / 10).toFixed(1);
        // The clock rides both readings now, not the clear alone: it is what
        // separates two players who reached the same month, so a cartridge
        // that reports the run has to report the whole of it.
        const clock = run.secs == null ? '' : ` · ${fmtTime(run.secs)}`;
        cartCell.textContent = cleared
          ? `Cleared on ${run.mode.label}${clock}`
          : `Best ${run.months} of ${target} on ${run.mode.label}${clock}`;
        /* Which mode counts, because that is the whole of what a mixed basket
           needs to say: two stretches both reading "Cleared" can be 1.0 and
           1.4 apart. Saffron is kept for the ones with nothing left. */
        const topped = cleared && run.mode === MODES[MODES.length - 1];
        if (!topped) allTopped = false;
        /* The mode on both readings, not just the cleared one. Only the
           cleared half named it, and the gap was exactly where it was most
           needed: an era reports its highest-CREDIT run, so a 69/77 on Hard
           outranks a 77/77 clear on Medium and the chip goes on saying 69/77
           under a card headed "You cleared it." Naming the mode is what turns
           that from a contradiction into an arithmetic a reader can follow —
           this figure belongs to a different, harder run than the one you have
           just driven. */
        nextCell.textContent = cleared
          ? `Cleared · ${run.mode.label}`
          : `${run.months}/${target} · ${run.mode.label}`;
        nextCell.classList.toggle('has-run', cleared);
        nextCell.classList.toggle('is-clear', topped);
        bestCell.classList.add('has-run');
        contribCell.classList.add('has-run');
        contribCell.classList.toggle('is-clear', cleared);
        cartCell.classList.add('has-run');
        cartCell.classList.toggle('is-clear', cleared);
      }

      /* The figure is the column, added up, and nothing else. Every share was
         already taken against `covered` on the way in and the tenths were
         reconciled before printing, which is why there is no division left
         here and why the figure is literally what a reader gets adding the
         cells by hand. */
      const published = reporting === eras.length;
      const figure = reporting === 0 ? null : sumTenths / 10;
      indexEl.textContent = figure == null ? '' : figure.toFixed(1);
      indexValueEl.hidden = figure == null;
      indexShareBtn.hidden = figure == null;
      /* The same figure in the chart's corner, so the thing a run is being
         spent on is on screen while it is being spent.

         It owns its own visibility now, and the rule is simply whether there
         is an index yet. The corner used to count months, which is a fact
         about one run, so it appeared when a run started and went away when
         the cartridge changed. An index is a fact about the whole basket: it
         survives a cartridge change, it is worth seeing before you press the
         throttle, and there is nothing to show a player who has not driven
         anything at all. A first visit still meets a bare chart. */
      hud.hidden = figure == null;
      hudIndexEl.textContent = figure == null ? '' : figure.toFixed(1);
      // The same number, in the column it totals.
      totalContribEl.textContent = figure == null ? '' : figure.toFixed(1);
      /* Both states are said out loud. The mark used to hide itself once the
         basket was whole, which meant the only score worth quoting was the
         one with nothing next to it saying so.

         Its tooltip is rewritten with it, and carries the count as well as the
         rule: "all six" is the rule, "two to go" is the answer to the question
         a reader actually has while looking at the word Provisional.
         `dataset.info` is read at hover time by the shared tooltip, so
         assigning it here is enough — nothing needs re-wiring.

         Published used to say the score was final, which is the word a
         statistical release uses for a figure that will not be revised again.
         Here it is the opposite: publication is the moment the figure stops
         being reweighted onto a partial basket, and every run after it can
         still raise the number. So the mark says what publication bought and
         what is still on the table.

         Except at the ceiling, where it is not. Six clears on the hardest
         mode is the one basket with no better run left in it, and telling
         that player to go and find one is the only way this sentence could
         be actually false. There the clock is the whole of the game. */
      indexMarkEl.textContent = published ? 'Published' : 'Provisional';
      const missing = eras.length - reporting;
      const hardest = MODES[MODES.length - 1].label;
      indexMarkEl.dataset.info = !published
        ? `Publishes when all six stretches have reported: ${missing} to go.`
        : allTopped
          ? `Every stretch cleared on ${hardest}. The index tops out here; only the clock still moves.`
          : 'All six stretches have reported. A better run still raises it.';
      indexStatusEl.classList.toggle('is-headline', figure == null);
      /* The word "provisional" belongs to the figure, which carries its own
         mark, so the line under it states coverage and nothing else. Before
         the first run there is no figure to mark, this line is the headline,
         and what it says is where to go rather than what is missing: a count
         of nothing reporting is an accurate description of a page you have
         not played yet and a useless one. */
      indexStatusEl.textContent = published
        ? `Published. All ${eras.length} components reporting.`
        : reporting === 0
          ? 'Drive a stretch and it reports here.'
          : `${reporting} of ${eras.length} components reporting.`;

      /* The tiebreaker line. It used to appear only once every stretch was
         cleared, back when that was the only basket with a clock. The board
         now separates equal indexes on this figure whatever they are made of,
         so it appears as soon as the six can be added up — and says which
         kind of six it added, because "all six cleared in" is a claim and the
         partial case must not borrow it. */
      const timed = published && allTimed;
      indexTimeEl.hidden = !timed;
      indexTimeEl.textContent = !timed
        ? ''
        : allClear
          ? `All six cleared in ${fmtTime(totalSecs)}.`
          : `Six runs, ${fmtTime(totalSecs)} in total.`;

      /* A published figure is one that can be quoted, so it is also the one
         that goes up and the one the board can place. Both hang off the same
         rule the mark beside the figure states, so a partial basket is never
         filed and never placed. */
      ownIndex = published ? figure : null;
      if (published) fileIndex();
      paintBoard();
    }

    /** The index line on the run-over card, given what the index was before
     *  this run was recorded.
     *
     *  Two things are worth saying and neither is a request. The card used to
     *  carry a File it button, which was the one moment a score came into
     *  existence and so took the saffron off Retry and off the step up to
     *  Hard. There is nothing to press now — the figure is on the curve by the
     *  time this paints — so the line is a statement and the buttons go back
     *  to meaning what they say. */
    function paintEndIndex(before: number | null) {
      const own = ownIndex;
      const published = before == null && own != null;
      const moved = before != null && own != null && Math.abs(own - before) >= 0.05;
      endIndexEl.hidden = !(own != null && (published || moved));
      if (endIndexEl.hidden || own == null) return;
      const figure = own.toFixed(1);
      /* Where the reader now stands, on the run that changed it. The board may
         not have folded this figure yet and it does not need to have: a rank
         counts everyone strictly above you, and because a basket's figure only
         rises, your own stale entry is never one of them.

         The position and nothing after it. The clock sentence is true and it
         belongs to the drawer, where the curve is on screen and a tie is a
         thing you can see yourself standing in. Stacked on the card it was a
         fourth statistic under a headline that already carried two, and by
         then the card had stopped being read. */
      const place = board ? rankLine(board.hist, boardBin(own), board.plays) : '';
      const head = published
        ? `Your index publishes at ${figure}.`
        : `Your index moves to ${figure}.`;
      endIndexEl.textContent = [head, place].filter(Boolean).join(' ');
    }

    /* ── Filing the index ───────────────────────────────────────────────
       What goes up is the basket the bulletin has just finished printing:
       `counting()` per era, which is the one rule this page has for which run
       an era reports, so nothing here decides anything about the score. It
       packs what that function already returned and adds the browser's id.

       Null unless all six report. A partial basket is not an index — the
       weights it would be summed under are not the weights the board is built
       with — and the server refuses one anyway. */
    type FiledBest = { months: number; mode: string; secs?: number };

    function filedBests(): Record<string, FiledBest> | null {
      const out: Record<string, FiledBest> = {};
      for (const e of eras) {
        const run = counting(e);
        if (!run) return null;
        /* secs is omitted rather than sent as null. Every run driven from
           here carries one, so the only baskets that reach this with a gap
           are ones holding a run recorded back when clears alone were
           clocked. The server takes them and they carry no total until the
           stretch is driven again. */
        out[e.id] =
          run.secs == null
            ? { months: run.months, mode: run.mode.id }
            : { months: run.months, mode: run.mode.id, secs: run.secs };
      }
      return out;
    }

    /** The reader's own total across the six counting runs, or null unless
     *  every one of them carries a time. Same rule the worker totals by, and
     *  all-or-nothing for the same reason: five runs added up is not a smaller
     *  total, it is a different quantity. */
    function ownTotalSecs(): number | null {
      const bests = filedBests();
      if (!bests) return null;
      let sum = 0;
      for (const e of eras) {
        const s = bests[e.id]?.secs;
        if (s == null) return null;
        sum += s;
      }
      return Math.round(sum * 10) / 10;
    }

    /* What was last sent, so a run that improves nothing does not re-send an
       unchanged basket on every crash. Session-scoped rather than stored: a
       reload files once more, which costs one request and covers the case
       where the last send never landed. */
    let sentSignature = '';

    /** Sends the basket, unless that exact basket has already gone up.
     *
     *  There is nothing to ask and nothing to press. An index joins the curve
     *  when it publishes and again whenever it changes, which is the same
     *  event: a per-era best is only ever replaced by a better one, so a
     *  browser's figure can only rise. The run beacon already reports every
     *  run this way; the filing was the odd one out precisely because it used
     *  to carry a name. */
    function fileIndex(): void {
      if (!shouldBeacon()) return;
      const bests = filedBests();
      if (!bests) return;
      const signature = JSON.stringify(bests);
      if (signature === sentSignature) return;
      sentSignature = signature;
      // A refusal is not a record of anything, so it must not stop the next
      // attempt at the same basket.
      void post('/api/peaks-index', { pid: store.pid, bests }).then((ok) => {
        if (!ok) sentSignature = '';
      });
    }

    /* ── The distribution ───────────────────────────────────────────────
       Every filed index on one histogram, with the reader's own on it. It
       renders when there is a board to draw AND the reader has a published
       index to find in it, and is absent otherwise, which is the same
       publication grammar the rest of the bulletin follows.

       Fetched when the drawer first opens rather than on load: this is four
       rules down a shut drawer, and a page view is not a board view. Once per
       session, because the aggregation behind it runs on a cron and a second
       look would read the same numbers. */
    const bulletinEl = document.querySelector('.bulletin') as HTMLDetailsElement;
    const boardEl = document.getElementById('peaks-board') as HTMLElement;
    const boardCountEl = document.getElementById('peaks-board-count')!;
    const boardChartEl = document.getElementById('peaks-board-chart') as HTMLElement;
    const boardRankEl = document.getElementById('peaks-board-rank') as HTMLElement;
    const boardFreshEl = document.getElementById('peaks-board-fresh') as HTMLElement;

    let board: PeaksBoard | null = null;
    /* When the board was last asked for, rather than whether it has been.
       The aggregation behind it runs on a cron, so a filing does not appear on
       it the moment it is taken — and a reader who files, waits, and opens the
       drawer again to look for themselves was being handed the same copy they
       were handed before they filed, for the life of the tab. Re-asking on a
       reopen more than a minute later costs one request and is the only thing
       between that reader and a page reload. */
    let boardAskedAt = 0;
    const BOARD_STALE_MS = 60 * 1000;
    /** The reader's own figure, or null while the basket is short. Set by
     *  paintIndex, which is the only thing that knows when it publishes. */
    let ownIndex: number | null = null;

    function loadBoard() {
      if (!shouldBeacon() || Date.now() - boardAskedAt < BOARD_STALE_MS) return;
      boardAskedAt = Date.now();
      getJson<PeaksBoard>('/api/peaks-board.json').then((b) => {
        // A board nobody has filed to is not a distribution. A fetch that
        // fails leaves the copy already on screen rather than blanking it:
        // a stale board beats no board.
        const next = b && Array.isArray(b.hist) && b.plays >= 1 ? b : null;
        if (next) board = next;
        else if (!board) board = null;
        paintBoard();
      });
    }

    bulletinEl?.addEventListener('toggle', () => {
      if (bulletinEl.open) loadBoard();
    });

    /* One gate, and it is the board's own existence. The panel needs nothing
       from the reader: with the saffron mark alone it still says here is the
       shape of what people reach and here is the top of it, which is a whole
       answer and the reason a new player has any idea the score is for
       something. Your own mark then arrives when you publish, so publishing
       feels like landing on a chart you have already been looking at rather
       than one conjured to receive you.

       The one line that does need an index of your own is the position under
       the curve, because "you are 4th of 5,210" with no figure to be 4th with
       is not a sentence. That line alone stays shut, and the clock sentence
       that can follow it needs a whole basket's worth of times as well. */
    function paintBoard() {
      const b = board;
      const own = ownIndex;
      boardEl.hidden = !b;
      if (!b) return;
      boardCountEl.textContent = `${grp(b.plays)} ${b.plays === 1 ? 'index' : 'indexes'} filed.`;
      const fresh = agoText(b.updated_at);
      boardFreshEl.textContent = fresh;
      boardFreshEl.hidden = !fresh;

      const place = own == null ? '' : rankLine(b.hist, boardBin(own), b.plays);
      const secs = ownTotalSecs();
      const clock = own == null || secs == null
        ? ''
        : clockLine(b.times?.[String(boardBin(own))], timeBucket(secs));
      boardRankEl.textContent = [place, clock].filter(Boolean).join(' ');
      boardRankEl.hidden = !boardRankEl.textContent;

      drawBoard(b, own, topIndexOf(b.hist));
    }

    /* The bulletin's share text, built to the same four lines as the run's so
       the two read as one voice.

       Its sparkline is the WHOLE spine, 1969 to now, where the run's is only
       the stretch that was driven. That is the right difference: an index is a
       claim about all of it, and the glyphs say what all of it looks like. It
       is the same picture every time, which is the point — it is the course,
       not the run.

       Provisional says so on the first line rather than in a parenthesis after
       the figure, and then there is no third line at all, because an
       unpublished index is never placed on the board (see ownIndex) and there
       is genuinely nothing to report. */
    function bulletinShareText(): string {
      const figure = indexEl.textContent;
      if (!figure) return '';
      const published = indexMarkEl.textContent === 'Published';
      const ys = terrain.points.map((p) => p.yoy);
      const course = blockSpark(ys, Math.min(...ys), Math.max(...ys));
      const place = published && board && ownIndex != null
        ? rankLine(board.hist, boardBin(ownIndex), board.plays, 'share')
        : '';
      return [
        `🛺 Inflation Peaks · index ${figure} · ${published ? 'Published' : 'Provisional'}`,
        course,
        place,
        location.href,
      ].filter(Boolean).join('\n');
    }
    wireShare(indexShareBtn, bulletinShareText);
    /* The button lives inside the bulletin's <summary>, so a click on it
       reaches the summary on the way up and folds the drawer under the reader.
       Stopped here rather than in wireShare, because this is a fact about
       where this one button sits and not about sharing. stopPropagation does
       not touch the other listener on this same element, so wireShare's still
       runs; preventDefault is the belt to that brace, since a summary's toggle
       is a default action and either one alone cancels it. */
    indexShareBtn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
    });

    /** How old the board file is, in the coarsest unit that still says
     *  something. Rounded to the minute above ninety seconds, because a board
     *  rebuilt on a five-minute cron has no use for a figure in seconds and a
     *  ticking one would ask to be watched. Clamped at zero: the timestamp is
     *  the worker's clock and the comparison is the reader's, and two clocks
     *  disagreeing must not produce a board updated in the future. */
    function agoText(iso: string | undefined): string {
      if (!iso) return '';
      const then = Date.parse(iso);
      if (!Number.isFinite(then)) return '';
      const secs = Math.max(0, Math.round((Date.now() - then) / 1000));
      if (secs < 90) return 'Updated just now';
      const mins = Math.round(secs / 60);
      if (mins < 60) return `Updated ${mins} min ago`;
      const hours = Math.round(mins / 60);
      if (hours < 24) return `Updated ${hours} ${hours === 1 ? 'hour' : 'hours'} ago`;
      const days = Math.round(hours / 24);
      return `Updated ${days} ${days === 1 ? 'day' : 'days'} ago`;
    }

    /* The scale the board is drawn on: 0 to 140, which is every stretch
       cleared on Hard, and the grammar points of it are 0, the Medium sweep at
       100, and the two ends. No y-axis figures — the shape is the statement,
       the same argument the resting chart makes. */
    const BOARD_MAX = 140;
    const BOARD_TICKS = [0, 60, 100, BOARD_MAX];
    const BOARD_BARS_H = 72;
    const BOARD_ROW_H = 13;
    const BOARD_AXIS_H = 15;

    /** Laid out in the browser's own pixels rather than a scaled viewBox: the
     *  labels are type, and type that scales with its box is 6px on a phone
     *  and 22px on a desktop. Redrawn when the width changes, which is also
     *  what draws it the first time the drawer is opened. */
    let boardWidth = 0;

    function drawBoard(b: PeaksBoard, own: number | null, topIndex: number | null) {
      const w = Math.round(boardChartEl.clientWidth);
      // Shut drawer, or a layout that has not happened yet: the resize
      // observer below will call back with a real width.
      if (w < 40) return;
      boardWidth = w;

      const bw = w / (BOARD_MAX + 1);
      const xOf = (i: number) => (i / BOARD_MAX) * (w - bw) + bw / 2;

      /* The file bins at a tenth, because that is what a rank has to be read
         off; the drawing bins at a point, because 1,401 columns across 800
         pixels is a smear and the shape is the whole statement. Ten fine bins
         to a column, summed. */
      const bars: number[] = Array(BOARD_MAX + 1).fill(0);
      for (let i = 0; i < b.hist.length; i++) {
        bars[Math.min(BOARD_MAX, Math.round(i / 10))] += Number(b.hist[i]) || 0;
      }

      /* Two marks, and only two: the reader's own figure and the best anyone
         has filed. Yours is placed first, so on the rare occasion the two sit
         close enough to collide it is the leader's that gets bumped up a row.
         Yours is ink and the leader's is saffron, which is the whole colour
         vocabulary these panels have. */
      type Mark = { text: string; x: number; half: number; row: number; at: number; cls: string };
      const marks: Mark[] = [];
      const place = (text: string, at: number, cls: string) => {
        const half = (text.length * 6.6) / 2 + 3;
        const x = Math.max(half, Math.min(w - half, xOf(at)));
        let row = 0;
        while (marks.some((m) => m.row === row && Math.abs(m.x - x) < m.half + half)) row++;
        marks.push({ text, x, half, row, at, cls });
      };
      /* Placed on the true index rather than on its column, so two figures a
         tenth apart do not stack on the same rule. The leader is dropped when
         the two would land on the same pixel: a saffron rule through your own
         would take away the single mark this panel exists to show you, and at
         that distance the two figures are the same figure. */
      if (own != null) place(own.toFixed(1), own, 'you');
      if (topIndex != null && (own == null || Math.abs(topIndex - own) >= 0.05)) {
        place(topIndex.toFixed(1), topIndex, 'top');
      }
      const rows = marks.reduce((a, m) => Math.max(a, m.row + 1), 1);

      const top = rows * BOARD_ROW_H;
      const base = top + BOARD_BARS_H;
      const h = base + BOARD_AXIS_H;
      // Row 0 sits against the curve and the stack builds upward from it.
      const yOf = (row: number) => top - row * BOARD_ROW_H - 3;

      const parts: string[] = [];
      const peak = bars.reduce((a, n) => Math.max(a, n), 0);
      if (peak > 0) {
        /* One filled step across all 141 columns rather than 141 rects. A
           column holding anything at all is floored to a mark that can be
           seen, which at five filings is three spikes and at five thousand is
           a hairline ribbon along the tails showing the full range anyone
           reached — both of which are the truth about the board at that size. */
        const yAt = (i: number) => (bars[i] <= 0
          ? base
          : base - Math.max(1.5, (bars[i] / peak) * BOARD_BARS_H));
        const steps: string[] = [];
        for (let i = 0; i <= BOARD_MAX; i++) {
          const y = yAt(i).toFixed(2);
          steps.push(`${(xOf(i) - bw / 2).toFixed(2)},${y}`, `${(xOf(i) + bw / 2).toFixed(2)},${y}`);
        }
        const left = (xOf(0) - bw / 2).toFixed(2);
        const right = (xOf(BOARD_MAX) + bw / 2).toFixed(2);
        parts.push(`<path class="board-area" d="M ${left},${base.toFixed(2)} L ${steps.join(' L ')} L ${right},${base.toFixed(2)} Z" />`);
        // The outline is drawn open, so it does not trace the baseline the
        // axis rule is already drawing a pixel below it.
        parts.push(`<path class="board-edge" d="M ${steps.join(' L ')}" />`);
      }
      parts.push(`<line class="board-axis" x1="0" y1="${base + 0.5}" x2="${w}" y2="${base + 0.5}" />`);
      for (const t of BOARD_TICKS) {
        // The end labels are pulled inside the box rather than centred on
        // their tick, which would clip half of each one.
        const anchor = t === 0 ? 'start' : t === BOARD_MAX ? 'end' : 'middle';
        parts.push(
          `<text class="board-tick" x="${xOf(t).toFixed(2)}" y="${base + BOARD_AXIS_H - 3}" text-anchor="${anchor}">${t}</text>`,
        );
      }
      /* Each mark is a rule from the curve up to the line its own figure sits
         on, so a bumped label keeps its rule and stays readable as one object.
         Drawn before the figures, so a numeral always paints over a rule.

         A bumped rule then has to pass the row below it, and being one or two
         points behind the leader is the single most interesting place a reader
         can be — so that is exactly when the leader's rule runs down through
         the reader's own figure. The rule is cut around any label it would
         cross rather than drawn through it: two segments, and the gap reads as
         the label sitting in front. */
      const LABEL_BAND = 11;
      for (const m of marks) {
        const x = xOf(m.at);
        const cuts = marks
          .filter((o) => o !== m && o.row < m.row && Math.abs(o.x - x) < o.half + 2)
          .map((o) => [yOf(o.row) - LABEL_BAND + 3, yOf(o.row) + 4])
          .sort((a, c) => a[0] - c[0]);
        let from = yOf(m.row) + 3;
        const segs: string[] = [];
        for (const [a, c] of cuts) {
          if (a > from) segs.push(`M ${x.toFixed(2)},${from.toFixed(2)} V ${a.toFixed(2)}`);
          from = Math.max(from, c);
        }
        if (from < base) segs.push(`M ${x.toFixed(2)},${from.toFixed(2)} V ${base.toFixed(2)}`);
        parts.push(`<path class="board-${m.cls}" d="${segs.join(' ')}" />`);
      }
      for (const m of marks) {
        parts.push(
          `<text class="board-${m.cls}-fig" x="${m.x.toFixed(2)}" y="${yOf(m.row)}" text-anchor="middle">${m.text}</text>`,
        );
      }

      /* aria-hidden, like every other drawing on this page: the two lines
         printed around it carry every figure a reader would otherwise be asked
         to hear read out one bin at a time. */
      boardChartEl.innerHTML =
        `<svg viewBox="0 0 ${w} ${h}" width="${w}" height="${h}" aria-hidden="true">${parts.join('')}</svg>`;
    }

    new ResizeObserver(() => {
      if (!board || boardEl.hidden) return;
      if (Math.round(boardChartEl.clientWidth) === boardWidth) return;
      paintBoard();
    }).observe(boardChartEl);

    function build() {
      game?.destroy();
      slice = sliceFor(era);
      game = createGame({
        canvas: cv,
        terrain: slice,
        mode,
        onMonths: (m) => {
          markProgress(m);
        },
        onEnd: (end) => {
          live = false;
          const copy = COPY[end.outcome];
          const at = slice.points[Math.min(end.months, slice.points.length - 1)];
          const context = contextFor(at.ym);
          const cleared = end.outcome === 'cleared';
          const improved = recordRun(end.months, end.secs);
          // What the run opened with, read back: the beacon goes up and the
          // percentile line is written from the answer that is already here.
          closeFiling(end.months);
          endKicker.textContent = improved ? 'Personal best' : copy.kicker;
          endTitle.textContent = copy.title;
          endMonths.textContent = String(end.months);
          // Every run gets the share button, crash or clear — reset in case a
          // previous run left it mid "Copied to clipboard" confirmation.
          lastEnd = end;
          endShareBtn.hidden = false;
          endShareBtn.textContent = 'Share';
          // The run just driven rather than the best on record: this line is
          // about what just happened. It reads on from the unit beside it —
          // "74 months survived in 0:47" — so one phrasing serves a crash and
          // a clear, and the heading above has already said which it was.
          endTime.textContent = `in ${fmtTime(end.secs)}`;
          endTime.hidden = false;
          endNote.textContent = whereItEnded(end.months, end.outcome);
          /* The event note is a crash note. On a clear the nearest annotation
             is often the month AFTER the stretch ended — clearing the 2000s
             quoted January 2010, which belongs to the 2010s — and it was the
             one paragraph standing between the basket and the fold. Both
             reasons point the same way. */
          endContext.textContent = cleared ? '' : context;
          endContext.hidden = cleared || !context;
          /* The basket, and what the card is asking with it. One
             recommendation drives all three of the marked chip, the button
             and Retry's weight, so they cannot disagree. */
          nextEl.hidden = !cleared;
          const left = cleared ? notCleared() : 0;
          pendingStep = cleared ? recommend() : null;
          if (cleared) {
            nextHeadEl.textContent = left > 0
              ? 'Drive another stretch'
              : pendingStep
                ? 'Every stretch cleared'
                : `Every stretch cleared on ${MODES[MODES.length - 1].label}`;
          }
          /* The chip the button is about, marked. Not `aria-current`, which it
             used to be and which means the item you are on: this is the item
             being suggested, the loaded one is the stretch just cleared, and a
             screen reader told the wrong one is worse served than one told
             nothing. The button beside it says the recommendation in words, so
             the mark is reinforcement rather than the only carrier. */
          for (const b of nextButtons) {
            b.toggleAttribute('data-suggested', b.dataset.next === pendingStep?.era.id);
          }
          stepBtn.hidden = !pendingStep;
          if (pendingStep) {
            // "Drive The seventies on Medium" is a headline dropped into a
            // sentence. The labels are titles of cartridges, and a title takes
            // its capital back when it is quoted mid-line.
            const name = pendingStep.era.label.replace(/^The /, 'the ');
            /* The mode is named only when it is changing. On the step up it is
               the whole of the offer and has to be said; on a stretch you have
               simply not driven yet it is the switch you already have set, and
               printing it invites the reading that the stretch must be driven
               on that mode to count. Nothing has to be driven on anything. */
            stepBtn.textContent = pendingStep.mode === mode
              ? `Drive ${name}`
              : `Drive ${name} on ${pendingStep.mode.label}`;
          }
          // Quiet whenever the card has something better to offer, which is
          // now every clear with anything left in it; loud again once there is
          // nothing to raise and the clock is the whole of the remaining game.
          retryBtn.classList.toggle('is-quiet', cleared && pendingStep != null);
          veil.hidden = false;
          // Held from before the run was recorded, so the card can tell an
          // index that just came into existence from one that merely moved.
          const before = ownIndex;
          paintIndex();
          paintEndIndex(before);
          /* The card is capped at the chart's height and its body scrolls, so
             it opens at the top of a fresh card rather than wherever the last
             one was left. That much is unconditional.

             The rest is about the marked chip, which can sit in the basket's
             second row and so below the fold. Scrolling to it is not free: it
             pushes the kicker off the top, and "Personal best" is the one line
             on this card that is a reward rather than a reading. So it only
             happens when the chip is more hidden than shown. A chip with its
             name and its saffron edge visible and its bottom clipped has
             already done its job, and the clipping is the page's own way of
             saying there is more below.

             Last in the sequence, because it measures: the index line is
             written above the basket and pushes it down, so measuring before
             that put the chip seventeen pixels short and then moved it further
             out. Measured against the scroll box rather than handed to
             scrollIntoView, which would also move the page. */
          cardScrollEl.scrollTop = 0;
          const marked = nextButtons.find((b) => b.hasAttribute('data-suggested'));
          if (marked && !nextEl.hidden) {
            const chip = marked.getBoundingClientRect();
            const view = cardScrollEl.getBoundingClientRect();
            const shown = Math.min(chip.bottom, view.bottom) - Math.max(chip.top, view.top);
            if (shown < chip.height / 2) cardScrollEl.scrollTop += chip.bottom - view.bottom;
          }
        },
      });
      /* Back to the start line. The denominator in that readout is one less
         than the era's month count, and deliberately so: 114 monthly readings
         bound 113 months of driving, the way 114 fence posts bound 113 panels.
         The table states the era's calendar length because that is what the
         era is; this states what a run can score. The card says neither
         number, so the two never sit next to each other looking like a
         contradiction. */
      markProgress(null);
    }

    /* Choosing an era or a mode ends whatever is running and re-arms on the
       new one. Silently keeping a run alive under a changed setting would
       score it against terrain the player is no longer looking at. It leaves
       you looking at the new terrain rather than at a card about it, which is
       the whole reason the card went. */
    function choose(next: { era?: TerrainEra; mode?: GameMode }) {
      if (next.era) era = next.era;
      if (next.mode) mode = next.mode;
      live = false;
      veil.hidden = true;
      build();
      paintChoices();
      /* The index is deliberately NOT repainted here. It no longer depends on
         which mode is selected — only on which runs are on record — so a mode
         change leaves every figure in the bulletin exactly where it was. That
         is the point of the change: the scorecard stops emptying itself
         because you reached for a different switch. */
    }

    const cartButtons = [...document.querySelectorAll<HTMLButtonElement>('.cart')];
    const modeButtons = [...document.querySelectorAll<HTMLButtonElement>('.mode')];
    const nextButtons = [...document.querySelectorAll<HTMLButtonElement>('.next-item')];
    const loadButtons = [...document.querySelectorAll<HTMLButtonElement>('.era-load')];
    const noteEls = [...document.querySelectorAll<HTMLElement>('[data-notes]')];

    /* Four ways to load a cartridge — the select in the slot, the rack, the
       bulletin's component column, and the basket on the run-over card — so
       all four are repainted from the one `era`, and none of them is the
       source of truth for it. */
    function paintChoices() {
      for (const b of cartButtons) b.setAttribute('aria-pressed', String(b.dataset.era === era.id));
      for (const b of modeButtons) b.setAttribute('aria-pressed', String(b.dataset.mode === mode.id));
      for (const b of loadButtons) b.setAttribute('aria-current', String(b.dataset.load === era.id));
      /* The basket's mark is NOT repainted from `era`. It belongs to the
         run-over card's recommendation, which is set when that card is
         written and must survive the era change the recommendation's own
         button then causes. */
      for (const n of noteEls) n.hidden = n.dataset.notes !== era.id;
      for (const s of slotSparks) s.hidden = s.dataset.slotSpark !== era.id;
      /* A new stretch is a new map, and nothing has been driven on it yet.
         This also rewrites the readout beside the map, which is why nothing
         else here touches it. */
      markProgress(null);
      if (eraSelect.value !== era.id) eraSelect.value = era.id;
    }

    const loadEra = (id: string | undefined) => {
      const next = eras.find((e) => e.id === id);
      if (next) choose({ era: next });
    };

    for (const b of cartButtons) b.addEventListener('click', () => loadEra(b.dataset.era));

    /* From the bulletin, loading also scrolls the machine into view. The
       drawer sits below the game, so without it the thing that changed is off
       screen above you and the click reads as having done nothing. Same call
       the card's basket makes, for the same reason. The rack is a separate
       drawer and is not opened: a click here is about the machine, and a
       drawer unfolding somewhere else is not what was asked for. */
    for (const b of loadButtons) {
      b.addEventListener('click', () => {
        loadEra(b.dataset.load);
        bringIntoView();
      });
    }

    /* The select keeps focus after a change, which is correct for a select and
       wrong for this page: a select owns the space bar, so picking a cartridge
       with the mouse and then pressing Space reopened the dropdown instead of
       starting the run — in Chrome and in Safari both. The bar under the chart
       says "Hold Space to drive" and it has to be true wherever the last click
       landed.
       Two fixes, because there are two ways to change a cartridge. A pointer
       change hands focus back: the mouse is already where the player is
       looking, nothing is lost, and the arrow keys stop belonging to the
       select as well. A keyboard change keeps focus, because taking it away
       mid-selection would make the control unusable from the keyboard; there
       Space alone is reclaimed, and the select keeps its arrows, Enter,
       Alt+Down and typeahead. */
    let pickedByPointer = false;
    eraSelect.addEventListener('pointerdown', () => { pickedByPointer = true; });
    eraSelect.addEventListener('keydown', () => { pickedByPointer = false; });
    eraSelect.addEventListener('change', () => {
      loadEra(eraSelect.value);
      if (pickedByPointer) eraSelect.blur();
    });
    /* From the basket, loading a stretch also clears the card: you asked for
       that stretch, so you should be looking at it and not at the result of
       the last one. */
    for (const b of nextButtons) {
      b.addEventListener('click', () => {
        loadEra(b.dataset.next);
        bringIntoView();
      });
    }
    for (const b of modeButtons) {
      b.addEventListener('click', () => {
        const next = MODES.find((m) => m.id === b.dataset.mode);
        if (next) choose({ mode: next });
      });
    }

    build();
    paintChoices();
    paintIndex();

    /* A 13-inch laptop has room for the chart and the pedal but not for them
       plus the masthead above, so a run started from a page scrolled to the
       top leaves the bottom of the game off screen. Pull the pair into view,
       but only when they do not already fit. */
    function bringIntoView() {
      const top = stageEl.getBoundingClientRect().top;
      const bottom = document.querySelector('.pedal-wrap')!.getBoundingClientRect().bottom;
      if (top >= 0 && bottom <= window.innerHeight) return;
      const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollBy({
        top: top - Math.max(8, (window.innerHeight - (bottom - top)) / 2),
        behavior: smooth ? 'smooth' : 'auto',
      });
    }

    function run() {
      bringIntoView();
      // The token this run will be filed with, and the stretch's runs the
      // card will be measured against. Both are asked for here because a run
      // is what they are about; neither is waited on.
      openFiling();
      veil.hidden = true;
      live = true;
      /* Back to the start line. The dot is the one piece of run state that
         outlives its run: it stays parked where the last one ended, the same
         way the peak labels stay open, so the card and the map agree while you
         read them. Retry is where both are cleared. */
      markProgress(0);
      game!.start();
      // Deliberately no canvas.focus() here: Space is bound on the window for
      // the duration of a run, so focus buys nothing, and focusing the canvas
      // paints a saffron focus ring around the whole chart, and saffron on
      // this page is the series.
    }

    retryBtn.addEventListener('click', run);

    /* Loads the offered stretch and mode and leaves you at its start line,
       exactly as a basket chip does. The pedal is the ignition on this page
       and stays the ignition; a button that started a run behind the card
       would be the only one that did. */
    stepBtn.addEventListener('click', () => {
      if (!pendingStep) return;
      choose({ era: pendingStep.era, mode: pendingStep.mode });
      bringIntoView();
    });

    /* Starting a run from a run-over card, which is not always the same run.
       A crash card asks one thing and says Retry, and there the pedal repeats
       the stretch. A clear card asks a different thing: the stretch is
       finished, there is nothing left to try again, and the card puts its
       recommendation in saffron and steps Retry down to an outline to say so.
       The pedal was answering the quiet button — press it and you were handed
       the stretch you had just cleared, which is the one thing the card was
       not offering. It now takes the loud one.

       Guarded on the card actually being up, because `pendingStep` outlives
       the card that set it: load a stretch from the basket and the veil goes
       but the recommendation does not, and without this the next press would
       ignore the cartridge you had just chosen in favour of a suggestion made
       about a run two stretches ago. */
    const ignite = () => {
      if (pendingStep && !veil.hidden) choose({ era: pendingStep.era, mode: pendingStep.mode });
      run();
    };

    // One input, several ways in. Pointer events cover mouse and touch; the
    // release has to be caught on the window because a finger that leaves
    // the control mid-run still means "released".
    const pedalEl = document.getElementById('peaks-pedal')!;
    const press = (on: boolean) => {
      if (live) game!.setThrottle(on);
      pedalEl.classList.toggle('is-down', on && live);
    };
    const release = () => press(false);
    window.addEventListener('pointerup', release);
    window.addEventListener('pointercancel', release);

    pedalEl.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      // The bar is the throttle and the ignition both. Between runs it starts
      // one; during a run it drives. Either way the press means the same
      // thing, which is why the start card no longer needs a button of its
      // own — that button was a second saffron control that looked identical
      // to this one and, before a run, this one did nothing at all.
      if (!live) ignite();
      press(true);
      // Real tactility where the platform has it, a silent no-op elsewhere.
      navigator.vibrate?.(8);
    });

    /* The brace to the stylesheet's belt (see the .peaks selection rules).
       preventDefault on `pointerdown` is not the same thing on iOS: WebKit
       decides about the long press from the touch stream, and cancelling the
       pointer event leaves that decision untouched. Cancelling the touch is
       what actually calls it off. Nothing is lost by doing it — the bar is
       driven from pointer events, it has no click handler, and it already
       declares `touch-action: none` — and holding the throttle is precisely
       the gesture the platform is built to mistake for a long press. */
    pedalEl.addEventListener('touchstart', (e) => e.preventDefault(), { passive: false });

    /* A key pressed inside a text field belongs to the field. The footer's
       newsletter signup is on this page like every other, and without this
       the preventDefault below swallowed the space you were typing into it
       and started a run behind you, halfway up the page. */
    const TYPING = /^(INPUT|TEXTAREA|SELECT)$/;
    const isTyping = (t: EventTarget | null) => {
      const el = t as HTMLElement | null;
      return !!el && (el.isContentEditable || TYPING.test(el.tagName));
    };

    /** Whether the field a key was pressed in should keep it. One exception,
     *  and only one key: the cartridge select gives up the space bar, because
     *  a select that has just been used is the likeliest place on this page
     *  for a player to press the throttle. Everything else the select does
     *  with a keyboard is untouched. */
    const swallows = (e: KeyboardEvent) =>
      isTyping(e.target) && !(e.target === eraSelect && e.code === 'Space');

    window.addEventListener('keydown', (e) => {
      if (swallows(e)) return;
      const isThrottle = e.code === 'Space' || e.code === 'ArrowUp';
      /* This has to come before the repeat guard. Space scrolls the page by
         default, and the browser repeats keydown for as long as the key is
         held — so bailing out on `repeat` first meant the first press was
         swallowed and every one after it scrolled, which walked the game off
         a short screen while you were driving. */
      if (isThrottle) e.preventDefault();
      if (e.repeat) return;
      /* The throttle takes the focus with it. preventDefault already stops
         Space from toggling a focused <summary>, but it cannot stop the ring
         appearing on one: the first key press flips the browser into keyboard
         modality, so :focus-visible starts matching whatever was last clicked
         — and after opening a drawer, that is the drawer. A saffron box drawn
         around "Inflation Peaks index score" while you are driving reads as a
         fault. Driving is what the player is doing, so the ring belongs on
         the control that does it. preventScroll because moving the ring must
         never move the terrain. */
      if (isThrottle && document.activeElement !== pedal) pedal.focus({ preventScroll: true });
      if (!live) {
        /* Enter belongs to whatever already does something with it. A focused
           button turns it into a click, so letting it through is what stops
           the run being started twice; a summary opens its drawer and a link
           follows itself, and there the preventDefault below did not
           double-fire the run, it ATE the control — Enter on "The rack"
           started a run instead of opening it, and Enter on the folio started
           one instead of going to Play. Space is deliberately not on this
           list: it is the throttle everywhere, on the same rule that takes it
           off the cartridge select. */
        if (e.code === 'Enter' && (e.target as HTMLElement)?.closest('button, summary, a[href]')) return;
        // On the start and run-over cards the keyboard starts the run, so a
        // player who just finished one on the keyboard can begin the next
        // without reaching for the mouse. Space starts it AND holds, which
        // is what the finger version of the same press does.
        if (e.code === 'Enter' || isThrottle) {
          e.preventDefault();
          ignite();
          if (isThrottle) press(true);
        }
        return;
      }
      if (isThrottle) {
        e.preventDefault();
        press(true);
      }
    });
    window.addEventListener('keyup', (e) => {
      if (swallows(e)) return;
      if (e.code === 'Space' || e.code === 'ArrowUp') press(false);
    });
    // Theme flips rewrite every colour the engine holds; nothing else changes.
    new MutationObserver(() => game?.refreshTheme()).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });

    new ResizeObserver(() => game?.resize()).observe(stageEl);

    if (new URLSearchParams(location.search).has('fps')) {
      fpsEl.hidden = false;
      setInterval(() => {
        fpsEl.textContent = `${game?.fps().toFixed(1)} fps`;
      }, 500);
    }
  }
  }
</script>
